---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { Button } from '../components/ui/button';
import { ArrowRight, Clock, Check } from 'lucide-react';
import { WaveBackground, FlowingLines, CornerWaves } from '../components/WaveArt';
import { GeometricArt, FloatingShapes } from '../components/GeometricArt';

const services = [
  {
    id: "websites",
    title: "Static Websites",
    description: "Fast, secure websites perfect for small businesses that don't need frequent updates.",
    illustration: "/illustrations/service-website.svg",
    priceGbp: 149,
    features: [
      "Up to 5 pages included",
      "Custom design for your brand",
      "Mobile-first responsive design",
      "Contact form integration",
      "Basic SEO optimization",
      "Optimised for fast loading"
    ],
    timeline: "1-2 weeks"
  },
  {
    id: "cms",
    title: "CMS Websites",
    description: "Easy-to-update websites for businesses that need to manage their own content.",
    illustration: "/illustrations/service-cms.svg",
    priceGbp: 249,
    features: [
      "No page limits",
      "Simple content editor",
      "Blog functionality",
      "2 admin users included",
      "Content scheduling",
      "Hosting & support included"
    ],
    timeline: "2-3 weeks",
    featured: true
  },
  {
    id: "ecommerce",
    title: "E-Commerce Sites",
    description: "Sell products online with a fast, secure storefront that converts visitors into customers.",
    illustration: "/illustrations/service-ecommerce.svg",
    priceGbp: 399,
    features: [
      "Everything in CMS sites",
      "PayPal & Stripe integration",
      "Unlimited products",
      "Order management dashboard",
      "Multicurrency support",
      "Abandoned cart recovery"
    ],
    timeline: "3-4 weeks"
  },
  {
    id: "custom",
    title: "Custom Development",
    description: "Browser extensions, automation tools, or complex web applications. Let's discuss your needs.",
    illustration: "/illustrations/service-custom.svg",
    priceGbp: null,
    features: [
      "Browser extensions",
      "Internal tools & dashboards",
      "API integrations",
      "Automation scripts",
      "AI-powered features",
      "Technical consultation"
    ],
    timeline: "Varies by project"
  }
];

const processSteps = [
  {
    step: "01",
    title: "Discovery",
    description: "We discuss your business, goals, and requirements. I'll ask questions to understand exactly what you need.",
    duration: "30-60 min call"
  },
  {
    step: "02",
    title: "Proposal",
    description: "I send you a detailed proposal with scope, timeline, and fixed price. No hidden fees.",
    duration: "1-2 days"
  },
  {
    step: "03",
    title: "Design",
    description: "I create design mockups for your approval. We iterate until you're happy with the look.",
    duration: "3-5 days"
  },
  {
    step: "04",
    title: "Build",
    description: "I build your website with clean, modern code. You'll get progress updates throughout.",
    duration: "1-3 weeks"
  },
  {
    step: "05",
    title: "Launch",
    description: "Final testing, domain setup, and launch. I train you on how to update content (if applicable).",
    duration: "1-2 days"
  }
];
---

<Layout title="Services | Staticfish" description="Web development services for small businesses. Static sites, CMS websites, e-commerce, and custom development.">
  <div class="min-h-screen flex flex-col bg-background">
    <Header />
    <main class="flex-1">
      
      <!-- Hero with flowing lines -->
      <section class="pt-32 pb-20 lg:pb-32 relative overflow-hidden">
        <FlowingLines count={8} />
        <CornerWaves position="bottom-right" />
        
        <div class="container mx-auto max-w-7xl px-6 relative z-10">
          <div class="max-w-3xl">
            <p class="text-sm font-medium text-muted-foreground uppercase tracking-widest mb-6">
              Services
            </p>
            <h1 class="text-5xl sm:text-6xl lg:text-7xl font-bold text-foreground font-display tracking-tighter mb-8">
              What We
              <span class="text-accent">Build.</span>
            </h1>
            <p class="text-lg sm:text-xl text-muted-foreground leading-relaxed max-w-2xl">
              Four ways we can help your business succeed online. Each includes hosting, security, and personal support.
            </p>
          </div>
        </div>
      </section>

      <!-- Services Grid with Illustrations -->
      <section class="py-20 border-t border-border relative overflow-hidden">
        <GeometricArt variant="mixed" />
        <div class="container mx-auto max-w-7xl px-6 relative z-10">
          
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-px bg-border">
            {services.map((service) => (
              <div id={service.id} class={`group relative bg-background p-8 lg:p-12 hover:bg-secondary/20 transition-colors ${service.featured ? 'bg-secondary/10' : ''}`}>
                
                {service.featured && (
                  <div class="absolute top-0 right-0 bg-accent text-white text-xs font-bold uppercase tracking-widest px-4 py-2">
                    Popular
                  </div>
                )}
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-start">
                  <div class="relative">
                    <img 
                      src={service.illustration} 
                      alt={`${service.title} illustration`}
                      class="w-full h-auto mb-6 opacity-90"
                    />
                  </div>
                  
                  <div>
                    <div class="flex items-center gap-2 text-sm text-muted-foreground mb-4">
                      <Clock className="h-4 w-4" />
                      {service.timeline}
                    </div>

                    <h3 class="text-2xl font-bold text-foreground font-display mb-2">{service.title}</h3>
                    
                    <div class="mb-4">
                      {service.priceGbp ? (
                        <div class="flex items-baseline gap-1">
                          <span class="text-4xl font-bold text-foreground font-display tracking-tighter" data-price-gbp={service.priceGbp}>£{service.priceGbp}</span>
                          <span class="text-sm text-muted-foreground ml-1" data-hosting-gbp>+ £50/mo hosting</span>
                        </div>
                      ) : (
                        <span class="text-2xl font-bold text-foreground font-display">Custom Quote</span>
                      )}
                    </div>

                    <p class="text-muted-foreground mb-6 leading-relaxed">{service.description}</p>
                    
                    <ul class="space-y-2 mb-8">
                      {service.features.map(feature => (
                        <li class="flex items-start gap-3">
                          <Check className="h-4 w-4 text-accent mt-0.5 shrink-0" strokeWidth={3} />
                          <span class="text-foreground text-sm">{feature}</span>
                        </li>
                      ))}
                    </ul>

                    <Button className="rounded-none px-6 h-11 font-semibold">
                      <a href="/contact" class="flex items-center gap-2">
                        Get Started <ArrowRight className="h-4 w-4" />
                      </a>
                    </Button>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- Process Section with Waves -->
      <section class="py-20 border-t border-border bg-secondary/20 relative overflow-hidden">
        <WaveBackground variant="coral" opacity={0.1} />
        <FloatingShapes />
        
        <div class="container mx-auto max-w-7xl px-6 relative z-10">
          
          <p class="text-sm font-medium text-muted-foreground uppercase tracking-widest mb-6">
            How It Works
          </p>
          <h2 class="text-4xl sm:text-5xl font-bold text-foreground font-display tracking-tighter mb-16">Our Process.</h2>

          <div class="border-t border-border">
            {processSteps.map((step, index) => (
              <div class="border-b border-border py-10">
                <div class="grid grid-cols-12 gap-6 items-start">
                  <div class="col-span-12 sm:col-span-1">
                    <span class="text-sm font-medium text-muted-foreground">{step.step}</span>
                  </div>
                  <div class="col-span-12 sm:col-span-3">
                    <h3 class="text-xl font-bold text-foreground font-display">{step.title}</h3>
                  </div>
                  <div class="col-span-12 sm:col-span-5">
                    <p class="text-muted-foreground text-sm leading-relaxed">{step.description}</p>
                  </div>
                  <div class="col-span-12 sm:col-span-3">
                    <span class="text-xs font-bold uppercase tracking-wider text-accent">{step.duration}</span>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- Why Static Sites -->
      <section class="py-20 border-t border-border relative overflow-hidden">
        <GeometricArt variant="lines" />
        <CornerWaves position="top-left" />
        
        <div class="container mx-auto max-w-7xl px-6 relative z-10">
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
            <div>
              <p class="text-sm font-medium text-muted-foreground uppercase tracking-widest mb-6">
                Why This Approach?
              </p>
              <h2 class="text-4xl sm:text-5xl font-bold text-foreground font-display tracking-tighter mb-8">
                Built for
                <span class="text-accent">Simplicity.</span>
              </h2>
              
              <div class="space-y-6">
                <div class="flex gap-4 py-4 border-b border-border">
                  <div class="w-8 h-8 bg-accent/10 flex items-center justify-center shrink-0 mt-1">
                    <Check className="h-4 w-4 text-accent" strokeWidth={3} />
                  </div>
                  <div>
                    <h3 class="font-bold text-foreground mb-1">Built for Speed</h3>
                    <p class="text-muted-foreground text-sm">No database queries, no plugin bloat. Just fast, reliable pages.</p>
                  </div>
                </div>
                
                <div class="flex gap-4 py-4 border-b border-border">
                  <div class="w-8 h-8 bg-accent/10 flex items-center justify-center shrink-0 mt-1">
                    <Check className="h-4 w-4 text-accent" strokeWidth={3} />
                  </div>
                  <div>
                    <h3 class="font-bold text-foreground mb-1">Fewer Security Concerns</h3>
                    <p class="text-muted-foreground text-sm">No database means fewer attack vectors. Less to worry about.</p>
                  </div>
                </div>
                
                <div class="flex gap-4 py-4 border-b border-border">
                  <div class="w-8 h-8 bg-accent/10 flex items-center justify-center shrink-0 mt-1">
                    <Check className="h-4 w-4 text-accent" strokeWidth={3} />
                  </div>
                  <div>
                    <h3 class="font-bold text-foreground mb-1">Low Maintenance</h3>
                    <p class="text-muted-foreground text-sm">No constant plugin updates or security patches. It just works.</p>
                  </div>
                </div>
              </div>
            </div>
            
            <div class="border border-border p-8 lg:p-12">
              <div class="text-center mb-8">
                <h3 class="text-2xl font-bold text-foreground font-display mb-2">Need to Update Content?</h3>
                <p class="text-muted-foreground">We offer CMS options too. You get easy updates with the speed and reliability of a simple site.</p>
              </div>
              
              <div class="space-y-3">
                <Button className="w-full rounded-none h-12 font-semibold">
                  <a href="/pricing">View All Options</a>
                </Button>
                <Button variant="outline" className="w-full rounded-none h-12">
                  <a href="/contact">Ask Us Anything</a>
                </Button>
              </div>
            </div>
          </div>
        </div>
      </section>

    </main>
    <Footer />
  </div>
</Layout>

<script>
  function initCurrencyPricing() {
    const timezone = Intl.DateTimeFormat().resolvedOptions().timeZone;
    
    type Currency = "GBP" | "EUR" | "USD";
    let currency: Currency = "USD";
    
    const euroTimezones = new Set([
      "Europe/Dublin", "Europe/Lisbon", "Europe/Berlin", "Europe/Paris",
      "Europe/Rome", "Europe/Madrid", "Europe/Amsterdam", "Europe/Brussels",
      "Europe/Vienna", "Europe/Bratislava", "Europe/Budapest", "Europe/Prague",
      "Europe/Warsaw", "Europe/Copenhagen", "Europe/Stockholm", "Europe/Oslo",
      "Europe/Helsinki", "Europe/Tallinn", "Europe/Riga", "Europe/Vilnius",
      "Europe/Ljubljana", "Europe/Zagreb", "Europe/Athens", "Europe/Sofia",
      "Europe/Bucharest", "Europe/Nicosia", "Europe/Malta", "Europe/Luxembourg",
    ]);
    
    if (timezone === "Europe/London") {
      currency = "GBP";
    } else if (euroTimezones.has(timezone)) {
      currency = "EUR";
    }
    
    if (currency === "GBP") return;
    
    const rates: Record<Currency, number> = { GBP: 1, EUR: 1.17, USD: 1.27 };
    const symbols: Record<Currency, string> = { GBP: "£", EUR: "€", USD: "$" };
    
    const rate = rates[currency];
    const symbol = symbols[currency];
    
    function convertPrice(gbp: number): number {
      return Math.ceil(gbp * rate);
    }
    
    document.querySelectorAll("[data-price-gbp]").forEach((el) => {
      const gbp = parseInt(el.getAttribute("data-price-gbp") || "0", 10);
      const converted = convertPrice(gbp);
      el.textContent = `${symbol}${converted}`;
    });
    
    document.querySelectorAll("[data-hosting-gbp]").forEach((el) => {
      const converted = convertPrice(50);
      const text = el.textContent || "";
      el.textContent = text.replace(/[£€$]\d+/, `${symbol}${converted}`);
    });
  }
  
  document.addEventListener("DOMContentLoaded", initCurrencyPricing);
</script>