---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import CtaPanel from '../components/CtaPanel.astro';
import Reveal from '../components/effects/Reveal.astro';
import Spotlight from '../components/effects/Spotlight';
import TiltCard from '../components/effects/TiltCard';
import { ArrowRight, Check, Clock, Gauge, MousePointerClick, ShieldCheck, Sparkles } from 'lucide-react';

const websitePackage = {
  priceGbp: 599,
  timeline: '1-3 weeks',
  features: [
    'The core pages your business needs to launch',
    'Custom design for your business',
    'Mobile-friendly layout',
    'Contact form',
    'Basic SEO setup',
    'Launch support'
  ],
  goodFit: [
    'Local service businesses',
    'Consultants and freelancers',
    'Studios, trades, and small teams'
  ]
};

const addOns = [
  {
    title: 'Editable Content Add-On',
    priceGbp: 800,
    description: 'Adds a CMS so you can update pages, services, pricing, testimonials, and publish blog or news posts yourself.',
    features: ['CMS setup', 'Editable page content and blog/news', 'Editor training at handover'],
    featured: true,
  }
];

const processSteps = [
  {
    step: '01',
    title: 'Quick Discovery',
    description: 'A short call or email exchange to understand your business and what the website needs to do.',
    duration: '30-60 min'
  },
  {
    step: '02',
    title: 'Direction First',
    description: 'I put together the draft direction or an initial page so you can see whether the look and structure feel right.',
    duration: '1-2 days'
  },
  {
    step: '03',
    title: 'Build and Review',
    description: 'Once the direction is approved, I complete the site and we review everything together before launch.',
    duration: '1-3 weeks'
  },
  {
    step: '04',
    title: 'Payment, Domain, and Launch',
    description: 'When the site is approved, payment is made before launch. I then handle DNS, domain setup, and getting the site live.',
    duration: '1-2 days'
  }
];

const whyPoints = [
  { title: "Clear information first", desc: "Visitors can quickly understand what you do, what it costs, and what to do next.", icon: MousePointerClick, tint: "from-indigo-500 to-violet-500" },
  { title: "Fast and low-maintenance", desc: "Simple websites tend to be quicker to launch, easier to run, and less likely to create technical headaches.", icon: Gauge, tint: "from-violet-500 to-fuchsia-500" },
  { title: "Editing only when needed", desc: "If your prices, services, or updates change regularly, the editing add-on keeps that manageable without overcomplicating the whole site.", icon: ShieldCheck, tint: "from-cyan-500 to-blue-500" },
];
---

<Layout title="Websites | Staticfish" description="Clear business websites for small businesses, with an optional CMS setup if you want to manage content yourself.">
  <div class="min-h-screen flex flex-col">
    <Header />
    <main class="flex-1">
      <PageHero eyebrow="Websites">
        <span slot="title">Websites for <span class="gradient-text-animated">small businesses.</span></span>
        The main offer at Staticfish is a clear business website. If you want to update content yourself, I can add a proper CMS rather than forcing that complexity into every project.
      </PageHero>

      <!-- Core package -->
      <section class="mx-auto max-w-7xl px-6 pb-24">
        <div class="grid items-start gap-8 lg:grid-cols-12">
          <Reveal variant="left" className="lg:col-span-5">
            <TiltCard client:load max={5}>
              <div class="gradient-border glow-shadow overflow-hidden">
                <div class="relative p-8 lg:p-10">
                  <div class="mb-6 flex items-center justify-between">
                    <span class="inline-flex items-center gap-2 rounded-full bg-indigo-50 px-4 py-1.5 text-[11px] font-bold uppercase tracking-widest text-indigo-600">
                      <Clock className="h-3.5 w-3.5" /> {websitePackage.timeline}
                    </span>
                    <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-50 px-3 py-1.5 text-[11px] font-bold uppercase tracking-widest text-emerald-600">
                      <span class="live-badge inline-block h-1.5 w-1.5 rounded-full bg-emerald-500"></span> Booking now
                    </span>
                  </div>
                  <h2 class="font-display text-3xl font-bold tracking-tight">Business Website</h2>
                  <p class="mt-3 leading-relaxed text-slate-600">
                    A professional website built to explain who you are, what you offer, what it costs, and how people can contact you.
                  </p>
                  <div class="mt-7 flex items-end gap-2">
                    <span class="gradient-text-animated font-display text-6xl font-bold tracking-tight" data-price-gbp={websitePackage.priceGbp}>£{websitePackage.priceGbp}</span>
                    <span class="pb-2 text-sm font-semibold text-slate-500">upfront</span>
                  </div>
                  <p class="mt-2 text-sm text-slate-500" data-hosting-gbp>+ £25/month hosting, backups &amp; upkeep</p>
                  <div class="mt-7 flex flex-col gap-3">
                    <a href="/contact" class="btn-primary-glow group inline-flex items-center justify-center gap-2 rounded-full px-8 py-4 text-sm font-bold text-white">
                      <span class="relative z-[2] flex items-center gap-2">Ask for a Quote <ArrowRight className="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" /></span>
                    </a>
                    <a href="/pricing" class="btn-ghost-glass inline-flex items-center justify-center rounded-full px-8 py-3.5 text-sm font-bold text-slate-800">
                      Compare pricing
                    </a>
                  </div>
                </div>
              </div>
            </TiltCard>
          </Reveal>

          <div class="lg:col-span-7">
            <Reveal delay={110}>
              <Spotlight client:load className="card-lift rounded-3xl border border-indigo-100/70 bg-white/80 p-8 backdrop-blur lg:p-10">
                <h3 class="mb-6 font-display text-xl font-bold tracking-tight">What's included</h3>
                <ul class="grid gap-4 sm:grid-cols-2">
                  {websitePackage.features.map((feature) => (
                    <li class="flex items-start gap-3 rounded-2xl bg-slate-50/80 p-4">
                      <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-indigo-500 to-cyan-500 text-white">
                        <Check className="h-3.5 w-3.5" strokeWidth={3} />
                      </span>
                      <span class="text-sm font-medium leading-relaxed text-slate-700">{feature}</span>
                    </li>
                  ))}
                </ul>
                <div class="mt-7 border-t border-slate-100 pt-6">
                  <p class="mb-3 text-[11px] font-bold uppercase tracking-[0.2em] text-indigo-500">Good fit for</p>
                  <div class="flex flex-wrap gap-2">
                    {websitePackage.goodFit.map((item) => (
                      <span class="rounded-full border border-indigo-100 bg-indigo-50/60 px-4 py-1.5 text-xs font-bold text-indigo-700">
                        {item}
                      </span>
                    ))}
                  </div>
                  <p class="mt-6 text-sm leading-relaxed text-slate-500">
                    If you need editable content, those projects start from <strong class="text-slate-800" data-currency-gbp="50" data-currency-suffix="/month">£50/month</strong> ongoing to cover the CMS, hosting, and support properly.
                  </p>
                </div>
              </Spotlight>
            </Reveal>
          </div>
        </div>
      </section>

      <!-- Add-on -->
      <section class="relative overflow-hidden py-24">
        <div class="absolute inset-0 bg-gradient-to-b from-transparent via-violet-50/70 to-transparent" aria-hidden="true"></div>
        <div class="relative mx-auto max-w-7xl px-6">
          <div class="mb-12 max-w-3xl">
            <Reveal>
              <span class="eyebrow-pill"><span class="eyebrow-dot"></span> Optional add-on</span>
            </Reveal>
            <Reveal delay={90}>
              <h2 class="mt-6 font-display text-4xl font-bold tracking-tight sm:text-5xl">Add editing <span class="serif-accent font-normal">if you need it.</span></h2>
            </Reveal>
            <Reveal delay={160}>
              <p class="mt-5 text-lg leading-relaxed text-slate-600">
                Most sites do not need a CMS. If you want to edit pages, services, pricing, testimonials, or publish blog and news posts yourself, I can add one cleanly.
              </p>
            </Reveal>
          </div>

          {addOns.map((addOn) => (
            <Reveal variant="scale">
              <Spotlight client:load className="card-lift relative max-w-3xl overflow-hidden rounded-[2rem] border border-white/70 bg-white/90 p-8 shadow-xl shadow-violet-500/10 backdrop-blur lg:p-12">
                <div class="absolute -right-20 -top-20 h-64 w-64 rounded-full bg-gradient-to-br from-violet-400/25 to-cyan-400/25 blur-3xl" aria-hidden="true"></div>
                <div class="relative">
                  {addOn.featured && (
                    <span class="mb-6 inline-flex items-center gap-1.5 rounded-full bg-gradient-to-r from-indigo-600 to-violet-600 px-4 py-1.5 text-[11px] font-bold uppercase tracking-widest text-white shadow-lg shadow-indigo-500/30">
                      <Sparkles className="h-3 w-3" /> Most common add-on
                    </span>
                  )}
                  <h3 class="font-display text-2xl font-bold tracking-tight sm:text-3xl">{addOn.title}</h3>
                  <p class="mt-3 flex items-baseline gap-2">
                    <span class="text-sm font-semibold uppercase tracking-wider text-slate-400">from +</span>
                    <span class="gradient-text font-display text-5xl font-bold tracking-tight" data-price-gbp={addOn.priceGbp}>£{addOn.priceGbp}</span>
                  </p>
                  <p class="mt-4 max-w-xl leading-relaxed text-slate-600">{addOn.description}</p>
                  <ul class="mt-7 grid gap-3 border-t border-slate-100 pt-7 sm:grid-cols-3">
                    {addOn.features.map((feature) => (
                      <li class="flex items-start gap-2.5 text-sm font-medium text-slate-700">
                        <Check className="mt-0.5 h-4 w-4 shrink-0 text-emerald-500" strokeWidth={3} />
                        {feature}
                      </li>
                    ))}
                  </ul>
                </div>
              </Spotlight>
            </Reveal>
          ))}

          <Reveal delay={120}>
            <div class="mt-8 max-w-3xl space-y-4 text-sm leading-relaxed text-slate-500">
              <p>
                Editable-content projects also have a higher ongoing fee than brochure sites, because there is a real CMS and editor access to support. If you need a more tailored enquiry flow, booking setup, or something outside the normal website scope, I quote that separately based on what the business actually needs.
              </p>
              <p>
                If you already have a domain name, I can connect it. If you need a new one, I can register it for you, but the domain cost is paid by you separately.
              </p>
            </div>
          </Reveal>
        </div>
      </section>

      <!-- Why -->
      <section class="mx-auto max-w-7xl px-6 py-24">
        <div class="grid items-start gap-12 lg:grid-cols-2">
          <div class="lg:sticky lg:top-32">
            <Reveal>
              <span class="eyebrow-pill"><span class="eyebrow-dot"></span> Why this works</span>
            </Reveal>
            <Reveal delay={90}>
              <h2 class="mt-6 font-display text-4xl font-bold tracking-tight sm:text-5xl">
                Built to be easy to <span class="gradient-text">understand.</span>
              </h2>
            </Reveal>
            <Reveal delay={160}>
              <p class="mt-5 max-w-xl text-lg leading-relaxed text-slate-600">
                Most small businesses do not need a sprawling platform. They need a site that feels professional, loads quickly, and gives visitors the information they need without friction.
              </p>
            </Reveal>
          </div>
          <div class="space-y-5">
            {whyPoints.map((point, i) => (
              <Reveal delay={i * 110}>
                <Spotlight client:load className="card-lift rounded-3xl border border-indigo-100/70 bg-white/80 p-7 backdrop-blur">
                  <div class="flex gap-5">
                    <span class={`flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-gradient-to-br ${point.tint} text-white shadow-lg`}>
                      <point.icon className="h-5 w-5" />
                    </span>
                    <div>
                      <h3 class="font-display text-lg font-bold tracking-tight">{point.title}</h3>
                      <p class="mt-1.5 text-sm leading-relaxed text-slate-600">{point.desc}</p>
                    </div>
                  </div>
                </Spotlight>
              </Reveal>
            ))}
          </div>
        </div>
      </section>

      <!-- Process -->
      <section class="mx-auto max-w-5xl px-6 pb-24">
        <Reveal>
          <span class="eyebrow-pill"><span class="eyebrow-dot"></span> Process</span>
        </Reveal>
        <Reveal delay={90}>
          <h2 class="mb-14 mt-6 font-display text-4xl font-bold tracking-tight sm:text-5xl">A simple process.</h2>
        </Reveal>
        <div class="relative">
          <div class="absolute bottom-8 left-[27px] top-8 w-0.5 rounded-full bg-gradient-to-b from-indigo-500 via-violet-400 to-cyan-400" aria-hidden="true"></div>
          <div class="space-y-5">
            {processSteps.map((step, i) => (
              <Reveal delay={i * 90}>
                <div class="card-lift group relative ml-0 flex gap-6 rounded-3xl border border-indigo-100/70 bg-white/80 p-6 pl-5 backdrop-blur sm:p-7">
                  <span class="relative z-10 flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-slate-900 font-display text-sm font-bold text-white shadow-lg transition-all duration-300 group-hover:bg-gradient-to-br group-hover:from-indigo-600 group-hover:to-violet-600">
                    {step.step}
                  </span>
                  <div class="flex flex-1 flex-wrap items-start justify-between gap-3">
                    <div class="min-w-[200px] flex-1">
                      <h3 class="font-display text-xl font-bold tracking-tight">{step.title}</h3>
                      <p class="mt-2 max-w-xl text-sm leading-relaxed text-slate-600">{step.description}</p>
                    </div>
                    <span class="rounded-full bg-indigo-50 px-4 py-1.5 text-[11px] font-bold uppercase tracking-widest text-indigo-600">{step.duration}</span>
                  </div>
                </div>
              </Reveal>
            ))}
          </div>
        </div>
      </section>

      <CtaPanel
        eyebrow="Secondary service"
        title="Need something more"
        highlight="custom?"
        description="Most of my work is business websites, but I also take on selected custom software projects when a business needs a portal, dashboard, workflow, or bespoke web app."
        primary={{ href: "/custom-software", label: "View Custom Software" }}
        secondary={{ href: "/contact", label: "Ask About Your Project" }}
      />
    </main>
    <Footer />
  </div>
</Layout>
