---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import CtaPanel from '../components/CtaPanel.astro';
import Button from '../components/ui/Button.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import Card from '../components/ui/Card.astro';
import Chip from '../components/ui/Chip.astro';
import Steps from '../components/Steps.astro';
import { Check, Clock, Sparkles } from 'lucide-react';

const websitePackage = {
  priceGbp: 599,
  timeline: '1-3 weeks',
  features: [
    'The core pages your business needs to launch',
    'Custom design for your business',
    'Mobile-friendly layout',
    'Contact form',
    'Basic SEO setup',
    'Launch support'
  ],
  goodFit: [
    'Local service businesses',
    'Consultants and freelancers',
    'Studios, trades, and small teams'
  ]
};

const addOns = [
  {
    title: 'Editable Content Add-On',
    priceGbp: 800,
    description: 'Adds a CMS so you can update pages, services, pricing, testimonials, and publish blog or news posts yourself.',
    features: ['CMS setup', 'Editable page content and blog/news', 'Editor training at handover'],
    featured: true,
  }
];

const processSteps = [
  {
    marker: '01',
    title: 'Quick Discovery',
    description: 'A short call or email exchange to understand your business and what the website needs to do.',
    meta: '30-60 min'
  },
  {
    marker: '02',
    title: 'Direction First',
    description: 'I put together the draft direction or an initial page so you can see whether the look and structure feel right.',
    meta: '1-2 days'
  },
  {
    marker: '03',
    title: 'Build and Review',
    description: 'Once the direction is approved, I complete the site and we review everything together before launch.',
    meta: '1-3 weeks'
  },
  {
    marker: '04',
    title: 'Payment, Domain, and Launch',
    description: 'When the site is approved, payment is made before launch. I then handle DNS, domain setup, and getting the site live.',
    meta: '1-2 days'
  }
];

const whyPoints = [
  { num: "01", title: "Clear information first", desc: "Visitors can quickly understand what you do, what it costs, and what to do next." },
  { num: "02", title: "Fast and low-maintenance", desc: "Simple websites tend to be quicker to launch, easier to run, and less likely to create technical headaches." },
  { num: "03", title: "Editing only when needed", desc: "If your prices, services, or updates change regularly, the editing add-on keeps that manageable without overcomplicating the whole site." },
];
---

<Layout title="Websites | Staticfish" description="Clear business websites for small businesses, with an optional CMS setup if you want to manage content yourself.">
  <div class="min-h-screen flex flex-col">
    <Header />
    <main class="flex-1">
      <PageHero eyebrow="Websites">
        <span slot="title">Websites for <span class="gradient-text-bright">small businesses.</span></span>
        The main offer at Staticfish is a clear business website. If you want to update content yourself, I can add a proper CMS rather than forcing that complexity into every project.
      </PageHero>

      <!-- Core package -->
      <section class="mx-auto max-w-6xl px-6 py-16 lg:py-24">
          <div class="overflow-hidden rounded-[2rem] border border-bone/10 bg-bone/[0.03] backdrop-blur">
            <div class="grid lg:grid-cols-[1fr_1.15fr]">
              <div class="p-8 sm:p-10 lg:p-12">
                <div class="flex flex-wrap items-center gap-2">
                  <span class="inline-flex items-center gap-1.5 rounded-full border border-bone/15 bg-bone/5 px-3.5 py-1.5 text-[11px] font-bold uppercase tracking-widest text-slate-200">
                    <Clock className="h-3 w-3" /> {websitePackage.timeline}
                  </span>
                  <span class="inline-flex items-center gap-1.5 rounded-full border border-emerald-400/30 bg-emerald-400/10 px-3.5 py-1.5 text-[11px] font-bold uppercase tracking-widest text-emerald-300">
                    <span class="live-badge inline-block h-1.5 w-1.5 rounded-full bg-emerald-400"></span> Booking now
                  </span>
                </div>
                <h2 class="mt-6 font-display text-3xl font-bold tracking-tight text-bone">Business Website</h2>
                <p class="mt-3 leading-relaxed text-slate-400">
                  A professional website built to explain who you are, what you offer, what it costs, and how people can contact you.
                </p>
                <p class="mt-8 flex items-baseline gap-2">
                  <span class="font-display text-6xl font-bold tracking-tight text-bone" data-price-gbp={websitePackage.priceGbp}>£{websitePackage.priceGbp}</span>
                  <span class="text-sm font-medium text-slate-400">upfront</span>
                </p>
                <p class="mt-1.5 text-sm text-slate-400" data-hosting-gbp>+ £25/month hosting, backups &amp; upkeep</p>
                <div class="mt-8 flex flex-col gap-3 sm:flex-row lg:flex-col xl:flex-row">
                  <Button href="/contact" class="justify-center">Ask for a Quote</Button>
                  <Button href="/pricing" variant="secondary" arrow={false} class="justify-center">Compare pricing</Button>
                </div>
              </div>
              <div class="border-t border-bone/10 bg-bone/[0.02] p-8 sm:p-10 lg:border-l lg:border-t-0 lg:p-12">
                <p class="mb-2 text-[11px] font-bold uppercase tracking-[0.18em] text-slate-400">What's included</p>
                <ul class="divide-y divide-bone/10">
                  {websitePackage.features.map((feature) => (
                    <li class="flex items-center gap-3 py-3.5">
                      <Check className="h-4 w-4 shrink-0 text-emerald-400" strokeWidth={3} />
                      <span class="text-[15px] font-medium text-slate-200">{feature}</span>
                    </li>
                  ))}
                </ul>
                <p class="mb-3 mt-8 text-[11px] font-bold uppercase tracking-[0.18em] text-slate-400">Good fit for</p>
                <div class="flex flex-wrap gap-2">
                  {websitePackage.goodFit.map((item) => (
                    <Chip>{item}</Chip>
                  ))}
                </div>
                <p class="mt-6 border-t border-bone/10 pt-6 text-sm leading-relaxed text-slate-400">
                  If you need editable content, those projects start from <strong class="font-semibold text-bone" data-currency-gbp="50" data-currency-suffix="/month">£50/month</strong> ongoing to cover the CMS, hosting, and support properly.
                </p>
              </div>
            </div>
          </div>
      </section>

      <!-- Add-on -->
      <section class="border-y border-bone/[0.07] bg-bone/[0.02] py-16 lg:py-24">
        <div class="mx-auto max-w-6xl px-6">
          <SectionHeading eyebrow="Optional add-on">
            <span slot="title">Add editing <span class="serif-accent font-normal">if you need it.</span></span>
            Most sites do not need a CMS. If you want to edit pages, services, pricing, testimonials, or publish blog and news posts yourself, I can add one cleanly.
          </SectionHeading>

          {addOns.map((addOn) => (
              <Card class="max-w-3xl">
                {addOn.featured && (
                  <span class="mb-5 inline-flex items-center gap-1.5 rounded-full bg-bone px-3.5 py-1.5 text-[11px] font-bold uppercase tracking-widest text-slate-900">
                    <Sparkles className="h-3 w-3" /> Most common add-on
                  </span>
                )}
                <div class="flex flex-wrap items-end justify-between gap-6">
                  <div class="max-w-md">
                    <h3 class="font-display text-2xl font-bold tracking-tight text-bone">{addOn.title}</h3>
                    <p class="mt-3 leading-relaxed text-slate-400">{addOn.description}</p>
                  </div>
                  <p class="text-right">
                    <span class="block text-[11px] font-bold uppercase tracking-widest text-slate-400">from +</span>
                    <span class="font-display text-5xl font-bold tracking-tight text-bone" data-price-gbp={addOn.priceGbp}>£{addOn.priceGbp}</span>
                  </p>
                </div>
                <ul class="mt-7 flex flex-wrap gap-x-8 gap-y-3 border-t border-bone/10 pt-7">
                  {addOn.features.map((feature) => (
                    <li class="flex items-center gap-2.5 text-sm font-medium text-slate-300">
                      <Check className="h-4 w-4 shrink-0 text-emerald-400" strokeWidth={3} />
                      {feature}
                    </li>
                  ))}
                </ul>
              </Card>
          ))}

            <div class="mt-8 max-w-3xl space-y-4 text-sm leading-relaxed text-slate-400">
              <p>
                Editable-content projects also have a higher ongoing fee than brochure sites, because there is a real CMS and editor access to support. If you need a more tailored enquiry flow, booking setup, or something outside the normal website scope, I quote that separately based on what the business actually needs.
              </p>
              <p>
                If you already have a domain name, I can connect it. If you need a new one, I can register it for you, but the domain cost is paid by you separately.
              </p>
            </div>
        </div>
      </section>

      <!-- Why -->
      <section class="mx-auto max-w-6xl px-6 py-16 lg:py-24">
        <SectionHeading eyebrow="Why this works">
          <span slot="title">Built to be easy to understand.</span>
          Most small businesses do not need a sprawling platform. They need a site that feels professional, loads quickly, and gives visitors the information they need without friction.
        </SectionHeading>
        <div class="grid gap-10 sm:grid-cols-3 sm:gap-0 sm:divide-x sm:divide-bone/10">
          {whyPoints.map((point, i) => (
            <div class="sm:px-8 sm:first:pl-0 sm:last:pr-0">
              <p class="font-display text-sm font-bold tracking-widest text-ember">{point.num}</p>
              <h3 class="mt-5 font-display text-lg font-bold tracking-tight text-bone">{point.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-slate-400">{point.desc}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- Process -->
      <section class="mx-auto max-w-4xl px-6 pb-20 lg:pb-28">
          <span class="eyebrow-pill"><span class="eyebrow-dot"></span> Process</span>
          <h2 class="mb-10 mt-5 font-display text-3xl font-bold tracking-tight text-bone sm:text-4xl">A simple process.</h2>
        <Steps items={processSteps} />
      </section>

      <CtaPanel
        eyebrow="Secondary service"
        title="Need something more"
        highlight="custom?"
        description="Most of my work is business websites, but I also take on selected custom software projects when a business needs a portal, dashboard, workflow, or bespoke web app."
        primary={{ href: "/custom-software", label: "View Custom Software" }}
        secondary={{ href: "/contact", label: "Ask About Your Project" }}
      />
    </main>
    <Footer />
  </div>
</Layout>
