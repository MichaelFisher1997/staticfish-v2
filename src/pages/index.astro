---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { Button } from '../components/ui/button';
import { ArrowRight, ArrowUpRight } from 'lucide-react';
import { SeigaihaBackground, WaveBands, JapaneseWaveCorner } from '../components/WaveArt';

const projects = [
  {
    title: "Redot Engine",
    category: "Community Platform",
    image: "/portfolio-redot.png",
    url: "https://www.redotengine.org/",
  },
  {
    title: "Chattybox AI",
    category: "SaaS Platform",
    image: "/portfolio-chattybox.png",
    url: "https://chattybox.ai/",
  }
];

const services = [
  {
    num: "01",
    title: "Static Website",
    price: "£149",
    desc: "Up to 5 pages. Perfect for businesses that want a professional presence without ongoing updates."
  },
  {
    num: "02",
    title: "CMS Website",
    price: "£249",
    desc: "Unlimited pages with an easy editor. Update your own content whenever you need."
  },
  {
    num: "03",
    title: "E-Commerce",
    price: "£399",
    desc: "Sell online with secure payments. Full store management included."
  }
];
---

<Layout title="Staticfish | Websites for Small Businesses" description="Professional web development for small businesses. Fixed pricing, fast delivery, no hidden costs.">
  <div class="min-h-screen flex flex-col bg-background">
    
    <Header />
    
    <main class="flex-1">
      
      <!-- HERO WITH WAVES -->
      <section class="pt-32 pb-20 lg:pb-32 relative overflow-hidden">
        <SeigaihaBackground opacity={0.15} />
        <JapaneseWaveCorner position="bottom-right" />
        <div class="container mx-auto max-w-7xl px-6 relative z-10">
          <div class="grid lg:grid-cols-12 gap-12 items-end">
            
            <div class="lg:col-span-7">
              <p class="text-sm font-medium text-muted-foreground uppercase tracking-widest mb-6">
                Web Development Studio
              </p>
              
              <h1 class="font-display text-6xl sm:text-7xl lg:text-8xl font-bold tracking-tighter leading-[0.9] text-foreground mb-8">
                We build
                <span class="block">websites that</span>
                <span class="block text-accent">work.</span>
              </h1>
              
              <p class="text-lg text-muted-foreground max-w-md leading-relaxed mb-10">
                No agency fluff. No DIY headaches. Just fast, professional websites that bring you customers.
              </p>
              
              <div class="flex items-center gap-6">
                <Button className="rounded-none px-8 h-12 font-semibold">
                  <a href="/contact" class="flex items-center gap-2">
                    Get a Quote <ArrowRight className="h-4 w-4" />
                  </a>
                </Button>
                <a href="/portfolio" class="text-sm font-medium text-muted-foreground hover:text-foreground transition-colors">
                  View Our Work
                </a>
              </div>
            </div>
            
            <div class="lg:col-span-5">
              <div class="relative">
                <img 
                  src="/illustrations/hero-abstract.svg" 
                  alt="Website building illustration"
                  class="w-full h-auto"
                />
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- STATS BAR -->
      <section class="py-12 border-t border-border">
        <div class="container mx-auto max-w-7xl px-6">
          <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <div>
              <div class="text-5xl font-bold font-display tracking-tighter">50+</div>
              <div class="text-sm text-muted-foreground mt-1">Projects Delivered</div>
            </div>
            <div class="md:border-l md:border-border md:pl-8">
              <div class="text-5xl font-bold font-display tracking-tighter">2 Weeks</div>
              <div class="text-sm text-muted-foreground mt-1">Average Delivery</div>
            </div>
            <div class="md:border-l md:border-border md:pl-8">
              <div class="text-5xl font-bold font-display tracking-tighter">£149</div>
              <div class="text-sm text-muted-foreground mt-1">Starting Price</div>
            </div>
          </div>
        </div>
      </section>

      <!-- SELECTED WORK WITH FLOWING LINES -->
      <section class="py-20 border-t border-border relative overflow-hidden">
        <WaveBands variant="teal" />
        
        <div class="container mx-auto max-w-7xl px-6 relative z-10">
          
          <div class="flex items-baseline justify-between mb-12">
            <h2 class="text-4xl sm:text-5xl font-bold font-display tracking-tighter">Selected Work</h2>
            <a href="/portfolio" class="text-sm font-medium text-muted-foreground hover:text-foreground transition-colors hidden sm:block">
              View All Projects
            </a>
          </div>

          <div class="grid md:grid-cols-2 gap-px bg-border">
            {projects.map((project) => (
              <a 
                href={project.url}
                target="_blank"
                rel="noopener noreferrer"
                class="group block bg-background hover:bg-secondary/30 transition-colors"
              >
                <div class="aspect-[16/10] overflow-hidden">
                  <img 
                    src={project.image} 
                    alt={project.title}
                    class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                  />
                </div>
                <div class="p-6 flex items-start justify-between">
                  <div>
                    <span class="text-xs font-semibold uppercase tracking-wider text-accent">{project.category}</span>
                    <h3 class="text-xl font-bold font-display mt-1">{project.title}</h3>
                  </div>
                  <ArrowUpRight className="h-5 w-5 text-muted-foreground group-hover:text-foreground transition-colors" />
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>

      <!-- SERVICES -->
      <section class="py-20 border-t border-border">
        <div class="container mx-auto max-w-7xl px-6">
          
          <h2 class="text-4xl sm:text-5xl font-bold font-display tracking-tighter mb-16">Services</h2>

          <div class="border-t border-border">
            {services.map((service, i) => (
              <a 
                href="/pricing" 
                class="group block border-b border-border py-10 hover:bg-secondary/20 transition-colors"
              >
                <div class="grid grid-cols-12 gap-6 items-start">
                  <div class="col-span-12 sm:col-span-1">
                    <span class="text-sm font-medium text-muted-foreground">{service.num}</span>
                  </div>
                  <div class="col-span-12 sm:col-span-4">
                    <h3 class="text-2xl font-bold font-display">{service.title}</h3>
                  </div>
                  <div class="col-span-12 sm:col-span-4">
                    <p class="text-muted-foreground text-sm leading-relaxed">{service.desc}</p>
                  </div>
                  <div class="col-span-12 sm:col-span-3 flex items-center justify-between">
                    <span class="text-2xl font-bold font-display">{service.price}</span>
                    <ArrowRight className="h-5 w-5 text-muted-foreground group-hover:text-foreground transition-colors" />
                  </div>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>

      <!-- TESTIMONIALS WITH WAVES -->
      <section class="py-20 border-t border-border bg-secondary/20 relative overflow-hidden">
        <WaveBands variant="coral" />
        
        <div class="container mx-auto max-w-7xl px-6 relative z-10">
          <div class="grid lg:grid-cols-2 gap-16">
            <div>
              <span class="text-sm font-medium text-muted-foreground uppercase tracking-widest mb-6 block">Testimonials</span>
              <h2 class="text-4xl sm:text-5xl font-bold font-display tracking-tighter">
                What our
                <span class="block">clients say</span>
              </h2>
            </div>

            <div class="space-y-12">
              <blockquote class="border-l-2 border-accent pl-8">
                <p class="text-xl text-foreground leading-relaxed mb-6">
                  "Our enquiries doubled in the first month after launch. The site looks professional and loads fast. Worth every penny."
                </p>
                <footer>
                  <strong class="text-foreground">Sarah Mitchell</strong>
                  <span class="text-muted-foreground"> — Mitchell Landscaping</span>
                </footer>
              </blockquote>

              <blockquote class="border-l-2 border-accent pl-8">
                <p class="text-xl text-foreground leading-relaxed mb-6">
                  "Exactly what was quoted is exactly what we paid. No hidden fees, no upselling. Refreshing to deal with a team this straightforward."
                </p>
                <footer>
                  <strong class="text-foreground">James Cooper</strong>
                  <span class="text-muted-foreground"> — Cooper & Sons Plumbing</span>
                </footer>
              </blockquote>
            </div>
          </div>
        </div>
      </section>

      <!-- CTA WITH CORNER WAVES -->
      <section class="py-20 border-t border-border relative overflow-hidden">
        <JapaneseWaveCorner position="top-left" />
        <div class="container mx-auto max-w-7xl px-6 relative z-10">
          
          <div class="bg-foreground text-background p-12 lg:p-20 relative">
            <div class="max-w-3xl">
              <h2 class="text-4xl sm:text-5xl lg:text-6xl font-bold font-display tracking-tighter mb-6">
                Ready to get started?
              </h2>
              <p class="text-lg text-background/70 mb-10 max-w-lg">
                Get in touch for a free, no-obligation quote. We'll give you an honest assessment and a clear price.
              </p>
              <Button className="rounded-none px-10 h-12 font-semibold bg-accent hover:bg-accent/90 text-white">
                <a href="/contact">Get Your Free Quote</a>
              </Button>
            </div>
          </div>
        </div>
      </section>

    </main>
    <Footer />
  </div>
</Layout>

<script>
  function initCurrencyPricing() {
    const timezone = Intl.DateTimeFormat().resolvedOptions().timeZone;
    
    type Currency = "GBP" | "EUR" | "USD";
    let currency: Currency = "USD";
    
    const euroTimezones = new Set([
      "Europe/Dublin", "Europe/Lisbon", "Europe/Berlin", "Europe/Paris",
      "Europe/Rome", "Europe/Madrid", "Europe/Amsterdam", "Europe/Brussels",
      "Europe/Vienna", "Europe/Bratislava", "Europe/Budapest", "Europe/Prague",
      "Europe/Warsaw", "Europe/Copenhagen", "Europe/Stockholm", "Europe/Oslo",
      "Europe/Helsinki", "Europe/Tallinn", "Europe/Riga", "Europe/Vilnius",
      "Europe/Ljubljana", "Europe/Zagreb", "Europe/Athens", "Europe/Sofia",
      "Europe/Bucharest", "Europe/Nicosia", "Europe/Malta", "Europe/Luxembourg",
    ]);
    
    if (timezone === "Europe/London") {
      currency = "GBP";
    } else if (euroTimezones.has(timezone)) {
      currency = "EUR";
    }
    
    if (currency === "GBP") return;
    
    const rates: Record<Currency, number> = { GBP: 1, EUR: 1.17, USD: 1.27 };
    const symbols: Record<Currency, string> = { GBP: "£", EUR: "€", USD: "$" };
    
    const rate = rates[currency];
    const symbol = symbols[currency];
    
    function convertPrice(gbp: number): number {
      return Math.ceil(gbp * rate);
    }
    
    document.querySelectorAll("[data-price-gbp]").forEach((el) => {
      const gbp = parseInt(el.getAttribute("data-price-gbp") || "0", 10);
      const converted = convertPrice(gbp);
      el.textContent = `${symbol}${converted}`;
    });
  }
  
  document.addEventListener("DOMContentLoaded", initCurrencyPricing);
</script>