---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Aurora from '../components/effects/Aurora.astro';
import Reveal from '../components/effects/Reveal.astro';
import Counter from '../components/effects/Counter';
import TiltCard from '../components/effects/TiltCard';
import Spotlight from '../components/effects/Spotlight';
import { ArrowRight, ArrowUpRight, BadgeCheck, Gauge, MousePointerClick, Rocket, ShieldCheck, Sparkles, Star, Zap } from 'lucide-react';

const projects = [
  {
    title: "Redot Engine",
    category: "Community Website",
    image: "/portfolio-redot.png",
    url: "https://www.redotengine.org/",
    role: "Structure + frontend",
    year: "2026",
    blurb: "A large content-heavy site rebuilt for speed and clarity.",
  },
  {
    title: "Chattybox AI",
    category: "Custom Platform",
    image: "/portfolio-chattybox.png",
    url: "https://chattybox.ai/",
    role: "SaaS product build",
    year: "2026",
    blurb: "A full SaaS product — proof custom builds ship here too.",
  }
];

const offers = [
  {
    num: "01",
    title: "Business Website",
    price: "£599 upfront",
    priceGbp: 599,
    priceSuffix: " upfront",
    desc: "A clear website for your services, pricing, FAQs, and contact details.",
    href: "/services",
    icon: Rocket,
    gradient: "from-indigo-500 to-violet-500",
  },
  {
    num: "02",
    title: "Editable Content Add-On",
    price: "From +£800",
    priceGbp: 800,
    pricePrefix: "From +",
    desc: "Adds a CMS so you can edit pages, services, pricing, testimonials, and blog or news posts yourself.",
    href: "/pricing#add-ons",
    icon: MousePointerClick,
    gradient: "from-violet-500 to-fuchsia-500",
  },
  {
    num: "03",
    title: "Custom Software",
    price: "Quoted separately",
    desc: "For portals, dashboards, workflows, and bespoke tools when a standard site is not enough.",
    href: "/custom-software",
    icon: Sparkles,
    gradient: "from-cyan-500 to-blue-500",
  }
];

const stack = ["Astro", "React", "TypeScript", "Tailwind CSS", "Cloudflare", "Sanity CMS", "Convex", "Stripe"];
---

<Layout title="Staticfish | Business Websites for Small Businesses" description="Clear business websites for small businesses, with optional editing and selected custom software when needed.">
  <div class="min-h-screen flex flex-col">
    <Header />

    <main class="flex-1">
      <!-- ============ HERO ============ -->
      <section class="relative overflow-hidden pt-36 pb-16 lg:pt-44 lg:pb-24">
        <Aurora variant="light" density="rich" />

        <div class="relative z-10 mx-auto max-w-7xl px-6">
          <div class="grid items-center gap-14 lg:grid-cols-12">
            <div class="lg:col-span-7">
              <div data-reveal>
                <span class="eyebrow-pill">
                  <span class="eyebrow-dot"></span>
                  Business websites · UK based
                </span>
              </div>

              <h1 data-reveal style="--reveal-delay: 90ms" class="text-balance mt-7 font-display text-5xl font-bold leading-[1.02] tracking-tight sm:text-6xl lg:text-7xl">
                Websites that help
                <span class="block">small businesses</span>
                <span class="gradient-text-animated block pb-2">look credible.</span>
              </h1>

              <p data-reveal style="--reveal-delay: 180ms" class="mt-6 max-w-xl text-lg leading-relaxed text-slate-600">
                I build clear, fast websites that explain what you do, what it costs, and how people can get in touch.
              </p>

              <div data-reveal style="--reveal-delay: 260ms" class="mt-9 flex flex-wrap items-center gap-4">
                <a href="/pricing" class="btn-primary-glow group inline-flex items-center gap-2 rounded-full px-8 py-4 text-sm font-bold text-white">
                  <span class="relative z-[2] flex items-center gap-2">
                    See Pricing
                    <ArrowRight className="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" />
                  </span>
                </a>
                <a href="/custom-software" class="btn-ghost-glass inline-flex items-center gap-2 rounded-full px-7 py-4 text-sm font-bold text-slate-800">
                  Need Something More Custom?
                </a>
              </div>

              <div data-reveal style="--reveal-delay: 340ms" class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-4">
                <div class="flex items-center gap-3">
                  <div class="flex -space-x-2.5">
                    <span class="flex h-9 w-9 items-center justify-center rounded-full bg-gradient-to-br from-indigo-500 to-violet-500 text-[11px] font-bold text-white ring-2 ring-white">RE</span>
                    <span class="flex h-9 w-9 items-center justify-center rounded-full bg-gradient-to-br from-cyan-500 to-blue-500 text-[11px] font-bold text-white ring-2 ring-white">CB</span>
                    <span class="flex h-9 w-9 items-center justify-center rounded-full bg-slate-900 text-[11px] font-bold text-white ring-2 ring-white">MF</span>
                  </div>
                  <div class="text-sm">
                    <div class="flex items-center gap-1">
                      {Array.from({ length: 5 }).map(() => (
                        <Star className="h-3.5 w-3.5 fill-amber-400 text-amber-400" />
                      ))}
                    </div>
                    <p class="mt-0.5 font-semibold text-slate-700">Direct with the builder</p>
                  </div>
                </div>
                <div class="hidden h-10 w-px bg-gradient-to-b from-transparent via-indigo-200 to-transparent sm:block"></div>
                <div class="flex items-center gap-2 text-sm font-semibold text-slate-600">
                  <ShieldCheck className="h-4 w-4 text-emerald-500" />
                  Fixed price · No surprises
                </div>
              </div>
            </div>

            <!-- Floating browser mock -->
            <div class="lg:col-span-5" data-reveal="scale" style="--reveal-delay: 200ms">
              <TiltCard client:load max={6}>
                <div class="relative">
                  <div class="absolute -inset-6 rounded-[2rem] bg-gradient-to-br from-indigo-400/30 via-violet-400/20 to-cyan-400/30 blur-2xl" aria-hidden="true"></div>
                  <div class="browser-glow tilt-inner relative overflow-hidden rounded-3xl border border-white/60 bg-white/90 backdrop-blur-xl">
                    <div class="flex items-center gap-2 border-b border-slate-100 bg-white/70 px-5 py-3.5">
                      <span class="h-2.5 w-2.5 rounded-full bg-rose-400"></span>
                      <span class="h-2.5 w-2.5 rounded-full bg-amber-400"></span>
                      <span class="h-2.5 w-2.5 rounded-full bg-emerald-400"></span>
                      <span class="ml-3 hidden flex-1 items-center gap-2 rounded-full bg-slate-100/80 px-4 py-1.5 text-[11px] font-medium text-slate-500 sm:flex">
                        <BadgeCheck className="h-3 w-3 text-emerald-500" /> yourbusiness.co.uk
                      </span>
                      <span class="ml-auto inline-flex items-center gap-1.5 rounded-full bg-emerald-50 px-3 py-1 text-[10px] font-bold uppercase tracking-widest text-emerald-600">
                        <span class="live-badge inline-block h-1.5 w-1.5 rounded-full bg-emerald-500"></span> Live
                      </span>
                    </div>
                    <div class="relative overflow-hidden">
                      <img src="/portfolio-chattybox.png" alt="Example website built by Staticfish" class="h-auto w-full object-cover" loading="eager" />
                      <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-indigo-950/30 via-transparent to-transparent"></div>
                    </div>
                    <div class="flex items-center justify-between gap-3 border-t border-slate-100 bg-white/80 px-5 py-4 backdrop-blur">
                      <div class="flex items-center gap-3">
                        <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-gradient-to-br from-indigo-500 to-cyan-500 text-white">
                          <Gauge className="h-4 w-4" />
                        </span>
                        <div>
                          <p class="text-xs font-bold text-slate-800">98 / 100 performance</p>
                          <p class="text-[11px] text-slate-500">Loads in under a second</p>
                        </div>
                      </div>
                      <div class="flex items-center gap-1 rounded-full bg-indigo-50 px-3 py-1.5 text-[11px] font-bold text-indigo-600">
                        <Zap className="h-3 w-3" /> Fast
                      </div>
                    </div>
                  </div>

                  <div class="glass animate-float absolute -left-4 top-16 hidden rounded-2xl px-4 py-3 sm:block lg:-left-10">
                    <p class="text-[10px] font-bold uppercase tracking-widest text-indigo-500">Starting at</p>
                    <p class="font-display text-2xl font-bold text-slate-900" data-price-gbp="599">£599</p>
                  </div>
                  <div class="glass animate-float-slow absolute -right-3 bottom-20 hidden rounded-2xl px-4 py-3 sm:block lg:-right-8" style="animation-delay: -4s">
                    <p class="text-[10px] font-bold uppercase tracking-widest text-cyan-600">Typical build</p>
                    <p class="font-display text-2xl font-bold text-slate-900">1–3 weeks</p>
                  </div>
                </div>
              </TiltCard>
            </div>
          </div>
        </div>

        <!-- Tech marquee -->
        <div class="relative z-10 mx-auto mt-16 max-w-7xl px-6" data-reveal style="--reveal-delay: 200ms">
          <div class="marquee-mask overflow-hidden rounded-2xl border border-indigo-100/70 bg-white/50 py-4 backdrop-blur">
            <div class="marquee-track items-center gap-10 pr-10">
              {[...stack, ...stack].map((tech) => (
                <span class="flex shrink-0 items-center gap-2.5 text-sm font-bold uppercase tracking-widest text-slate-400">
                  <span class="h-1.5 w-1.5 rounded-full bg-gradient-to-r from-indigo-500 to-cyan-500"></span>
                  {tech}
                </span>
              ))}
            </div>
          </div>
        </div>
      </section>

      <!-- ============ STATS BAND ============ -->
      <section class="relative z-10 mx-auto max-w-7xl px-6">
        <Reveal>
          <div class="dark-panel noise-overlay relative overflow-hidden rounded-[2rem] px-8 py-10 lg:px-14">
            <Aurora variant="dark" density="soft" />
            <div class="relative grid grid-cols-1 gap-10 sm:grid-cols-3">
              <div class="text-center sm:text-left">
                <p class="mb-2 text-[11px] font-bold uppercase tracking-[0.2em] text-indigo-300">Starting price</p>
                <p class="font-display text-5xl font-bold tracking-tight text-white lg:text-6xl">
                  <Counter client:visible to={599} prefix="£" />
                </p>
                <p class="mt-2 text-sm text-slate-400">Upfront for agreed scope</p>
              </div>
              <div class="text-center sm:border-x sm:border-white/10 sm:text-left sm:pl-10">
                <p class="mb-2 text-[11px] font-bold uppercase tracking-[0.2em] text-cyan-300">Typical build</p>
                <p class="font-display text-5xl font-bold tracking-tight text-white lg:text-6xl">1–3 <span class="text-3xl text-slate-300">weeks</span></p>
                <p class="mt-2 text-sm text-slate-400">From direction to launch</p>
              </div>
              <div class="text-center sm:text-left sm:pl-10">
                <p class="mb-2 text-[11px] font-bold uppercase tracking-[0.2em] text-violet-300">Ongoing care</p>
                <p class="font-display text-5xl font-bold tracking-tight text-white lg:text-6xl">
                  <Counter client:visible to={25} prefix="£" suffix="/mo" />
                </p>
                <p class="mt-2 text-sm text-slate-400">Hosting, backups, upkeep</p>
              </div>
            </div>
          </div>
        </Reveal>
      </section>

      <!-- ============ OFFERS ============ -->
      <section class="relative mx-auto max-w-7xl px-6 py-24 lg:py-32">
        <div class="mb-14 max-w-3xl">
          <Reveal>
            <span class="eyebrow-pill"><span class="eyebrow-dot"></span> What I offer</span>
          </Reveal>
          <Reveal delay={90}>
            <h2 class="mt-6 font-display text-4xl font-bold tracking-tight sm:text-5xl">
              One clear core offer, <span class="serif-accent font-normal">zero confusion.</span>
            </h2>
          </Reveal>
          <Reveal delay={160}>
            <p class="mt-5 text-lg leading-relaxed text-slate-600">
              Most businesses need a straightforward website first. Editing is optional, and custom software only comes into the picture when a normal website is not enough.
            </p>
          </Reveal>
        </div>

        <div class="grid gap-6 md:grid-cols-3">
          {offers.map((offer, i) => (
            <Reveal delay={i * 110} variant="scale">
              <Spotlight client:load className="card-lift group h-full rounded-3xl border border-indigo-100/70 bg-white/80 p-8 backdrop-blur">
                <a href={offer.href} class="relative block h-full">
                  <span class={`inline-flex h-12 w-12 items-center justify-center rounded-2xl bg-gradient-to-br ${offer.gradient} text-white shadow-lg transition-transform duration-500 group-hover:scale-110 group-hover:rotate-6`}>
                    <offer.icon className="h-5 w-5" />
                  </span>
                  <p class="mt-6 font-display text-sm font-bold tracking-widest text-slate-400">{offer.num}</p>
                  <h3 class="mt-1 font-display text-2xl font-bold tracking-tight">{offer.title}</h3>
                  <p class="mt-3 text-sm leading-relaxed text-slate-600">{offer.desc}</p>
                  <div class="mt-6 flex items-center justify-between border-t border-slate-100 pt-5">
                    {offer.num === "01" && <span class="font-display text-xl font-bold gradient-text" data-currency-gbp="599" data-currency-suffix=" upfront">{offer.price}</span>}
                    {offer.num === "02" && <span class="font-display text-xl font-bold gradient-text" data-currency-gbp="800" data-currency-prefix="From +">{offer.price}</span>}
                    {offer.num === "03" && <span class="font-display text-xl font-bold gradient-text">{offer.price}</span>}
                    <span class="flex h-10 w-10 items-center justify-center rounded-full bg-slate-900 text-white transition-all duration-300 group-hover:bg-gradient-to-r group-hover:from-indigo-600 group-hover:to-violet-600">
                      <ArrowRight className="h-4 w-4 transition-transform duration-300 group-hover:translate-x-0.5" />
                    </span>
                  </div>
                </a>
              </Spotlight>
            </Reveal>
          ))}
        </div>
      </section>

      <!-- ============ WORK ============ -->
      <section class="relative overflow-hidden py-24 lg:py-28">
        <div class="absolute inset-0 bg-gradient-to-b from-transparent via-indigo-50/60 to-transparent" aria-hidden="true"></div>
        <div class="relative mx-auto max-w-7xl px-6">
          <div class="mb-12 flex flex-wrap items-end justify-between gap-6">
            <div>
              <Reveal>
                <span class="eyebrow-pill"><span class="eyebrow-dot"></span> Selected work</span>
              </Reveal>
              <Reveal delay={90}>
                <h2 class="mt-6 font-display text-4xl font-bold tracking-tight sm:text-5xl">Recent work<span class="gradient-text">.</span></h2>
              </Reveal>
            </div>
            <Reveal delay={160}>
              <a href="/portfolio" class="link-underline hidden items-center gap-2 text-sm font-bold text-slate-600 hover:text-indigo-700 sm:inline-flex">
                View All Projects <ArrowUpRight className="h-4 w-4" />
              </a>
            </Reveal>
          </div>

          <div class="grid gap-6 md:grid-cols-2">
            {projects.map((project, i) => (
              <Reveal delay={i * 120} variant="scale">
                <TiltCard client:load max={5}>
                  <a href={project.url} target="_blank" rel="noopener noreferrer" class="card-lift group block overflow-hidden rounded-3xl border border-white/70 bg-white shadow-xl shadow-indigo-500/10">
                    <div class="relative overflow-hidden">
                      <img src={project.image} alt={project.title} class="aspect-[16/10] w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.05]" loading="lazy" />
                      <div class="absolute inset-0 bg-gradient-to-t from-indigo-950/50 via-transparent to-transparent opacity-0 transition-opacity duration-500 group-hover:opacity-100"></div>
                      <span class="glass absolute left-4 top-4 rounded-full px-4 py-1.5 text-[11px] font-bold uppercase tracking-widest text-indigo-700">{project.category}</span>
                      <span class="absolute bottom-4 right-4 flex h-12 w-12 translate-y-3 items-center justify-center rounded-full bg-white text-slate-900 opacity-0 shadow-xl transition-all duration-500 group-hover:translate-y-0 group-hover:opacity-100">
                        <ArrowUpRight className="h-5 w-5" />
                      </span>
                    </div>
                    <div class="p-7">
                      <h3 class="font-display text-2xl font-bold tracking-tight">{project.title}</h3>
                      <p class="mt-2 text-sm leading-relaxed text-slate-600">{project.blurb}</p>
                      <p class="mt-4 text-[11px] font-bold uppercase tracking-[0.18em] text-slate-400">{project.role} / {project.year}</p>
                    </div>
                  </a>
                </TiltCard>
              </Reveal>
            ))}
          </div>
        </div>
      </section>

      <!-- ============ WHY ============ -->
      <section class="mx-auto max-w-7xl px-6 py-24 lg:py-28">
        <div class="grid items-start gap-14 lg:grid-cols-2">
          <div class="lg:sticky lg:top-32">
            <Reveal>
              <span class="eyebrow-pill"><span class="eyebrow-dot"></span> Why Staticfish</span>
            </Reveal>
            <Reveal delay={90}>
              <h2 class="mt-6 font-display text-4xl font-bold tracking-tight sm:text-5xl">
                Clear scope.<br />Clear price.<br />
                <span class="serif-accent font-normal gradient-text">No games.</span>
              </h2>
            </Reveal>
            <Reveal delay={160}>
              <p class="mt-6 max-w-lg text-lg leading-relaxed text-slate-600">
                You work directly with me. The offer is simple, the scope is agreed up front, and there is no pressure to buy things you do not need.
              </p>
            </Reveal>
            <Reveal delay={220}>
              <a href="/about" class="btn-ghost-glass mt-8 inline-flex items-center gap-2 rounded-full px-7 py-3.5 text-sm font-bold text-slate-800">
                Meet the builder <ArrowRight className="h-4 w-4" />
              </a>
            </Reveal>
          </div>

          <div class="space-y-5">
            {[
              { title: "Fixed price for the agreed scope", desc: "You get a clear quote before work starts. If you want to add more later, I quote that separately.", icon: BadgeCheck, tint: "from-indigo-500 to-violet-500" },
              { title: "Built to explain the business clearly", desc: "The goal is simple: help people understand what you do, what it costs, and how to contact you.", icon: MousePointerClick, tint: "from-violet-500 to-fuchsia-500" },
              { title: "Optional editing when you need it", desc: "If your content changes regularly, I can add a simple editing setup without turning the whole site into something bloated.", icon: Sparkles, tint: "from-cyan-500 to-blue-500" },
            ].map((item, i) => (
              <Reveal delay={i * 110}>
                <Spotlight client:load className="card-lift rounded-3xl border border-indigo-100/70 bg-white/80 p-7 backdrop-blur sm:p-8">
                  <div class="flex gap-5">
                    <span class={`flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-gradient-to-br ${item.tint} text-white shadow-lg`}>
                      <item.icon className="h-5 w-5" />
                    </span>
                    <div>
                      <h3 class="font-display text-xl font-bold tracking-tight">{item.title}</h3>
                      <p class="mt-2 leading-relaxed text-slate-600">{item.desc}</p>
                    </div>
                  </div>
                </Spotlight>
              </Reveal>
            ))}
          </div>
        </div>
      </section>

      <!-- ============ CTA ============ -->
      <section class="mx-auto max-w-7xl px-6 pb-24 lg:pb-32">
        <Reveal variant="scale">
          <div class="dark-panel noise-overlay relative overflow-hidden rounded-[2.5rem] px-8 py-16 text-center sm:px-14 lg:py-24">
            <Aurora variant="dark" density="rich" />
            <div class="relative">
              <span class="eyebrow-pill eyebrow-pill-dark mx-auto">
                <span class="eyebrow-dot"></span> Next step
              </span>
              <h2 class="text-balance mx-auto mt-7 max-w-3xl font-display text-4xl font-bold tracking-tight text-white sm:text-5xl lg:text-6xl">
                Need a website that explains the business <span class="serif-accent font-normal text-transparent" style="background: linear-gradient(92deg, #a5b4fc, #67e8f9); -webkit-background-clip: text; background-clip: text;">properly?</span>
              </h2>
              <p class="mx-auto mt-6 max-w-xl text-lg leading-relaxed text-slate-300">
                Get in touch for a clear quote and an honest recommendation on whether you need a straightforward website, an editing add-on, or something more bespoke.
              </p>
              <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
                <a href="/contact" class="btn-primary-glow group inline-flex items-center gap-2 rounded-full px-10 py-4 text-sm font-bold text-white">
                  <span class="relative z-[2] flex items-center gap-2">
                    Get a Quote <ArrowRight className="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" />
                  </span>
                </a>
                <a href="/custom-software" class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/5 px-8 py-4 text-sm font-bold text-white backdrop-blur transition-all duration-300 hover:bg-white/10">
                  Custom Software
                </a>
              </div>
              <p class="mt-8 text-sm text-slate-400">
                Typical response within 24 hours · <span class="text-slate-200">contact@staticfish.co.uk</span>
              </p>
            </div>
          </div>
        </Reveal>
      </section>
    </main>

    <Footer />
  </div>
</Layout>
