---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CompanionScene from '../components/three/CompanionScene';
import Button from '../components/ui/Button.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import { ArrowRight, ArrowUpRight, MousePointerClick, ShieldCheck, UserRound } from 'lucide-react';

const projects = [
  {
    title: "Redot Engine",
    category: "Community Website",
    image: "/portfolio-redot.png",
    url: "https://www.redotengine.org/",
    role: "Structure + frontend",
    year: "2026",
    blurb: "A large content-heavy site rebuilt for speed and clarity.",
  },
  {
    title: "Chattybox AI",
    category: "Custom Platform",
    image: "/portfolio-chattybox.png",
    url: "https://chattybox.ai/",
    role: "SaaS product build",
    year: "2026",
    blurb: "A full SaaS product — proof custom builds ship here too.",
  }
];

const offers = [
  {
    num: "01",
    title: "Business Website",
    price: "£599 upfront",
    desc: "A clear website for your services, pricing, FAQs, and contact details.",
    href: "/services",
    points: ["Core pages built to launch", "Mobile-friendly layout", "Basic SEO setup"],
  },
  {
    num: "02",
    title: "Editable Content Add-On",
    price: "From +£800",
    desc: "Adds a CMS so you can edit pages, services, pricing, testimonials, and blog or news posts yourself.",
    href: "/pricing#add-ons",
    points: ["CMS setup", "Editable pages and posts", "Editor training at handover"],
  },
  {
    num: "03",
    title: "Custom Software",
    price: "Quoted separately",
    desc: "For portals, dashboards, workflows, and bespoke tools when a standard site is not enough.",
    href: "/custom-software",
    points: ["SaaS MVPs", "Client portals", "Product workflows"],
  }
];

const whyPoints = [
  { num: "01", title: "Fixed price for the agreed scope", desc: "You get a clear quote before work starts. If you want to add more later, I quote that separately." },
  { num: "02", title: "Built to explain the business clearly", desc: "The goal is simple: help people understand what you do, what it costs, and how to contact you." },
  { num: "03", title: "Optional editing when you need it", desc: "If your content changes regularly, I can add a simple editing setup without turning the whole site into something bloated." },
];

const stack = ["Astro", "React", "TypeScript", "Tailwind CSS", "Cloudflare", "Sanity CMS", "Convex", "Stripe"];
---

<Layout title="Staticfish | Business Websites for Small Businesses" description="Clear business websites for small businesses, with optional editing and selected custom software when needed.">
  <div class="min-h-screen flex flex-col">
    <Header />

    <!-- The 3D sculpture is a fixed companion across the whole page -->
    <div class="pointer-events-none fixed inset-0 z-0">
      <div class="pointer-events-auto h-full w-full">
        <CompanionScene client:only="react" />
      </div>
    </div>

    <main class="relative z-10 flex-1">
      <!-- ============ HERO ============ -->
      <section data-hero class="relative flex min-h-[100svh] flex-col overflow-hidden">

        <div class="pointer-events-none relative z-10 mx-auto flex w-full max-w-7xl flex-1 flex-col justify-center px-6 pb-16 pt-32 lg:pb-24 lg:pt-28">
          <div data-hero-copy class="pointer-events-auto max-w-2xl">
            <div data-hero-meta class="flex items-center gap-4">
              <p class="mono-label flex items-center gap-2.5 text-ash">
                <span class="inline-block h-1.5 w-1.5 rounded-full bg-accent"></span>Business websites — UK based
              </p>
              <span class="h-px flex-1 bg-bone/[0.08]" aria-hidden="true"></span>
              <p class="mono-label hidden sm:block">EST. 2025</p>
            </div>

            <h1 class="mt-8 text-balance text-5xl font-semibold leading-[1.02] tracking-tight text-bone sm:text-6xl lg:text-[4.75rem]">
              <span class="block overflow-hidden pb-1"><span data-hero-line class="block">Websites that help</span></span>
              <span class="block overflow-hidden pb-1"><span data-hero-line class="block">small businesses</span></span>
              <span class="block overflow-hidden pb-1"><span data-hero-line class="block text-ember">look credible.</span></span>
            </h1>

            <p data-hero-meta class="mt-7 max-w-xl text-lg leading-relaxed text-ash">
              I build clear, fast websites that explain what you do, what it costs, and how people can get in touch.
            </p>

            <div data-hero-meta class="mt-9 flex flex-wrap items-center gap-3">
              <Button href="/pricing" size="lg">See Pricing</Button>
              <Button href="/custom-software" variant="secondary" size="lg" arrow={false}>Need Something More Custom?</Button>
            </div>

            <div data-hero-meta class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-4 border-t border-bone/[0.08] pt-6">
              <div class="flex items-center gap-2 text-sm font-medium text-sand">
                <UserRound className="h-4 w-4 text-ember" />
                Direct with the builder
              </div>
              <div class="flex items-center gap-2 text-sm font-medium text-sand">
                <ShieldCheck className="h-4 w-4 text-ember" />
                Fixed price from <span class="text-bone" data-price-gbp="599">£599</span> · no surprises
              </div>
              <div class="mono-label flex items-center gap-2">
                <MousePointerClick className="h-3.5 w-3.5 text-ember" />
                Click the fish
              </div>
            </div>
          </div>
        </div>

        <div data-hero-cue class="absolute bottom-7 left-6 z-10 hidden items-center gap-3 lg:flex" aria-hidden="true">
          <span class="flex h-8 w-[18px] items-start justify-center rounded-full border border-bone/15 p-1">
            <span class="animate-bounce-soft inline-block h-1.5 w-1.5 rounded-full bg-accent"></span>
          </span>
          <span class="mono-label">Scroll</span>
        </div>
      </section>

      <!-- ============ STACK MARQUEE ============ -->
      <section class="relative border-y border-bone/[0.08] py-5">
        <div class="marquee-mask overflow-hidden">
          <div class="marquee-track">
            <div class="flex items-center">
              {stack.map((tech) => (
                <span class="mx-7 flex shrink-0 items-center gap-2.5 font-mono text-[11px] font-medium uppercase tracking-[0.2em] text-ash">
                  <span class="h-1 w-1 rounded-full bg-accent"></span>
                  {tech}
                </span>
              ))}
            </div>
            <div class="flex items-center" aria-hidden="true">
              {stack.map((tech) => (
                <span class="mx-7 flex shrink-0 items-center gap-2.5 font-mono text-[11px] font-medium uppercase tracking-[0.2em] text-ash">
                  <span class="h-1 w-1 rounded-full bg-accent"></span>
                  {tech}
                </span>
            ))}
          </div>
        </div>
        </div>
      </section>

      <!-- ============ SPEC SHEET ============ -->
      <section class="mx-auto max-w-7xl px-6 py-20 lg:py-24">
        <div data-reveal class="grid divide-y divide-bone/[0.12] border-y border-bone/[0.12] sm:grid-cols-3 sm:divide-x sm:divide-y-0">
          <div class="py-9 sm:px-10 sm:first:pl-0 sm:last:pr-0">
            <p class="mono-label">Starting price</p>
            <p class="mt-4 font-display text-4xl leading-none text-bone sm:text-5xl">
              <span data-price-gbp="599">£599</span>
              <span class="ml-2 align-middle text-base text-ash">upfront</span>
            </p>
          </div>
          <div class="py-9 sm:px-10 sm:first:pl-0 sm:last:pr-0">
            <p class="mono-label">Typical build</p>
            <p class="mt-4 font-display text-4xl leading-none text-bone sm:text-5xl">
              1–3
              <span class="ml-2 align-middle text-base text-ash">weeks</span>
            </p>
          </div>
          <div class="py-9 sm:px-10 sm:first:pl-0 sm:last:pr-0">
            <p class="mono-label">Ongoing care</p>
            <p class="mt-4 font-display text-4xl leading-none text-bone sm:text-5xl">
              <span data-currency-gbp="25" data-currency-suffix="/mo">£25/mo</span>
              <span class="ml-2 align-middle text-base text-ash">hosting &amp; upkeep</span>
            </p>
          </div>
        </div>
      </section>

      <!-- ============ OFFERS ============ -->
      <section class="mx-auto max-w-7xl px-6 pb-20 lg:pb-28">
        <div data-reveal class="max-w-3xl">
          <Eyebrow>What I offer</Eyebrow>
          <h2 class="mt-6 text-4xl font-semibold leading-[1.05] tracking-tight text-bone sm:text-5xl">
            One clear core offer,<br class="hidden sm:block" /> zero confusion.
          </h2>
          <p class="mt-5 max-w-2xl leading-relaxed text-ash">
            Most businesses need a straightforward website first. Editing is optional, and custom software only comes into the picture when a normal website is not enough.
          </p>
        </div>

        <div data-reveal-group class="mt-14 grid gap-x-5 border-t border-bone/[0.12] sm:grid-cols-[3rem_1fr] sm:gap-x-8">
          {offers.map((offer) => (
            <a
              href={offer.href}
              data-reveal-item
              class="group grid gap-x-5 border-b border-bone/[0.12] py-9 transition-colors duration-300 hover:bg-bone/[0.02] sm:col-span-2 sm:grid-cols-subgrid sm:px-4 lg:px-6"
            >
              <span class="font-mono text-xs font-medium tracking-[0.2em] text-ash transition-colors duration-300 group-hover:text-ember sm:pt-1.5">{offer.num}</span>
              <div>
                <div class="flex items-center gap-5">
                  <h3 class="shrink-0 font-display text-2xl font-semibold tracking-tight text-bone transition-colors duration-300 group-hover:text-ember sm:text-3xl">{offer.title}</h3>
                  <span class="hidden flex-1 border-b border-dotted border-bone/25 sm:block" aria-hidden="true"></span>
                  <span class="shrink-0 font-mono text-sm text-ember">
                    {offer.num === "01" && <span data-currency-gbp="599" data-currency-suffix=" upfront">{offer.price}</span>}
                    {offer.num === "02" && <span data-currency-gbp="800" data-currency-prefix="From +">{offer.price}</span>}
                    {offer.num === "03" && <span>{offer.price}</span>}
                  </span>
                  <span class="hidden h-9 w-9 shrink-0 items-center justify-center rounded-full border border-bone/[0.1] text-ash transition-all duration-300 group-hover:border-accent group-hover:bg-accent group-hover:text-[#e8e9fd] sm:flex">
                    <ArrowRight className="h-4 w-4" />
                  </span>
                </div>
                <p class="mt-4 max-w-2xl text-sm leading-relaxed text-ash">{offer.desc}</p>
                <p class="mt-3 font-mono text-[10px] uppercase tracking-[0.18em] text-faint">
                  {offer.points.join("   ·   ")}
                </p>
              </div>
            </a>
          ))}
        </div>
      </section>

      <!-- ============ WHY ============ -->
      <section class="mx-auto max-w-7xl px-6 py-20 lg:py-24">
        <div class="grid items-start gap-14 lg:grid-cols-2 lg:gap-24">
          <div data-reveal>
            <Eyebrow>Why Staticfish</Eyebrow>
            <h2 class="mt-6 text-4xl font-semibold leading-[1.05] tracking-tight text-bone sm:text-5xl">
              Clear scope.<br />Clear price.<br />
              <span class="text-ember">No games.</span>
            </h2>
            <p class="mt-6 max-w-lg leading-relaxed text-ash">
              You work directly with me. The offer is simple, the scope is agreed up front, and there is no pressure to buy things you do not need.
            </p>
            <Button href="/about" variant="secondary" class="mt-9">Meet the builder</Button>
          </div>

          <div class="hairline-list border-t border-bone/[0.12]" data-reveal-group>
            {whyPoints.map((item) => (
              <div data-reveal-item class="py-9 first:pt-0 last:pb-0">
                <p class="font-mono text-xs font-medium tracking-[0.2em] text-ember">{item.num}</p>
                <h3 class="mt-3 font-display text-xl font-semibold tracking-tight text-white">{item.title}</h3>
                <p class="mt-2 max-w-md text-sm leading-relaxed text-ash">{item.desc}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- ============ WORK ============ -->
      <section class="mx-auto max-w-7xl px-6 py-20 lg:py-24">
        <div data-reveal class="mb-12 flex flex-wrap items-end justify-between gap-6">
          <div class="max-w-xl">
            <Eyebrow>Selected work</Eyebrow>
            <h2 class="mt-6 text-4xl font-semibold leading-[1.05] tracking-tight text-bone sm:text-5xl">
              Recent work<span class="text-ember">.</span>
            </h2>
            <p class="mt-5 leading-relaxed text-ash">
              A small selection of projects that shows the standard of design and build quality I bring to client work.
            </p>
          </div>
          <a href="/portfolio" class="link-underline hidden items-center gap-2 text-sm font-semibold text-bone sm:inline-flex">
            View All Projects <ArrowUpRight className="h-4 w-4" />
          </a>
        </div>

        <div class="border-b border-bone/[0.12]" data-reveal-group>
          {projects.map((project, index) => (
            <article
              data-reveal-item
              class="grid items-center gap-8 border-t border-bone/[0.12] py-12 lg:grid-cols-12 lg:gap-14 lg:py-16"
            >
              <a
                href={project.url}
                target="_blank"
                rel="noopener noreferrer"
                class={`group block lg:col-span-7 ${index % 2 === 1 ? "lg:order-2" : ""}`}
              >
                <div class="overflow-hidden rounded-xl border border-bone/[0.1]">
                  <img
                    src={project.image}
                    alt={project.title}
                    class="aspect-[16/10] w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.02]"
                    loading="lazy"
                  />
                </div>
              </a>
              <div class={`lg:col-span-5 ${index % 2 === 1 ? "lg:order-1" : ""}`}>
                <div class="flex items-center gap-4">
                  <span class="font-mono text-xs font-medium tracking-[0.2em] text-ash">0{index + 1}</span>
                  <span class="h-px w-8 bg-bone/20" aria-hidden="true"></span>
                  <p class="mono-label">{project.category}</p>
                </div>
                <h3 class="mt-5 font-display text-3xl font-semibold leading-[1.05] tracking-tight text-bone sm:text-4xl lg:text-5xl">{project.title}</h3>
                <p class="mt-4 max-w-md leading-relaxed text-ash">{project.blurb}</p>
                <p class="mt-4 font-mono text-[10px] uppercase tracking-[0.18em] text-faint">{project.role} · {project.year}</p>
                <a
                  href={project.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group/link mt-7 inline-flex items-center gap-2 text-sm font-semibold text-bone"
                >
                  <span class="link-underline">View live site</span>
                  <ArrowUpRight className="h-4 w-4 transition-transform duration-300 group-hover/link:translate-x-0.5 group-hover/link:-translate-y-0.5" />
                </a>
              </div>
            </article>
          ))}
        </div>
      </section>

      <!-- ============ CTA ============ -->
      <section class="relative border-t border-bone/[0.08]">
        <div class="mx-auto max-w-7xl px-6 py-20 lg:py-28">
          <div data-reveal class="grid gap-12 lg:grid-cols-12 lg:items-end">
            <div class="lg:col-span-7">
              <p class="mono-label">Next step</p>
              <h2 class="mt-7 font-display text-5xl leading-[1.02] tracking-tight text-bone sm:text-6xl lg:text-7xl">
                Need a website that<br class="hidden sm:block" /> explains the business<br class="hidden sm:block" /> <span class="text-ember">properly?</span>
              </h2>
            </div>
            <div class="lg:col-span-5 lg:pb-2">
              <p class="max-w-md leading-relaxed text-ash">
                Get in touch for a clear quote and an honest recommendation on whether you need a straightforward website, an editing add-on, or something more bespoke.
              </p>
              <div class="mt-8 flex flex-wrap gap-3">
                <Button href="/contact" size="lg">Get a Quote</Button>
                <Button href="/custom-software" variant="secondary" size="lg" arrow={false}>Custom Software</Button>
              </div>
            </div>
          </div>

          <div data-reveal class="mt-14 flex flex-wrap items-center justify-between gap-4 border-t border-bone/[0.12] pt-7">
            <a
              href="mailto:contact@staticfish.co.uk"
              class="group inline-flex items-center gap-3 font-display text-xl tracking-tight text-bone transition-colors duration-300 hover:text-ember sm:text-2xl"
            >
              contact@staticfish.co.uk
              <ArrowUpRight className="h-5 w-5 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
            </a>
            <p class="mono-label">Typical response within 24 hours</p>
          </div>
        </div>
      </section>
    </main>

    <Footer />
  </div>
</Layout>
