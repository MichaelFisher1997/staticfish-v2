---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Halftone from '../components/effects/Halftone.astro';
import HeroSiteMock from '../components/HeroSiteMock.astro';
import Button from '../components/ui/Button.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import { ArrowRight, ArrowUpRight, BadgeCheck, Gauge, ShieldCheck, Timer, UserRound, Wallet } from 'lucide-react';

const projects = [
  {
    title: "Redot Engine",
    category: "Community Website",
    image: "/portfolio-redot.png",
    url: "https://www.redotengine.org/",
    role: "Structure + frontend",
    year: "2026",
    blurb: "A large content-heavy site rebuilt for speed and clarity.",
  },
  {
    title: "Chattybox AI",
    category: "Custom Platform",
    image: "/portfolio-chattybox.png",
    url: "https://chattybox.ai/",
    role: "SaaS product build",
    year: "2026",
    blurb: "A full SaaS product — proof custom builds ship here too.",
  }
];

const offers = [
  {
    num: "01",
    title: "Business Website",
    price: "£599 upfront",
    priceGbp: 599,
    priceSuffix: " upfront",
    desc: "A clear website for your services, pricing, FAQs, and contact details.",
    href: "/services",
  },
  {
    num: "02",
    title: "Editable Content Add-On",
    price: "From +£800",
    priceGbp: 800,
    pricePrefix: "From +",
    desc: "Adds a CMS so you can edit pages, services, pricing, testimonials, and blog or news posts yourself.",
    href: "/pricing#add-ons",
  },
  {
    num: "03",
    title: "Custom Software",
    price: "Quoted separately",
    desc: "For portals, dashboards, workflows, and bespoke tools when a standard site is not enough.",
    href: "/custom-software",
  }
];

const whyPoints = [
  { num: "01", title: "Fixed price for the agreed scope", desc: "You get a clear quote before work starts. If you want to add more later, I quote that separately." },
  { num: "02", title: "Built to explain the business clearly", desc: "The goal is simple: help people understand what you do, what it costs, and how to contact you." },
  { num: "03", title: "Optional editing when you need it", desc: "If your content changes regularly, I can add a simple editing setup without turning the whole site into something bloated." },
];

const stack = ["Astro", "React", "TypeScript", "Tailwind CSS", "Cloudflare", "Sanity CMS", "Convex", "Stripe"];
---

<Layout title="Staticfish | Business Websites for Small Businesses" description="Clear business websites for small businesses, with optional editing and selected custom software when needed.">
  <div class="min-h-screen flex flex-col">
    <Header />

    <main class="flex-1">
      <!-- ============ HERO ============ -->
      <section class="bg-abyss relative overflow-hidden pt-36 pb-16 lg:pt-44 lg:pb-24">
        <Halftone />
        <div class="relative z-10 mx-auto max-w-7xl px-6">
          <div class="grid items-center gap-14 lg:grid-cols-12">
            <div class="lg:col-span-7">
              <div class="flex items-center gap-4">
                <p class="font-mono text-[11px] font-bold uppercase tracking-[0.22em] text-slate-400">
                  <span class="mr-2 inline-block h-1.5 w-1.5 rounded-full bg-ember"></span>Business websites — UK based
                </p>
                <span class="h-px flex-1 bg-gradient-to-r from-white/20 to-transparent" aria-hidden="true"></span>
                <p class="hidden font-mono text-[11px] font-medium uppercase tracking-[0.22em] text-slate-500 sm:block">EST. 2025</p>
              </div>

              <h1 class="text-balance mt-7 font-display text-5xl font-bold leading-[1.02] tracking-tight text-bone sm:text-6xl lg:text-7xl">
                <span class="block">Websites that help</span>
                <span class="block">small businesses</span>
                <span class="gradient-text-fruity block pb-2">look credible.</span>
              </h1>

              <p class="mt-6 max-w-xl text-lg leading-relaxed text-slate-300">
                I build clear, fast websites that explain what you do, what it costs, and how people can get in touch.
              </p>

              <div class="mt-9 flex flex-wrap items-center gap-4">
                <Button href="/pricing" size="lg">See Pricing</Button>
                <Button href="/custom-software" variant="secondary" size="lg" arrow={false}>Need Something More Custom?</Button>
              </div>

              <div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-4">
                <div class="flex items-center gap-2 text-sm font-semibold text-slate-300">
                  <UserRound className="h-4 w-4 text-emerald-400" />
                  Direct with the builder
                </div>
                <div class="hidden h-10 w-px bg-gradient-to-b from-transparent via-white/20 to-transparent sm:block"></div>
                <div class="flex items-center gap-2 text-sm font-semibold text-slate-300">
                  <ShieldCheck className="h-4 w-4 text-emerald-400" />
                  Fixed price from <span class="text-white" data-price-gbp="599">£599</span> · no surprises
                </div>
              </div>
            </div>

            <!-- Browser mock -->
            <div class="lg:col-span-5">
              <div class="relative">
                <div class="absolute -inset-6 rounded-[2rem] bg-gradient-to-br from-[#ff4d5d]/20 via-[#ff8a3d]/10 to-white/5 blur-2xl" aria-hidden="true"></div>
                <div class="browser-glow relative overflow-hidden rounded-3xl border border-white/15 bg-[#0a0a20]/95 backdrop-blur-xl">
                  <div class="flex items-center gap-2 border-b border-white/10 bg-white/[0.04] px-5 py-3.5">
                    <span class="h-2.5 w-2.5 rounded-full bg-rose-400/90"></span>
                    <span class="h-2.5 w-2.5 rounded-full bg-amber-400/90"></span>
                    <span class="h-2.5 w-2.5 rounded-full bg-emerald-400/90"></span>
                    <span class="ml-3 hidden flex-1 items-center gap-2 rounded-full bg-white/[0.06] px-4 py-1.5 text-[11px] font-medium text-slate-300 sm:flex">
                      <BadgeCheck className="h-3 w-3 text-emerald-400" /> northsideplumbing.co.uk
                    </span>
                    <span class="ml-auto inline-flex items-center gap-1.5 rounded-full border border-emerald-400/30 bg-emerald-400/10 px-3 py-1 text-[10px] font-bold uppercase tracking-widest text-emerald-300">
                      <span class="live-badge inline-block h-1.5 w-1.5 rounded-full bg-emerald-400"></span> Live
                    </span>
                  </div>

                  <HeroSiteMock />

                  <div class="flex items-center justify-between gap-3 border-t border-white/10 bg-white/[0.03] px-5 py-4 backdrop-blur">
                    <div class="flex items-center gap-3">
                      <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-gradient-to-br from-[#ff4d5d] to-[#ff7a3d] text-white">
                        <Gauge className="h-4 w-4" />
                      </span>
                      <div>
                        <p class="text-xs font-bold text-white">98 / 100 performance</p>
                        <p class="text-[11px] text-slate-400">Loads in under a second</p>
                      </div>
                    </div>
                    <div class="flex items-center gap-1 rounded-full border border-[#ff4d5d]/25 bg-[#ff4d5d]/10 px-3 py-1.5 text-[11px] font-bold text-[#ff8a9d]">
                      Fast
                    </div>
                  </div>
                </div>
              </div>
              <p class="mt-6 text-center font-mono text-[11px] uppercase tracking-[0.2em] text-slate-500">Fig. 01 — Example business site</p>
            </div>
          </div>
        </div>

        <!-- Stack strip -->
        <div class="relative z-10 mx-auto mt-16 max-w-7xl px-6">
          <div class="overflow-hidden rounded-2xl border border-white/10 bg-white/5 py-4 backdrop-blur">
            <div class="flex flex-wrap items-center justify-center gap-x-8 gap-y-3 px-6">
              {stack.map((tech) => (
                <span class="flex shrink-0 items-center gap-2.5 text-xs font-bold uppercase tracking-widest text-slate-400">
                  <span class="h-1.5 w-1.5 rounded-full bg-gradient-to-r from-[#ff4d6d] to-[#ff8a3d]"></span>
                  {tech}
                </span>
              ))}
            </div>
          </div>
        </div>

        <div class="hero-fade" aria-hidden="true" />
      </section>

      <!-- ============ SPEC BAR ============ -->
      <section class="relative border-y border-white/[0.08] bg-white/[0.015]">
        <div class="mx-auto max-w-7xl px-6 py-7">
          <div class="flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between sm:gap-6">
            <div class="flex items-center gap-3">
              <span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-white/10 bg-white/5 text-slate-300">
                <Wallet className="h-4 w-4" />
              </span>
              <div>
                <p class="font-mono text-[10px] font-bold uppercase tracking-[0.2em] text-slate-400">Starting price</p>
                <p class="font-display text-lg font-bold tracking-tight text-white">
                  <span data-price-gbp="599">£599</span> <span class="text-sm font-semibold text-slate-400">upfront</span>
                </p>
              </div>
            </div>
            <span class="hidden h-10 w-px bg-white/10 sm:block" aria-hidden="true"></span>
            <div class="flex items-center gap-3">
              <span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-white/10 bg-white/5 text-slate-300">
                <Timer className="h-4 w-4" />
              </span>
              <div>
                <p class="font-mono text-[10px] font-bold uppercase tracking-[0.2em] text-slate-400">Typical build</p>
                <p class="font-display text-lg font-bold tracking-tight text-white">
                  1–3 <span class="text-sm font-semibold text-slate-400">weeks</span>
                </p>
              </div>
            </div>
            <span class="hidden h-10 w-px bg-white/10 sm:block" aria-hidden="true"></span>
            <div class="flex items-center gap-3">
              <span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-white/10 bg-white/5 text-slate-300">
                <ShieldCheck className="h-4 w-4" />
              </span>
              <div>
                <p class="font-mono text-[10px] font-bold uppercase tracking-[0.2em] text-slate-400">Ongoing care</p>
                <p class="font-display text-lg font-bold tracking-tight text-white">
                  <span data-currency-gbp="25" data-currency-suffix="/mo">£25/mo</span> <span class="text-sm font-semibold text-slate-400">hosting &amp; upkeep</span>
                </p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ============ OFFERS ============ -->
      <section class="relative mx-auto max-w-7xl px-6 py-20 lg:py-24">
        <SectionHeading eyebrow="What I offer">
          <span slot="title">One clear core offer,<br class="hidden sm:block" /> <span class="text-ember">zero confusion.</span></span>
          Most businesses need a straightforward website first. Editing is optional, and custom software only comes into the picture when a normal website is not enough.
        </SectionHeading>

        <div class="overflow-hidden rounded-3xl border border-white/10 bg-white/[0.02]">
          {offers.map((offer) => (
            <a
              href={offer.href}
              class="group grid gap-3 border-b border-white/[0.07] p-6 transition-colors duration-300 last:border-b-0 hover:bg-white/[0.04] sm:grid-cols-[3rem_1.2fr_1fr_auto] sm:items-center sm:gap-8 sm:px-10 sm:py-7"
            >
              <span class="font-display text-sm font-bold tracking-widest text-white/40 transition-colors duration-300 group-hover:text-ember">{offer.num}</span>
              <div>
                <h3 class="font-display text-xl font-bold tracking-tight text-white sm:text-2xl">{offer.title}</h3>
                <p class="mt-1.5 text-sm font-semibold text-[#ff8a9d]">
                  {offer.num === "01" && <span data-currency-gbp="599" data-currency-suffix=" upfront">{offer.price}</span>}
                  {offer.num === "02" && <span data-currency-gbp="800" data-currency-prefix="From +">{offer.price}</span>}
                  {offer.num === "03" && <span>{offer.price}</span>}
                </p>
              </div>
              <p class="max-w-md text-sm leading-relaxed text-slate-400">{offer.desc}</p>
              <span class="flex h-11 w-11 items-center justify-center rounded-full border border-white/20 text-slate-200 transition-colors duration-300 group-hover:border-white group-hover:bg-white group-hover:text-slate-900">
                <ArrowRight className="h-4 w-4" />
              </span>
            </a>
          ))}
        </div>
      </section>

      <!-- ============ WORK ============ -->
      <section class="relative overflow-hidden py-20 lg:py-24">
        <div class="relative mx-auto max-w-7xl px-6">
          <div class="mb-12 flex flex-wrap items-end justify-between gap-6">
            <div>
              <Eyebrow>Selected work</Eyebrow>
              <h2 class="mt-5 font-display text-4xl font-bold tracking-tight text-white sm:text-5xl">Recent work<span class="text-ember">.</span></h2>
            </div>
            <a href="/portfolio" class="link-underline hidden items-center gap-2 text-sm font-bold text-slate-300 hover:text-white sm:inline-flex">
              View All Projects <ArrowUpRight className="h-4 w-4" />
            </a>
          </div>

          <div class="grid gap-6 md:grid-cols-2">
            {projects.map((project) => (
              <a href={project.url} target="_blank" rel="noopener noreferrer" class="card-lift group block overflow-hidden rounded-3xl border border-white/10 bg-white/[0.02]">
                <div class="relative overflow-hidden">
                  <img src={project.image} alt={project.title} class="aspect-[16/10] w-full object-cover" loading="lazy" />
                  <div class="absolute inset-0 bg-gradient-to-t from-[#050512]/60 via-transparent to-transparent"></div>
                  <span class="glass absolute left-4 top-4 rounded-full px-4 py-1.5 text-[11px] font-bold uppercase tracking-widest text-slate-200">{project.category}</span>
                  <span class="absolute bottom-4 right-4 flex h-12 w-12 items-center justify-center rounded-full bg-white text-slate-900 opacity-0 shadow-xl transition-opacity duration-300 group-hover:opacity-100">
                    <ArrowUpRight className="h-5 w-5" />
                  </span>
                </div>
                <div class="p-7">
                  <h3 class="font-display text-2xl font-bold tracking-tight text-white">{project.title}</h3>
                  <p class="mt-2 text-sm leading-relaxed text-slate-400">{project.blurb}</p>
                  <p class="mt-4 text-[11px] font-bold uppercase tracking-[0.18em] text-slate-400">{project.role} / {project.year}</p>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>

      <!-- ============ WHY ============ -->
      <section class="mx-auto max-w-7xl px-6 py-20 lg:py-24">
        <div class="grid items-start gap-12 lg:grid-cols-2">
          <div class="lg:sticky lg:top-32">
            <Eyebrow>Why Staticfish</Eyebrow>
            <h2 class="mt-5 font-display text-4xl font-bold tracking-tight text-white sm:text-5xl">
              Clear scope.<br />Clear price.<br />
              <span class="text-ember">No games.</span>
            </h2>
            <p class="mt-5 max-w-lg text-lg leading-relaxed text-slate-400">
              You work directly with me. The offer is simple, the scope is agreed up front, and there is no pressure to buy things you do not need.
            </p>
            <Button href="/about" variant="secondary" class="mt-8">Meet the builder</Button>
          </div>

          <div class="grid gap-10 sm:grid-cols-1 sm:gap-0 sm:divide-y sm:divide-white/10">
            {whyPoints.map((item) => (
              <div class="sm:py-8 sm:first:pt-0 sm:last:pb-0">
                <p class="font-display text-sm font-bold tracking-widest text-[#ff4d5d]">{item.num}</p>
                <h3 class="mt-2 font-display text-lg font-bold tracking-tight text-white">{item.title}</h3>
                <p class="mt-1.5 max-w-md text-sm leading-relaxed text-slate-400">{item.desc}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- ============ CTA ============ -->
      <section class="mx-auto max-w-7xl px-6 pb-20 lg:pb-24">
        <div class="dark-panel relative overflow-hidden rounded-[2rem] px-8 py-16 text-center sm:px-14 lg:py-20">
          <Halftone
            clusters={[
              { top: "-15%", left: "-8%", width: "22rem", height: "18rem", color: "rgba(255,77,109,0.5)", opacity: 0.7 },
              { bottom: "-20%", right: "-5%", width: "24rem", height: "18rem", color: "rgba(255,200,140,0.4)", opacity: 0.6 },
            ]}
          />
          <div class="relative">
            <Eyebrow class="mx-auto w-fit">Next step</Eyebrow>
            <h2 class="text-balance mx-auto mt-7 max-w-3xl font-display text-4xl font-bold tracking-tight text-white sm:text-5xl lg:text-6xl">
              Need a website that explains the business <span class="serif-accent font-normal gradient-text-ember">properly?</span>
            </h2>
            <p class="mx-auto mt-6 max-w-xl text-lg leading-relaxed text-slate-300">
              Get in touch for a clear quote and an honest recommendation on whether you need a straightforward website, an editing add-on, or something more bespoke.
            </p>
            <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
              <Button href="/contact" size="lg">Get a Quote</Button>
              <Button href="/custom-software" variant="secondary" size="lg" arrow={false}>Custom Software</Button>
            </div>
            <p class="mt-8 text-sm text-slate-400">
              Typical response within 24 hours · <span class="text-slate-200">contact@staticfish.co.uk</span>
            </p>
          </div>
        </div>
      </section>
    </main>

    <Footer />
  </div>
</Layout>
