---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import Reveal from '../components/effects/Reveal.astro';
import Spotlight from '../components/effects/Spotlight';
import TiltCard from '../components/effects/TiltCard';
import { ArrowUpRight, Clock, Mail } from 'lucide-react';

const includeSteps = [
  { num: "1", title: "Your Business", desc: "What do you do? Who are your customers?" },
  { num: "2", title: "What You Need", desc: "A business website, an editable site, or something more custom?" },
  { num: "3", title: "Timeline", desc: "When do you need it launched?" },
  { num: "4", title: "Budget", desc: "What budget range are you working with? It helps me suggest the right scope." },
];
---

<Layout title="Contact | Staticfish" description="Get in touch with Staticfish about a business website or custom software project.">
  <div class="min-h-screen flex flex-col">
    <Header />

    <main class="flex-1">
      <PageHero eyebrow="Contact">
        <span slot="title">Let's <span class="gradient-text-animated">talk.</span></span>
        Need a business website, an editable site, or a more custom software project? Send me an email and I'll respond within 24 hours.
      </PageHero>

      <section class="mx-auto max-w-7xl px-6 pb-24 lg:pb-32">
        <div class="grid items-start gap-8 lg:grid-cols-2">
          <Reveal variant="left">
            <TiltCard client:load max={5}>
              <div class="dark-panel noise-overlay relative overflow-hidden rounded-[2rem] p-10 text-center lg:p-14">
                <div class="dot-pattern-light absolute inset-0 opacity-40" style="mask-image: radial-gradient(ellipse 70% 60% at 50% 40%, black 20%, transparent 75%); -webkit-mask-image: radial-gradient(ellipse 70% 60% at 50% 40%, black 20%, transparent 75%);" aria-hidden="true"></div>
                <div class="relative">
                  <span class="mx-auto flex h-16 w-16 items-center justify-center rounded-3xl text-white shadow-2xl shadow-indigo-500/40" style="background: linear-gradient(135deg, #4f46e5, #7c3aed 55%, #06b6d4 130%)">
                    <Mail className="h-7 w-7" />
                  </span>
                  <h2 class="mt-6 font-display text-2xl font-bold tracking-tight text-white">Send an Email</h2>
                  <p class="mt-1 text-sm text-slate-400">The best way to reach me</p>
                  <a
                    href="mailto:contact@staticfish.co.uk"
                    class="mt-7 block break-all font-display text-2xl font-bold tracking-tight text-white transition-colors duration-300 hover:text-cyan-300 sm:text-3xl"
                  >
                    contact@staticfish.co.uk
                  </a>
                  <div class="mx-auto mt-8 flex w-fit items-center gap-2.5 rounded-full border border-white/15 bg-white/5 px-5 py-2.5 text-sm text-slate-300 backdrop-blur">
                    <Clock className="h-4 w-4 text-emerald-400" />
                    Typical response: Within 24 hours
                  </div>
                  <a href="mailto:contact@staticfish.co.uk?subject=Project%20enquiry%20—%20Staticfish" class="btn-primary-glow group mt-8 inline-flex items-center gap-2 rounded-full px-9 py-4 text-sm font-bold text-white">
                    <span class="relative z-[2] flex items-center gap-2">Compose Email <ArrowUpRight className="h-4 w-4 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" /></span>
                  </a>
                </div>
              </div>
            </TiltCard>
          </Reveal>

          <div>
            <Reveal delay={110}>
              <Spotlight client:load className="card-lift rounded-[2rem] border border-indigo-100/70 bg-white/85 p-8 backdrop-blur lg:p-10">
                <h3 class="font-display text-xl font-bold tracking-tight">What to include</h3>
                <p class="mt-1.5 text-sm text-slate-500">Four quick things = a faster, sharper quote.</p>
                <div class="mt-7 space-y-4">
                  {includeSteps.map((item, i) => (
                    <div class="group flex items-start gap-4 rounded-2xl border border-transparent p-4 transition-all duration-300 hover:border-indigo-100 hover:bg-indigo-50/50" data-reveal style={`--reveal-delay: ${i * 80}ms`}>
                      <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-2xl bg-slate-900 font-display text-sm font-bold text-white transition-all duration-300 group-hover:bg-gradient-to-br group-hover:from-indigo-600 group-hover:to-violet-600">
                        {item.num}
                      </span>
                      <div>
                        <p class="font-bold text-slate-800">{item.title}</p>
                        <p class="mt-0.5 text-sm text-slate-500">{item.desc}</p>
                      </div>
                    </div>
                  ))}
                </div>
                <div class="relative mt-7 overflow-hidden rounded-2xl bg-gradient-to-br from-indigo-600 via-violet-600 to-indigo-700 p-6">
                  <div class="dot-pattern-light absolute inset-0 opacity-30" aria-hidden="true"></div>
                  <p class="relative text-sm leading-relaxed text-indigo-50">
                    <strong class="text-white">Not sure which route fits?</strong> That's okay. Tell me about the business problem first and I'll help you decide whether you need a website or something more custom.
                  </p>
                </div>
              </Spotlight>
            </Reveal>
          </div>
        </div>
      </section>
    </main>
    <Footer />
  </div>
</Layout>
