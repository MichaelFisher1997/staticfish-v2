---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { Button } from '../components/ui/button';
import {
  Zap,
  Shield,
  DollarSign,
  Clock,
  Target,
  Code,
  ArrowRight,
} from 'lucide-react';
import { WaveBackground, FlowingLines, CornerWaves } from '../components/WaveArt';
import { GeometricArt, FloatingShapes } from '../components/GeometricArt';

const values = [
  {
    icon: Zap,
    title: "Built for Speed",
    description:
      "Every site I build loads fast. I focus on performance because your visitors won't wait around."
  },
  {
    icon: Shield,
    title: "Simple & Reliable",
    description:
      "I use modern tools with fewer moving parts. Less to go wrong means less to worry about."
  },
  {
    icon: DollarSign,
    title: "Clear Pricing",
    description:
      "One price upfront. Set monthly fee. No hourly billing, no surprise charges."
  }
];

const expertise = [
  "Business websites",
  "SaaS MVPs",
  "Founder handoff builds",
  "Managed product builds",
  "Editable content setups",
  "Performance & SEO"
];

const milestones = [
  {
    year: "2025",
    title: "Staticfish Founded",
    description:
      "Started with a simple idea: help small businesses get online without paying agency prices or wrestling with complex systems."
  },
  {
    year: "2026",
    title: "Chattybox Launch",
    description:
      "Built and launched a more complex SaaS product, demonstrating that I can handle custom software work when a project needs more than a standard website."
  },
  {
    year: "2026",
    title: "Redot Engine Website",
    description:
      "Contributed a new website for Redot, an open-source game engine. Pro bono work to support the developer community."
  }
];
---

<Layout title="About Staticfish | Solo Developer for Small Businesses" description="Meet Michael Fisher, the solo developer behind Staticfish. I build straightforward business websites and selected custom software projects.">
  <div class="min-h-screen flex flex-col bg-background">
    <Header />
    
    <main class="flex-1">
      
      <!-- Header -->
      <section class="pt-32 pb-20 lg:pb-32 relative overflow-hidden">
        <FlowingLines count={8} />
        <CornerWaves position="bottom-right" />
        <div class="container mx-auto max-w-7xl px-6 relative z-10">
          <div class="max-w-3xl">
            <p class="text-sm font-medium text-muted-foreground uppercase tracking-widest mb-6">About</p>
            <h1 class="text-5xl sm:text-6xl lg:text-7xl font-bold text-foreground font-display tracking-tighter mb-8">
              One Person.
              <br/>
              <span class="text-accent">Real Craftsmanship.</span>
            </h1>
            <p class="text-lg sm:text-xl text-muted-foreground leading-relaxed">
              I'm Michael Fisher, the solo developer behind Staticfish. No account managers, no junior developers—just me building your website with care and attention.
            </p>
          </div>
        </div>
      </section>

      <div class="container mx-auto max-w-7xl px-6 space-y-20 lg:space-y-32">
        
        <!-- Mission Section -->
        <section class="border-t border-border pt-20 relative overflow-hidden">
          <GeometricArt variant="circles" />
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center relative z-10">
            <div>
              <p class="text-sm font-medium text-muted-foreground uppercase tracking-widest mb-6">Why I Started</p>
              <h2 class="text-3xl sm:text-4xl font-bold text-foreground font-display tracking-tight mb-8">
                A Better Way to Build
              </h2>
              <div class="space-y-6 text-muted-foreground leading-relaxed">
                <p>
                  I've seen too many small businesses overpay for websites that are slow, hard to update, and expensive to maintain. They get locked into contracts for things they don't need.
                </p>
                <p>
                  I started Staticfish to offer something simpler: clear business websites, clear pricing, and direct communication with the person building the work. Alongside that, I also build SaaS MVPs for founders who need a real first product.
                </p>
              </div>
            </div>
            <div class="aspect-square bg-secondary/30 border border-border flex items-center justify-center">
              <Target className="w-24 h-24 lg:w-32 lg:h-32 text-accent/60" />
            </div>
          </div>
        </section>

        <!-- My Values -->
        <section class="border-t border-border pt-20 relative overflow-hidden">
          <FloatingShapes />
          <div class="relative z-10">
          <p class="text-sm font-medium text-muted-foreground uppercase tracking-widest mb-6">How I Work</p>
          <h2 class="text-4xl sm:text-5xl font-bold text-foreground font-display tracking-tighter mb-16">
            My Principles.
          </h2>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-border">
            {values.map((value) => (
              <div class="bg-background p-8 lg:p-10 hover:bg-secondary/20 transition-colors relative overflow-hidden">
                <div class="deco-dots absolute inset-0"></div>
                <div class="w-12 h-12 bg-accent/10 flex items-center justify-center mb-6 text-accent">
                  <value.icon className="h-6 w-6" />
                </div>
                <h3 class="text-xl font-bold text-foreground font-display mb-3">{value.title}</h3>
                <p class="text-muted-foreground leading-relaxed text-sm">
                  {value.description}
                </p>
              </div>
            ))}
          </div>
        </section>

        <!-- About Me -->
        <section class="border-t border-border pt-20">
          <div class="border border-border p-8 lg:p-12 flex flex-col md:flex-row gap-8 lg:gap-12 items-center">
            <div class="w-28 h-28 lg:w-32 lg:h-32 bg-accent/10 flex items-center justify-center text-accent text-4xl lg:text-5xl font-bold font-display shrink-0">
              M
            </div>
            
            <div class="flex-1 text-center md:text-left">
              <div class="mb-4">
                <h3 class="text-2xl lg:text-3xl font-bold text-foreground font-display tracking-tight">
                  Michael Fisher
                </h3>
                <p class="text-accent font-bold text-xs uppercase tracking-widest mt-1">Founder & Developer</p>
              </div>
              
              <p class="text-muted-foreground leading-relaxed mb-6">
                I've spent years building everything from straightforward websites to SaaS products and more involved software builds.
                Staticfish is positioned mainly around business websites, but SaaS MVP work is still a real specialism for me when the right project comes along.
              </p>

              <div class="flex flex-wrap gap-2 justify-center md:justify-start mb-6">
                {expertise.map((skill) => (
                  <span class="text-xs bg-secondary text-muted-foreground px-3 py-1.5 font-semibold uppercase tracking-wide">
                    {skill}
                  </span>
                ))}
              </div>
              
              <div class="flex gap-6 justify-center md:justify-start text-sm text-muted-foreground">
                <div class="flex items-center gap-2">
                  <Clock className="h-4 w-4 text-accent" />
                  <span>UK Based</span>
                </div>
                <div class="flex items-center gap-2">
                  <Code className="h-4 w-4 text-accent" />
                  <span>5+ Years</span>
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- Timeline -->
        <section class="border-t border-border pt-20 relative overflow-hidden">
          <GeometricArt variant="lines" />
          <div class="relative z-10">
          <p class="text-sm font-medium text-muted-foreground uppercase tracking-widest mb-6">The Journey</p>
          <h2 class="text-4xl sm:text-5xl font-bold text-foreground font-display tracking-tighter mb-16">
            So Far.
          </h2>

          <div class="border-t border-border">
            {milestones.map((milestone) => (
              <div class="border-b border-border py-10">
                <div class="grid grid-cols-12 gap-6 items-start">
                  <div class="col-span-12 sm:col-span-2">
                    <span class="text-2xl font-bold text-accent font-display tracking-tighter">
                      {milestone.year}
                    </span>
                  </div>
                  <div class="col-span-12 sm:col-span-4">
                    <h3 class="text-lg font-bold text-foreground font-display uppercase tracking-tight">
                      {milestone.title}
                    </h3>
                  </div>
                  <div class="col-span-12 sm:col-span-6">
                    <p class="text-muted-foreground leading-relaxed text-sm">
                      {milestone.description}
                    </p>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </section>

        <!-- CTA -->
        <section class="border-t border-border pt-20 pb-20 relative overflow-hidden">
          <WaveBackground variant="teal" opacity={0.12} />
          <div class="bg-foreground text-background p-12 lg:p-20 text-center corner-bracket relative z-10">
            <p class="text-sm font-medium text-background/60 uppercase tracking-widest mb-6">Ready?</p>
            <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold font-display tracking-tighter mb-6 text-background">
              Let's Work
              <span class="text-accent">Together.</span>
            </h2>
            <p class="text-lg text-background/70 mb-10 max-w-lg mx-auto">
              If you need a business website, or you have a more specific software problem to solve, I'd love to hear about it.
            </p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center">
              <Button className="rounded-none h-12 px-8 font-semibold bg-accent hover:bg-accent/90 text-white">
                <a href="/contact" class="flex items-center gap-2">
                  Start Your Project <ArrowRight className="h-4 w-4" />
                </a>
              </Button>
              <Button variant="outline" className="rounded-none h-12 px-8 border-background/20 text-background hover:bg-background/10">
                <a href="/portfolio">See My Work</a>
              </Button>
            </div>
          </div>
        </section>

      </div>
    </main>
    <Footer />
  </div>
</Layout>
