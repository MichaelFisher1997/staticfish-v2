---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Halftone from '../components/effects/Halftone.astro';
---

<Layout title="Privacy Policy | Staticfish" description="Privacy Policy for Staticfish web development services.">
  <div class="min-h-screen flex flex-col">
    <Header />

    <main class="flex-1">
      <section class="bg-abyss noise-overlay relative overflow-hidden pt-36 pb-12 lg:pt-44">
        <Halftone />
        <div class="relative z-10 mx-auto max-w-4xl px-6">
          <div>
            <span class="eyebrow-pill eyebrow-pill-dark">
              <span class="eyebrow-dot" style="background: linear-gradient(135deg, #2f2fe4, #2f2fe4); box-shadow: 0 0 12px rgba(47, 47, 228,0.9);"></span>
              Legal
            </span>
          </div>
          <h1 class="mt-7 font-display text-5xl font-bold tracking-tight text-bone sm:text-6xl">
            Privacy <span class="gradient-text-bright">Policy</span>
          </h1>
          <p class="mt-4 inline-flex items-center gap-2 rounded-full border border-bone/15 bg-bone/5 px-4 py-1.5 text-sm font-semibold text-slate-300 backdrop-blur">
            Last updated: April 2026
          </p>
        </div>
        <div class="hero-fade" aria-hidden="true" />
      </section>

      <div class="mx-auto max-w-4xl px-6 py-16">
        <div class="rounded-[2rem] border border-bone/10 bg-bone/[0.03] p-8 backdrop-blur sm:p-12">
          <div class="space-y-10 leading-relaxed text-slate-300">
            <div>
              <h2 class="mb-4 font-display text-2xl font-bold tracking-tight text-bone">Introduction</h2>
              <p>
                Staticfish ("I", "me", "my") is committed to protecting your privacy. This Privacy Policy explains how I collect, use, and safeguard your information when you visit my website or use my services.
              </p>
            </div>

            <div>
              <h2 class="mb-4 font-display text-2xl font-bold tracking-tight text-bone">Information I Collect</h2>
              <p class="mb-3"><strong class="text-bone">Information you provide:</strong></p>
              <ul class="mb-5 list-disc space-y-2 pl-6">
                <li>Name and contact information (email, phone)</li>
                <li>Business information</li>
                <li>Project requirements and specifications</li>
                <li>Payment information (processed securely via Stripe)</li>
              </ul>
              <p class="mb-3"><strong class="text-bone">Automatically collected information:</strong></p>
              <ul class="list-disc space-y-2 pl-6">
                <li>IP address</li>
                <li>Browser type and version</li>
                <li>Pages visited and time spent</li>
                <li>Referring website</li>
              </ul>
            </div>

            <div>
              <h2 class="mb-4 font-display text-2xl font-bold tracking-tight text-bone">How I Use Your Information</h2>
              <ul class="list-disc space-y-2 pl-6">
                <li>To provide and maintain my services</li>
                <li>To communicate with you about your project</li>
                <li>To process payments</li>
                <li>To improve my website and services</li>
                <li>To comply with legal obligations</li>
              </ul>
            </div>

            <div>
              <h2 class="mb-4 font-display text-2xl font-bold tracking-tight text-bone">Data Storage and Security</h2>
              <p>
                I take data security seriously. Your information is stored securely using industry-standard encryption and security measures. I use Cloudflare for website security and Stripe for secure payment processing. I never store your credit card information.
              </p>
            </div>

            <div>
              <h2 class="mb-4 font-display text-2xl font-bold tracking-tight text-bone">Third-Party Services</h2>
              <p class="mb-3">I use the following third-party services:</p>
              <ul class="mb-5 list-disc space-y-2 pl-6">
                <li><strong class="text-bone">Cloudflare</strong> - Website hosting and security</li>
                <li><strong class="text-bone">Stripe</strong> - Payment processing</li>
                <li><strong class="text-bone">Email service providers</strong> - Communication</li>
              </ul>
              <p>
                These services have their own privacy policies and may collect data according to their terms.
              </p>
            </div>

            <div>
              <h2 class="mb-4 font-display text-2xl font-bold tracking-tight text-bone">Cookies</h2>
              <p>
                My website uses minimal cookies for essential functionality and analytics. You can control cookie settings through your browser.
              </p>
            </div>

            <div>
              <h2 class="mb-4 font-display text-2xl font-bold tracking-tight text-bone">Your Rights</h2>
              <p class="mb-3">Under GDPR and UK data protection laws, you have the right to:</p>
              <ul class="mb-5 list-disc space-y-2 pl-6">
                <li>Access your personal data</li>
                <li>Correct inaccurate data</li>
                <li>Request deletion of your data</li>
                <li>Object to data processing</li>
                <li>Request data portability</li>
              </ul>
              <p>
                To exercise these rights, email me at contact@staticfish.co.uk
              </p>
            </div>

            <div>
              <h2 class="mb-4 font-display text-2xl font-bold tracking-tight text-bone">Data Retention</h2>
              <p>
                I retain your information for as long as necessary to provide services and comply with legal obligations. Project-related data is typically retained for 2 years after project completion.
              </p>
            </div>

            <div>
              <h2 class="mb-4 font-display text-2xl font-bold tracking-tight text-bone">Changes to This Policy</h2>
              <p>
                I may update this Privacy Policy from time to time. I will notify you of any significant changes by email or through a notice on my website.
              </p>
            </div>

            <div>
              <h2 class="mb-4 font-display text-2xl font-bold tracking-tight text-bone">Contact Me</h2>
              <p class="mb-5">
                If you have any questions about this Privacy Policy or how I handle your data, please contact me:
              </p>
              <div class="gradient-border p-6">
                <p class="mb-2 font-bold text-bone">Staticfish</p>
                <p class="mb-1">Email: contact@staticfish.co.uk</p>
                <p>Data Controller: Michael Fisher</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </main>
    <Footer />
  </div>
</Layout>
