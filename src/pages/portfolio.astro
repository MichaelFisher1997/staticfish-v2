---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import CtaPanel from '../components/CtaPanel.astro';
import Reveal from '../components/effects/Reveal.astro';
import TiltCard from '../components/effects/TiltCard';
import { ArrowRight, ArrowUpRight, Hourglass } from 'lucide-react';

const projects = [
  {
    title: "Redot Engine",
    description: "A large content-heavy website for an open-source community. It shows how I approach structure, clarity, and front-end build quality.",
    image: "/portfolio-redot.png",
    category: "Open Source",
    url: "https://www.redotengine.org/",
    role: "Structure + frontend",
    year: "2026",
    tags: ["Astro", "Documentation", "Community"]
  },
  {
    title: "Chattybox AI",
    description: "A more involved SaaS product that shows I can take on deeper custom software work when a project needs more than a brochure website.",
    image: "/portfolio-chattybox.png",
    category: "SaaS Product",
    url: "https://chattybox.ai/",
    role: "Product build",
    year: "2026",
    tags: ["React", "Python", "Custom App"]
  }
];
---

<Layout title="Portfolio | Staticfish" description="A small selection of recent work that shows the quality and range behind Staticfish.">
  <div class="min-h-screen flex flex-col">
    <Header />

    <main class="flex-1">
      <PageHero eyebrow="Portfolio">
        <span slot="title">Recent <span class="gradient-text-animated">projects.</span></span>
        A small selection of projects that shows the standard of design and build quality I bring to client work.
      </PageHero>

      <section class="mx-auto max-w-7xl px-6 pb-24">
        <div class="space-y-8">
          {projects.map((item, i) => (
            <Reveal variant="scale" delay={i * 80}>
              <TiltCard client:load max={3}>
                <div class="card-lift group grid overflow-hidden rounded-[2rem] border border-white/70 bg-white shadow-xl shadow-indigo-500/10 lg:grid-cols-2">
                  <div class="relative overflow-hidden p-4 sm:p-5">
                    <img
                      src={item.image}
                      alt={item.title}
                      class="aspect-[16/10] h-full w-full rounded-3xl object-cover transition-transform duration-700 ease-out group-hover:scale-[1.04]"
                      loading="lazy"
                    />
                    <span class="glass absolute left-8 top-8 rounded-full px-4 py-1.5 text-[11px] font-bold uppercase tracking-widest text-indigo-700">
                      {item.category}
                    </span>
                  </div>
                  <div class="flex flex-col justify-center p-8 lg:p-12">
                    <p class="text-[11px] font-bold uppercase tracking-[0.2em] text-slate-400">
                      {item.role} / {item.year}
                    </p>
                    <h2 class="mt-3 font-display text-3xl font-bold tracking-tight lg:text-4xl">
                      {item.title}
                    </h2>
                    <p class="mt-4 max-w-lg leading-relaxed text-slate-600">
                      {item.description}
                    </p>
                    <div class="mt-6 flex flex-wrap gap-2">
                      {item.tags.map(tag => (
                        <span class="rounded-full border border-indigo-100 bg-indigo-50/60 px-4 py-1.5 text-xs font-bold text-indigo-700">
                          {tag}
                        </span>
                      ))}
                    </div>
                    <div class="mt-8">
                      <a href={item.url} target="_blank" rel="noopener noreferrer" class="btn-primary-glow group/btn inline-flex w-fit items-center gap-2 rounded-full px-7 py-3.5 text-sm font-bold text-white">
                        <span class="relative z-[2] flex items-center gap-2">View Live Site <ArrowUpRight className="h-4 w-4 transition-transform duration-300 group-hover/btn:translate-x-0.5 group-hover/btn:-translate-y-0.5" /></span>
                      </a>
                    </div>
                  </div>
                </div>
              </TiltCard>
            </Reveal>
          ))}
        </div>

        <Reveal variant="scale" delay={100}>
          <div class="glass relative mx-auto mt-12 max-w-2xl overflow-hidden rounded-[2rem] p-10 text-center lg:p-12">
            <div class="absolute -left-16 -top-16 h-48 w-48 rounded-full bg-gradient-to-br from-indigo-400/25 to-cyan-400/25 blur-3xl" aria-hidden="true"></div>
            <div class="absolute -bottom-16 -right-16 h-48 w-48 rounded-full bg-gradient-to-br from-violet-400/25 to-fuchsia-400/25 blur-3xl" aria-hidden="true"></div>
            <span class="relative mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-gradient-to-br from-indigo-500 to-cyan-500 text-white shadow-lg">
              <Hourglass className="h-6 w-6" />
            </span>
            <h3 class="relative mt-5 font-display text-2xl font-bold tracking-tight">More Coming Soon</h3>
            <p class="relative mx-auto mt-2 max-w-md leading-relaxed text-slate-600">
              As more client work is ready to share publicly, I'll add it here.
            </p>
            <a href="/contact" class="btn-ghost-glass group relative mt-7 inline-flex items-center gap-2 rounded-full px-7 py-3.5 text-sm font-bold text-slate-800">
              Start Your Project <ArrowRight className="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" />
            </a>
          </div>
        </Reveal>
      </section>

      <CtaPanel
        eyebrow="Next project"
        title="Want to see your"
        highlight="project here?"
        description="If you want this level of care on your website or a more custom project, let's talk."
        primary={{ href: "/contact", label: "Let's Talk" }}
      />
    </main>
    <Footer />
  </div>
</Layout>
