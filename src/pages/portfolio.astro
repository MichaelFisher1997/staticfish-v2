---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import CtaPanel from '../components/CtaPanel.astro';
import Card from '../components/ui/Card.astro';
import Chip from '../components/ui/Chip.astro';
import Button from '../components/ui/Button.astro';
import { ArrowUpRight } from 'lucide-react';

const projects = [
  {
    title: "Redot Engine",
    description: "A large content-heavy website for an open-source community. It shows how I approach structure, clarity, and front-end build quality.",
    image: "/portfolio-redot.png",
    category: "Open Source",
    url: "https://www.redotengine.org/",
    role: "Structure + frontend",
    year: "2026",
    tags: ["Astro", "Documentation", "Community"]
  },
  {
    title: "Chattybox AI",
    description: "A more involved SaaS product that shows I can take on deeper custom software work when a project needs more than a brochure website.",
    image: "/portfolio-chattybox.png",
    category: "SaaS Product",
    url: "https://chattybox.ai/",
    role: "Product build",
    year: "2026",
    tags: ["React", "Python", "Custom App"]
  }
];
---

<Layout title="Portfolio | Staticfish" description="A small selection of recent work that shows the quality and range behind Staticfish.">
  <div class="min-h-screen flex flex-col">
    <Header />

    <main class="flex-1">
      <PageHero eyebrow="Portfolio">
        <span slot="title">Recent <span class="gradient-text-bright">projects.</span></span>
        A small selection of projects that shows the standard of design and build quality I bring to client work.
      </PageHero>

      <section class="mx-auto max-w-6xl px-6 py-16 lg:py-24">
        <div class="space-y-20 lg:space-y-28">
          {projects.map((item, i) => (
            <article class="grid items-center gap-8 lg:grid-cols-12 lg:gap-12">
                <a href={item.url} target="_blank" rel="noopener noreferrer" class="group block overflow-hidden rounded-[2rem] border border-bone/10 shadow-[0_30px_80px_-30px_rgba(0,0,0,0.7)]">
                  <img
                    src={item.image}
                    alt={item.title}
                    class="aspect-[16/10] w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.03]"
                    loading="lazy"
                  />
                </a>
              <div class={i % 2 === 0 ? "lg:col-span-5" : "lg:col-span-5 lg:order-1"}>
                <div>
                  <p class="font-display text-5xl font-bold tracking-tight text-bone/10">0{i + 1}</p>
                </div>
                <div>
                  <p class="mt-4 text-[11px] font-bold uppercase tracking-[0.18em] text-slate-400">{item.category} · {item.role} · {item.year}</p>
                  <h2 class="mt-2 font-display text-3xl font-bold tracking-tight text-bone sm:text-4xl">
                    {item.title}
                  </h2>
                  <p class="mt-4 leading-relaxed text-slate-400">
                    {item.description}
                  </p>
                  <div class="mt-5 flex flex-wrap gap-2">
                    {item.tags.map(tag => (
                      <Chip>{tag}</Chip>
                    ))}
                  </div>
                  <a href={item.url} target="_blank" rel="noopener noreferrer" class="group/link mt-7 inline-flex items-center gap-2 text-sm font-bold text-bone">
                    <span class="link-underline">View live site</span>
                    <ArrowUpRight className="h-4 w-4 transition-transform duration-300 group-hover/link:translate-x-0.5 group-hover/link:-translate-y-0.5" />
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>

          <Card class="mx-auto mt-24 max-w-xl text-center" pad="lg">
            <h3 class="font-display text-2xl font-bold tracking-tight text-bone">More coming soon</h3>
            <p class="mx-auto mt-2 max-w-md text-sm leading-relaxed text-slate-400">
              As more client work is ready to share publicly, I'll add it here.
            </p>
            <Button href="/contact" variant="secondary" size="sm" class="mt-6">Start your project</Button>
          </Card>
      </section>

      <CtaPanel
        eyebrow="Next project"
        title="Want to see your"
        highlight="project here?"
        description="If you want this level of care on your website or a more custom project, let's talk."
        primary={{ href: "/contact", label: "Let's Talk" }}
      />
    </main>
    <Footer />
  </div>
</Layout>
