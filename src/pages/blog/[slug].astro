---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Halftone from '../../components/effects/Halftone.astro';
import Button from '../../components/ui/Button.astro';
import { sanityClient } from 'sanity:client';
import { urlFor } from '../../lib/sanity';
import { PortableText } from 'astro-portabletext';
import { ArrowLeft, ArrowRight, Calendar, Clock, Twitter, Linkedin, Facebook, Link2 } from 'lucide-react';
import TableBlock from '../../components/TableBlock.astro';
import Card from '../../components/ui/Card.astro';

export async function getStaticPaths() {
  const POSTS_QUERY = `*[_type == "post" && defined(slug.current)] {
    "slug": slug.current
  }`;
  const posts = await sanityClient.fetch(POSTS_QUERY);

  return posts.map((post: any) => ({
    params: { slug: post.slug },
  }));
}

const { slug } = Astro.params;

const POST_QUERY = `*[_type == "post" && slug.current == $slug][0] {
  _id,
  title,
  slug,
  excerpt,
  mainImage,
  body,
  authorName,
  categories,
  publishedAt,
  "estimatedReadingTime": round(length(pt::text(body)) / 5 / 180 )
}`;

const RELATED_QUERY = `*[_type == "post" && slug.current != $slug && defined(slug.current)] | order(publishedAt desc)[0...3] {
  _id,
  title,
  slug,
  mainImage,
  publishedAt
}`;

const post = await sanityClient.fetch(POST_QUERY, { slug });
const relatedPosts = await sanityClient.fetch(RELATED_QUERY, { slug });

if (!post) {
  return Astro.redirect('/blog');
}

const formatDate = (dateStr: string) => {
  return new Date(dateStr).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  });
};

const portableTextComponents = {
  block: {
    normal: TableBlock
  }
};

const projectId = '2gr3dh6t';
const dataset = 'production';

function buildImageUrl(assetRef: string): string {
  const parts = assetRef.replace('image-', '').split('-');
  const dimensions = parts[parts.length - 2];
  const format = parts[parts.length - 1];
  const id = parts.slice(0, -2).join('-');
  return `https://cdn.sanity.io/images/${projectId}/${dataset}/${id}-${dimensions}.${format}`;
}

function processBodyBlocks(blocks: any[]) {
  if (!blocks) return { processedBlocks: [], inlineImages: [] };

  const inlineImages: any[] = [];
  const processedBlocks: any[] = [];
  let currentTable: any[] = [];

  for (const block of blocks) {
    if (block._type === 'inlineImage') {
      if (currentTable.length > 0) {
        processedBlocks.push({
          _type: 'table',
          rows: currentTable
        });
        currentTable = [];
      }
      inlineImages.push(block);
    } else if (isTableRow(block)) {
      currentTable.push(block);
    } else {
      if (currentTable.length > 0) {
        processedBlocks.push({
          _type: 'table',
          rows: currentTable
        });
        currentTable = [];
      }
      processedBlocks.push(block);
    }
  }

  if (currentTable.length > 0) {
    processedBlocks.push({
      _type: 'table',
      rows: currentTable
    });
  }

  return { processedBlocks, inlineImages };
}

function isTableRow(block: any): boolean {
  if (block._type !== 'block' || block.style !== 'normal') return false;
  const text = block.children?.map((child: any) => child.text).join('') || '';
  return text.includes('|') && text.trim().length > 0;
}

const { processedBlocks: textBlocks, inlineImages } = processBodyBlocks(post.body);
---

<Layout title={`${post.title} | Staticfish Blog`} description={post.excerpt || post.title}>
  <div class="min-h-screen flex flex-col">
    <Header />

    <!-- Reading Progress Bar -->
    <div class="fixed top-0 left-0 right-0 h-1 z-50 bg-white/10">
      <div id="reading-progress" class="h-full transition-all duration-150" style="width: 0%; background: linear-gradient(90deg, #ff4d5d, #ff8a3d);"></div>
    </div>

    <main class="flex-1">
      <article>

        <!-- Hero Section -->
        <div class="bg-abyss noise-overlay pt-36 pb-12 lg:pb-16 relative overflow-hidden">
          <div class="hero-grid-faint absolute inset-0" aria-hidden="true" />
          <Halftone />
          <div class="mx-auto max-w-4xl px-6 relative z-10">
            <div class="mb-8">
              <a href="/blog" class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-5 py-2.5 text-sm font-bold text-slate-200 backdrop-blur transition-all duration-300 hover:bg-white/10">
                <ArrowLeft className="h-4 w-4" />
                Back to Blog
              </a>
            </div>

            <div class="flex flex-wrap items-center gap-2 mb-6">
              {post.categories && post.categories.length > 0 && (
                post.categories.map((cat: string) => (
                  <span class="text-xs font-bold uppercase tracking-widest px-4 py-1.5 rounded-full border border-white/15 bg-white/5 text-slate-200">
                    {cat}
                  </span>
                ))
              )}
            </div>

            <h1 class="text-balance font-display text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight leading-[1.02] mb-6 text-white">
              {post.title}
            </h1>

            {post.excerpt && (
              <p class="text-xl lg:text-2xl text-slate-300 leading-relaxed max-w-3xl">
                {post.excerpt}
              </p>
            )}

            <div class="flex flex-wrap items-center gap-6 mt-8 pt-6 border-t border-white/10">
              {post.authorName && (
                <div class="flex items-center gap-3">
                  <div class="w-11 h-11 rounded-2xl flex items-center justify-center text-white font-bold text-sm shadow-lg" style="background: linear-gradient(135deg, #ff4d5d, #ff7a3d)">
                    {post.authorName.split(' ').map((n: string) => n[0]).join('')}
                  </div>
                  <div>
                    <div class="font-semibold text-white">{post.authorName}</div>
                    <div class="text-sm text-slate-400">Author</div>
                  </div>
                </div>
              )}

              <div class="flex items-center gap-4 text-sm text-slate-400">
                {post.publishedAt && (
                  <span class="flex items-center gap-1.5">
                    <Calendar className="h-4 w-4" />
                    {formatDate(post.publishedAt)}
                  </span>
                )}
                {post.estimatedReadingTime > 0 && (
                  <span class="flex items-center gap-1.5">
                    <Clock className="h-4 w-4" />
                    {post.estimatedReadingTime} min read
                  </span>
                )}
              </div>
            </div>
          </div>
          <div class="hero-fade" aria-hidden="true" />
        </div>

        <!-- Main Image -->
        {post.mainImage?.asset && (
          <div class="pb-12 lg:pb-16 pt-12 lg:pt-16">
            <div class="mx-auto max-w-5xl px-6">
              <div class="browser-glow relative aspect-video overflow-hidden rounded-[2rem]">
                <img
                  src={urlFor(post.mainImage).width(1400).height(788).url()}
                  alt={post.mainImage.alt || post.title}
                  class="absolute inset-0 w-full h-full object-cover"
                />
              </div>
            </div>
          </div>
        )}

        <!-- Article Content -->
        <div class="py-8 lg:py-12">
          <div class="px-6">
            <Card class="max-w-3xl mx-auto" pad="lg">
              {(textBlocks.length > 0 || inlineImages.length > 0) && (
                <div class="article-content prose prose-lg max-w-none
                  prose-headings:font-display prose-headings:tracking-tight prose-headings:text-white
                  prose-headings:scroll-mt-32
                  prose-h2:text-3xl prose-h2:mt-14 prose-h2:mb-5
                  prose-h3:text-xl prose-h3:mt-10 prose-h3:mb-4 prose-h3:text-[#ffb3a6]
                  prose-p:text-slate-300 prose-p:leading-[1.85] prose-p:text-[1.1rem]
                  prose-a:text-[#ff8a9d] prose-a:font-semibold prose-a:no-underline prose-a:hover:underline
                  prose-img:rounded-2xl
                  prose-blockquote:border-l-4 prose-blockquote:pl-6 prose-blockquote:italic prose-blockquote:text-slate-100 prose-blockquote:rounded-r-2xl prose-blockquote:py-1
                  prose-code:text-[#ffc9b0] prose-code:bg-white/10 prose-code:px-2 prose-code:py-0.5 prose-code:rounded-md prose-code:font-medium prose-code:before:content-none prose-code:after:content-none
                  prose-pre:bg-black/40 prose-pre:text-slate-100 prose-pre:rounded-2xl prose-pre:border prose-pre:border-white/10
                  prose-li:text-slate-300 prose-li:marker:text-[#ff4d5d]
                  prose-strong:text-white prose-strong:font-semibold
                  prose-ul:my-6 prose-ol:my-6
                  prose-hr:border-0 prose-hr:h-px prose-hr:bg-gradient-to-r prose-hr:from-transparent prose-hr:via-white/25 prose-hr:to-transparent prose-hr:my-12">
                  {textBlocks.map((block: any) => (
                    block._type === 'table'
                      ? <TableBlock rows={block.rows} />
                      : <PortableText value={[block]} />
                  ))}

                  {inlineImages.map((img: any) => (
                    img?.asset?._ref && (
                    <figure class="my-14 not-prose">
                      <div class="relative overflow-hidden rounded-3xl border border-white/10 shadow-lg">
                        <img
                          src={`${buildImageUrl(img.asset._ref)}?w=900&q=85`}
                          alt={img.alt || ''}
                          class="w-full"
                          loading="lazy"
                        />
                      </div>
                      {img.caption && (
                        <figcaption class="mt-4 text-center text-sm text-slate-400">
                          <span class="inline-flex items-center gap-2">
                            <span class="w-8 h-px bg-gradient-to-r from-transparent to-[#ff4d5d]/70"></span>
                            {img.caption}
                            <span class="w-8 h-px bg-gradient-to-l from-transparent to-[#ff4d5d]/70"></span>
                          </span>
                        </figcaption>
                      )}
                    </figure>
                    )
                  ))}
                </div>
              )}
            </Card>
          </div>
        </div>

        <!-- Share Section -->
        <div class="py-12">
          <div class="mx-auto max-w-3xl px-6">
            <Card class="flex flex-col items-center justify-between gap-6 sm:flex-row">
              <div class="text-center sm:text-left">
                <p class="text-sm text-slate-400 mb-1">Enjoyed this article?</p>
                <p class="font-bold text-white">Share it with others</p>
              </div>
              <div class="flex items-center gap-3">
                <a
                  href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(post.title)}&url=${encodeURIComponent(Astro.url.href)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex h-11 w-11 items-center justify-center rounded-full bg-white/10 text-white transition-all duration-300 hover:bg-[#1DA1F2]"
                  aria-label="Share on Twitter"
                >
                  <Twitter className="h-5 w-5" />
                </a>
                <a
                  href={`https://www.linkedin.com/shareArticle?mini=true&url=${encodeURIComponent(Astro.url.href)}&title=${encodeURIComponent(post.title)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex h-11 w-11 items-center justify-center rounded-full bg-white/10 text-white transition-all duration-300 hover:bg-[#0A66C2]"
                  aria-label="Share on LinkedIn"
                >
                  <Linkedin className="h-5 w-5" />
                </a>
                <a
                  href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(Astro.url.href)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex h-11 w-11 items-center justify-center rounded-full bg-white/10 text-white transition-all duration-300 hover:bg-[#1877F2]"
                  aria-label="Share on Facebook"
                >
                  <Facebook className="h-5 w-5" />
                </a>
                <button
                  class="flex h-11 w-11 items-center justify-center rounded-full text-white transition-colors duration-300 cursor-pointer"
                  style="background: linear-gradient(135deg, #ff4d5d, #ff7a3d)"
                  onclick="navigator.clipboard.writeText(window.location.href)"
                  aria-label="Copy link"
                >
                  <Link2 className="h-5 w-5" />
                </button>
              </div>
            </Card>
          </div>
        </div>
      </article>

      <!-- Related Articles -->
      {relatedPosts.length > 0 && (
        <section class="py-20 relative overflow-hidden">
          <div class="absolute inset-0 bg-gradient-to-b from-transparent via-white/[0.03] to-transparent" aria-hidden="true"></div>
          <div class="mx-auto max-w-7xl px-6 relative">
            <div class="flex items-end justify-between mb-12">
              <div>
                <span class="eyebrow-pill"><span class="eyebrow-dot"></span> Continue reading</span>
                <h2 class="mt-5 font-display text-3xl sm:text-4xl font-bold tracking-tight">
                  More Articles
                </h2>
              </div>
              <Button href="/blog" variant="secondary" size="sm" class="hidden sm:inline-flex" arrow={false}>View All</Button>
            </div>

            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
              {relatedPosts.map((relatedPost: any) => (
                <a
                  href={`/blog/${relatedPost.slug.current}`}
                  class="card-lift group block overflow-hidden rounded-3xl border border-white/10 bg-white/[0.03] backdrop-blur"
                >
                  {relatedPost.mainImage?.asset ? (
                    <div class="aspect-[16/10] relative overflow-hidden">
                      <img
                        src={urlFor(relatedPost.mainImage).width(500).height(312).url()}
                        alt={relatedPost.mainImage.alt || relatedPost.title}
                        class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                      />
                    </div>
                  ) : (
                    <div class="dot-pattern aspect-[16/10] relative overflow-hidden bg-white/[0.02]">
                      <div class="absolute inset-0 flex items-center justify-center">
                        <span class="text-xs font-bold uppercase tracking-[0.24em] text-slate-400">Article</span>
                      </div>
                    </div>
                  )}

                  <div class="p-6">
                    {relatedPost.publishedAt && (
                      <span class="text-xs font-semibold text-slate-400 mb-2 block">
                        {formatDate(relatedPost.publishedAt)}
                      </span>
                    )}
                    <h3 class="text-lg font-bold font-display tracking-tight text-white group-hover:text-[#ffb3a6] transition-colors [display:-webkit-box] [-webkit-box-orient:vertical] [-webkit-line-clamp:2] overflow-hidden">
                      {relatedPost.title}
                    </h3>
                    <span class="inline-flex items-center gap-1.5 text-sm font-bold text-[#ff8a9d] mt-3 group-hover:gap-2.5 transition-all duration-200">
                      Read <ArrowRight className="h-4 w-4" />
                    </span>
                  </div>
                </a>
              ))}
            </div>
          </div>
        </section>
      )}
    </main>

    <Footer />
  </div>
</Layout>

<script>
  const progressBar = document.getElementById('reading-progress');

  function updateProgress() {
    const scrollTop = window.scrollY;
    const docHeight = document.documentElement.scrollHeight - window.innerHeight;
    const progress = (scrollTop / docHeight) * 100;
    if (progressBar) {
      progressBar.style.width = `${Math.min(progress, 100)}%`;
    }
  }

  window.addEventListener('scroll', updateProgress, { passive: true });
  updateProgress();
</script>
