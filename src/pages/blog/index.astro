---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/PageHero.astro';
import CtaPanel from '../../components/CtaPanel.astro';
import Reveal from '../../components/effects/Reveal.astro';
import { sanityClient } from 'sanity:client';
import { urlFor } from '../../lib/sanity';
import { ArrowRight, Calendar, Clock } from 'lucide-react';

const POSTS_QUERY = `*[_type == "post" && defined(slug.current)] | order(publishedAt desc) {
  _id,
  title,
  slug,
  excerpt,
  mainImage,
  authorName,
  categories,
  publishedAt,
  "estimatedReadingTime": round(length(pt::text(body)) / 5 / 180 )
}`;

const posts = await sanityClient.fetch(POSTS_QUERY);

const formatDate = (dateStr: string) => {
  return new Date(dateStr).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  });
};

const featuredPost = posts[0];
const recentPosts = posts.slice(1);
---

<Layout title="Blog | Staticfish" description="Articles and insights about web development, design, and digital strategy.">
  <div class="min-h-screen flex flex-col">
    <Header />

    <main class="flex-1">
      <PageHero eyebrow="Blog">
        <span slot="title">Thoughts <span class="serif-accent font-normal gradient-text-bright">& ideas.</span></span>
        Web development insights, design trends, and practical tips for building better websites.
      </PageHero>

      <section class="mx-auto max-w-7xl px-6 py-16 lg:py-24">
        {posts.length === 0 && (
          <Reveal variant="scale">
            <div class="glass rounded-[2rem] py-24 text-center">
              <p class="text-lg text-slate-400">No posts yet. Check back soon!</p>
            </div>
          </Reveal>
        )}

        {featuredPost && (
          <Reveal variant="scale">
            <a
              href={`/blog/${featuredPost.slug.current}`}
              class="card-lift group mb-8 grid overflow-hidden rounded-[2rem] border border-white/10 bg-white/[0.03] backdrop-blur lg:grid-cols-2"
            >
              {featuredPost.mainImage?.asset ? (
                <div class="relative min-h-[280px] overflow-hidden">
                  <img
                    src={urlFor(featuredPost.mainImage).width(900).height(600).url()}
                    alt={featuredPost.mainImage.alt || featuredPost.title}
                    class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-[#050512]/50 via-transparent to-transparent"></div>
                  <span class="glass absolute left-5 top-5 rounded-full px-4 py-1.5 text-[11px] font-bold uppercase tracking-widest text-slate-200 lg:hidden">
                    Featured
                  </span>
                </div>
              ) : (
                <div class="dot-pattern relative flex min-h-[280px] items-center justify-center bg-white/[0.02]">
                  <span class="text-xs font-bold uppercase tracking-[0.24em] text-slate-500">Article</span>
                </div>
              )}

              <div class="relative flex flex-col justify-center p-8 lg:p-12">
                <span class="absolute right-8 top-8 hidden rounded-full bg-gradient-to-r from-[#ff4d5d] to-[#ff7a3d] px-4 py-1.5 text-[11px] font-bold uppercase tracking-widest text-white shadow-lg shadow-[#ff4d5d]/30 lg:block">
                  Featured
                </span>

                <div class="flex flex-wrap items-center gap-4 text-sm text-slate-400">
                  {featuredPost.publishedAt && (
                    <span class="flex items-center gap-1.5">
                      <Calendar className="h-4 w-4" />
                      {formatDate(featuredPost.publishedAt)}
                    </span>
                  )}
                  {featuredPost.estimatedReadingTime > 0 && (
                    <span class="flex items-center gap-1.5">
                      <Clock className="h-4 w-4" />
                      {featuredPost.estimatedReadingTime} min read
                    </span>
                  )}
                </div>

                <h2 class="mt-4 font-display text-3xl font-bold tracking-tight text-white transition-colors group-hover:text-[#ffb3a6] lg:text-4xl">
                  {featuredPost.title}
                </h2>

                {featuredPost.excerpt && (
                  <p class="mt-4 leading-relaxed text-slate-400 [display:-webkit-box] [-webkit-box-orient:vertical] [-webkit-line-clamp:3] overflow-hidden">
                    {featuredPost.excerpt}
                  </p>
                )}

                {featuredPost.categories && featuredPost.categories.length > 0 && (
                  <div class="mb-6 mt-5 flex flex-wrap gap-2">
                    {featuredPost.categories.map((cat: string) => (
                      <span class="inline-flex items-center gap-1 rounded-full border border-white/15 bg-white/5 px-3 py-1 text-xs font-bold text-slate-300">
                        {cat}
                      </span>
                    ))}
                  </div>
                )}

                <div class="flex items-center gap-2 text-sm font-bold text-[#ff8a9d] transition-all duration-200 group-hover:gap-3">
                  Read article <ArrowRight className="h-4 w-4" />
                </div>
              </div>
            </a>
          </Reveal>
        )}

        {recentPosts.length > 0 && (
          <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {recentPosts.map((post: any, i: number) => (
              <div data-reveal style={`--reveal-delay: ${(i % 3) * 100}ms`}>
                <a
                  href={`/blog/${post.slug.current}`}
                  class="card-lift group block h-full overflow-hidden rounded-3xl border border-white/10 bg-white/[0.03] backdrop-blur"
                >
                  {post.mainImage?.asset ? (
                    <div class="relative aspect-[16/10] overflow-hidden">
                      <img
                        src={urlFor(post.mainImage).width(600).height(375).url()}
                        alt={post.mainImage.alt || post.title}
                        class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
                      />
                    </div>
                  ) : (
                    <div class="dot-pattern relative flex aspect-[16/10] items-center justify-center overflow-hidden bg-white/[0.02]">
                      <span class="text-xs font-bold uppercase tracking-[0.24em] text-slate-500">Article</span>
                    </div>
                  )}

                  <div class="p-6">
                    <div class="mb-3 flex flex-wrap items-center gap-3 text-xs text-slate-500">
                      {post.publishedAt && (
                        <span class="flex items-center gap-1">
                          <Calendar className="h-3 w-3" />
                          {formatDate(post.publishedAt)}
                        </span>
                      )}
                      {post.estimatedReadingTime > 0 && (
                        <span class="flex items-center gap-1">
                          <Clock className="h-3 w-3" />
                          {post.estimatedReadingTime} min
                        </span>
                      )}
                    </div>

                    <h3 class="font-display text-xl font-bold tracking-tight text-white transition-colors group-hover:text-[#ffb3a6] [display:-webkit-box] [-webkit-box-orient:vertical] [-webkit-line-clamp:2] overflow-hidden">
                      {post.title}
                    </h3>

                    {post.excerpt && (
                      <p class="mb-4 mt-2 text-sm leading-relaxed text-slate-400 [display:-webkit-box] [-webkit-box-orient:vertical] [-webkit-line-clamp:2] overflow-hidden">
                        {post.excerpt}
                      </p>
                    )}

                    {post.categories && post.categories.length > 0 && (
                      <div class="flex flex-wrap gap-2">
                        {post.categories.slice(0, 2).map((cat: string) => (
                          <span class="rounded-full bg-white/[0.06] px-2.5 py-1 text-xs font-bold text-slate-400">
                            {cat}
                          </span>
                        ))}
                      </div>
                    )}
                  </div>
                </a>
              </div>
            ))}
          </div>
        )}
      </section>

      <CtaPanel
        eyebrow="Work with me"
        title="Want a website"
        highlight="like this?"
        description="I build fast, affordable websites for small businesses. Let's chat about your project."
        primary={{ href: "/contact", label: "Get a Quote" }}
      />
    </main>

    <Footer />
  </div>
</Layout>
