---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { sanityClient } from 'sanity:client';
import { urlFor } from '../../lib/sanity';
import { ArrowRight, Calendar, Clock } from 'lucide-react';
import { Button } from '../../components/ui/button';
import { WaveBackground, FlowingLines, CornerWaves } from '../../components/WaveArt';
import { FloatingShapes } from '../../components/GeometricArt';

const POSTS_QUERY = `*[_type == "post" && defined(slug.current)] | order(publishedAt desc) {
  _id,
  title,
  slug,
  excerpt,
  mainImage,
  authorName,
  categories,
  publishedAt,
  "estimatedReadingTime": round(length(pt::text(body)) / 5 / 180 )
}`;

const posts = await sanityClient.fetch(POSTS_QUERY);

const formatDate = (dateStr: string) => {
  return new Date(dateStr).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  });
};

const featuredPost = posts[0];
const recentPosts = posts.slice(1);
---

<Layout title="Blog | Staticfish" description="Articles and insights about web development, design, and digital strategy.">
  <div class="min-h-screen flex flex-col bg-background">
    <Header />
    
    <main class="flex-1">
      <section class="pt-32 pb-20 lg:pb-32 relative overflow-hidden">
        <FlowingLines className="hero-flow-art" fadeBottom />
        <CornerWaves position="bottom-right" />
        <div class="container mx-auto max-w-7xl px-6 relative z-10">
          <div class="max-w-2xl mb-12 lg:mb-16">
            <p class="text-sm font-medium text-muted-foreground uppercase tracking-widest mb-6">Blog</p>
            <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-foreground font-display tracking-tighter mb-6">
              Thoughts & Ideas.
            </h1>
            <p class="text-lg text-muted-foreground leading-relaxed">
              Web development insights, design trends, and practical tips for building better websites.
            </p>
          </div>

          {posts.length === 0 && (
            <div class="text-center py-24 border border-border">
              <p class="text-muted-foreground text-lg">No posts yet. Check back soon!</p>
            </div>
          )}

          {featuredPost && (
            <a 
              href={`/blog/${featuredPost.slug.current}`}
              class="group spec-panel block overflow-hidden transition-colors mb-12"
            >
              <div class="grid lg:grid-cols-2">
                {featuredPost.mainImage?.asset ? (
                  <div class="aspect-[16/10] lg:aspect-auto relative overflow-hidden">
                    <img 
                      src={urlFor(featuredPost.mainImage).width(900).height(600).url()} 
                      alt={featuredPost.mainImage.alt || featuredPost.title}
                      class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                    />
                    <div class="absolute bottom-6 left-6 lg:hidden">
                      <span class="bg-accent text-white text-xs font-bold uppercase tracking-widest px-3 py-1.5">
                        Featured
                      </span>
                    </div>
                  </div>
                ) : (
                  <div class="aspect-[16/10] lg:aspect-auto relative overflow-hidden bg-secondary/30 fine-grid">
                    <div class="absolute inset-0 flex items-center justify-center">
                      <span class="text-xs font-bold uppercase tracking-[0.22em] text-muted-foreground">Article</span>
                    </div>
                  </div>
                )}
                
                <div class="p-8 lg:p-12 flex flex-col justify-center relative">
                  <div class="hidden lg:block absolute top-8 right-8">
                    <span class="bg-accent text-white text-xs font-bold uppercase tracking-widest px-3 py-1.5">
                      Featured
                    </span>
                  </div>
                  
                  <div class="flex flex-wrap items-center gap-4 text-sm text-muted-foreground mb-4">
                    {featuredPost.publishedAt && (
                      <span class="flex items-center gap-1.5">
                        <Calendar className="h-4 w-4" />
                        {formatDate(featuredPost.publishedAt)}
                      </span>
                    )}
                    {featuredPost.estimatedReadingTime > 0 && (
                      <span class="flex items-center gap-1.5">
                        <Clock className="h-4 w-4" />
                        {featuredPost.estimatedReadingTime} min read
                      </span>
                    )}
                  </div>
                  
                  <h2 class="text-3xl lg:text-4xl font-bold text-foreground font-display tracking-tight mb-4 group-hover:text-accent transition-colors">
                    {featuredPost.title}
                  </h2>
                  
                  {featuredPost.excerpt && (
                    <p class="text-muted-foreground leading-relaxed mb-6 line-clamp-3">
                      {featuredPost.excerpt}
                    </p>
                  )}
                  
                  {featuredPost.categories && featuredPost.categories.length > 0 && (
                    <div class="flex flex-wrap gap-2 mb-6">
                      {featuredPost.categories.map((cat: string) => (
                        <span class="inline-flex items-center gap-1 text-xs font-medium px-3 py-1 bg-secondary text-muted-foreground">
                          {cat}
                        </span>
                      ))}
                    </div>
                  )}
                  
                  <div class="flex items-center gap-2 text-sm font-semibold text-accent group-hover:gap-3 transition-all duration-200">
                    Read article <ArrowRight className="h-4 w-4" />
                  </div>
                </div>
              </div>
            </a>
          )}

          {recentPosts.length > 0 && (
            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-px bg-border relative z-10">
              {recentPosts.map((post: any) => (
                <a 
                  href={`/blog/${post.slug.current}`}
                  class="editorial-card group block bg-background hover:bg-secondary/20 transition-all duration-200"
                >
                  {post.mainImage?.asset ? (
                    <div class="aspect-[16/10] relative overflow-hidden">
                      <img 
                        src={urlFor(post.mainImage).width(600).height(375).url()} 
                        alt={post.mainImage.alt || post.title}
                        class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                      />
                    </div>
                  ) : (
                    <div class="aspect-[16/10] relative overflow-hidden bg-secondary/30 fine-grid">
                      <div class="absolute inset-0 flex items-center justify-center">
                        <span class="text-xs font-bold uppercase tracking-[0.22em] text-muted-foreground">Article</span>
                      </div>
                    </div>
                  )}
                  
                  <div class="p-6">
                    <div class="flex flex-wrap items-center gap-3 text-xs text-muted-foreground mb-3">
                      {post.publishedAt && (
                        <span class="flex items-center gap-1">
                          <Calendar className="h-3 w-3" />
                          {formatDate(post.publishedAt)}
                        </span>
                      )}
                      {post.estimatedReadingTime > 0 && (
                        <span class="flex items-center gap-1">
                          <Clock className="h-3 w-3" />
                          {post.estimatedReadingTime} min
                        </span>
                      )}
                    </div>
                    
                    <h3 class="text-xl font-bold text-foreground font-display tracking-tight mb-2 group-hover:text-accent transition-colors line-clamp-2">
                      {post.title}
                    </h3>
                    
                    {post.excerpt && (
                      <p class="text-sm text-muted-foreground leading-relaxed mb-4 line-clamp-2">
                        {post.excerpt}
                      </p>
                    )}
                    
                    {post.categories && post.categories.length > 0 && (
                      <div class="flex flex-wrap gap-2">
                        {post.categories.slice(0, 2).map((cat: string) => (
                          <span class="text-xs font-medium px-2 py-0.5 bg-secondary text-muted-foreground">
                            {cat}
                          </span>
                        ))}
                      </div>
                    )}
                  </div>
                </a>
              ))}
            </div>
          )}
        </div>
      </section>
      
      <section class="py-20 border-t border-border relative overflow-hidden">
        <WaveBackground variant="teal" opacity={0.12} fadeTop />
        <FloatingShapes fadeTop />
        <div class="container mx-auto max-w-7xl px-6 relative z-10">
          <div class="bg-foreground text-background p-12 lg:p-16 text-center corner-bracket relative overflow-hidden">
            <div class="deco-dots absolute inset-0 opacity-40"></div>
            <div class="relative z-10">
            <h2 class="text-3xl sm:text-4xl font-bold font-display tracking-tighter mb-4 text-background">
              Want a Website Like This?
            </h2>
            <p class="text-background/70 max-w-xl mx-auto mb-8">
              I build fast, affordable websites for small businesses. Let's chat about your project.
            </p>
            <Button className="rounded-none h-12 px-8 font-semibold bg-accent hover:bg-accent/90 text-white">
              <a href="/contact">Get a Quote</a>
            </Button>
            </div>
          </div>
        </div>
      </section>
    </main>
    
    <Footer />
  </div>
</Layout>
