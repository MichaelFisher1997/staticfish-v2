---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { Button } from '../components/ui/button';
import { ArrowRight, Check, X } from 'lucide-react';
import { WaveBackground, FlowingLines, CornerWaves } from '../components/WaveArt';
import { GeometricArt, FloatingShapes } from '../components/GeometricArt';

const softwareTypes = [
  {
    title: 'SaaS MVPs',
    description: 'The core offer here: turning a product idea into a real first version without wasting months building the wrong thing.'
  },
  {
    title: 'Founder Dashboards',
    description: 'Admin areas, internal tools, and operational dashboards that help founders actually run the product from day one.'
  },
  {
    title: 'Client Portals',
    description: 'Private areas where users can log in, view information, submit data, and work through a service or workflow.'
  },
  {
    title: 'Product Workflows',
    description: 'Onboarding flows, approvals, bookings, submissions, and other product logic that turns an idea into a working service.'
  }
];

const deliveryModels = [
  {
    title: 'Build and handoff',
    description: 'I build the MVP, structure the repo properly, document the setup, and hand it over cleanly to you or your team.'
  },
  {
    title: 'Built and managed in-house',
    description: 'I build and continue handling the technical side so you can focus on customers, sales, and running the business.'
  }
];

const goodFit = [
  'You want to launch an MVP, not spend six months planning a massive platform',
  'You can describe the first version and the core user journey clearly enough to build',
  'You want one experienced technical partner to move quickly without unnecessary layers',
  'You would rather get live, learn from users, and iterate than overbuild up front'
];

const notTypical = [
  'You want a huge enterprise platform from day one',
  'You need a full in-house product team immediately',
  'The product idea is still too vague to define the first version',
  'You only need a normal brochure website rather than software'
];

const processSteps = [
  {
    step: '01',
    title: 'Define the MVP',
    description: 'We work out what the first usable version actually needs, what can wait, and what the core workflow is.'
  },
  {
    step: '02',
    title: 'Direction and scope',
    description: 'I map the product direction, key screens, and technical approach so we are aligned before the full build starts.'
  },
  {
    step: '03',
    title: 'Build the product',
    description: 'I build the MVP in stages, keeping it grounded in the business goal rather than piling on unnecessary features.'
  },
  {
    step: '04',
    title: 'Handoff or manage',
    description: 'Once the MVP is ready, I either hand over the repo cleanly or continue managing the technical side in-house for you.'
  }
];
---

<Layout title="Custom Software | Staticfish" description="SaaS MVP development for founders who need a real first product, not just a landing page or prototype.">
  <div class="min-h-screen flex flex-col bg-background">
    <Header />

    <main class="flex-1">
      <section class="pt-32 pb-20 lg:pb-32 relative overflow-hidden">
        <FlowingLines count={8} />
        <CornerWaves position="bottom-right" />
        <div class="container mx-auto max-w-7xl px-6 relative z-10">
          <div class="grid lg:grid-cols-12 gap-12 items-center">
            <div class="lg:col-span-7 max-w-3xl">
              <p class="text-sm font-medium text-muted-foreground uppercase tracking-widest mb-6">
                SaaS MVP Development
              </p>
              <h1 class="text-5xl sm:text-6xl lg:text-7xl font-bold text-foreground font-display tracking-tighter mb-8">
                Build the first real
                <span class="text-accent">version of the product.</span>
              </h1>
              <p class="text-lg sm:text-xl text-muted-foreground leading-relaxed max-w-2xl mb-8">
                This is actually what I specialise in most: building SaaS MVPs and early product versions that get an idea into the real world quickly and properly.
              </p>
              <p class="text-muted-foreground max-w-2xl">
                It is not the main service I market on Staticfish, but if you need a real product rather than a brochure site or loose prototype, this is the work I am strongest at.
              </p>
            </div>

            <div class="lg:col-span-5">
              <img
                src="/illustrations/service-custom.svg"
                alt="Custom software illustration"
                class="w-full h-auto"
              />
            </div>
          </div>
        </div>
      </section>

      <section class="py-20 border-t border-border relative overflow-hidden">
        <GeometricArt variant="mixed" />
        <div class="container mx-auto max-w-7xl px-6 relative z-10">
          <div class="max-w-3xl mb-12">
            <p class="text-sm font-medium text-muted-foreground uppercase tracking-widest mb-4">What I Build</p>
            <h2 class="text-4xl sm:text-5xl font-bold text-foreground font-display tracking-tighter mb-4">
              MVP-first product work.
            </h2>
            <p class="text-muted-foreground leading-relaxed">
              The goal is not to build everything at once. The goal is to build the first version that is strong enough to launch, test with real users, and improve from there.
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-px bg-border">
            {softwareTypes.map((item) => (
              <div class="bg-background p-8 hover:bg-secondary/20 transition-colors">
                <h3 class="text-2xl font-bold text-foreground font-display mb-3">{item.title}</h3>
                <p class="text-sm text-muted-foreground leading-relaxed">{item.description}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section class="py-20 border-t border-border bg-secondary/20 relative overflow-hidden">
        <WaveBackground variant="coral" opacity={0.1} />
        <FloatingShapes />

        <div class="container mx-auto max-w-7xl px-6 relative z-10">
          <div class="max-w-3xl mb-12">
            <p class="text-sm font-medium text-muted-foreground uppercase tracking-widest mb-4">Delivery Model</p>
            <h2 class="text-4xl sm:text-5xl font-bold text-foreground font-display tracking-tighter mb-4">
              Two ways I can deliver it.
            </h2>
            <p class="text-muted-foreground leading-relaxed">
              Some founders want the repo handed over once the MVP is ready. Others want me to stay on the technical side while they focus on customers, growth, and running the business.
            </p>
          </div>

          <div class="grid lg:grid-cols-2 gap-px bg-border">
            {deliveryModels.map((item) => (
              <div class="bg-background p-8 lg:p-12">
                <h3 class="text-3xl font-bold text-foreground font-display mb-4">{item.title}</h3>
                <p class="text-muted-foreground leading-relaxed">{item.description}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section class="py-20 border-t border-border relative overflow-hidden">
        <GeometricArt variant="dots" />
        <div class="container mx-auto max-w-7xl px-6 relative z-10">
          <div class="grid lg:grid-cols-2 gap-px bg-border">
            <div class="bg-background p-8 lg:p-12">
              <p class="text-sm font-medium text-muted-foreground uppercase tracking-widest mb-4">Good Fit</p>
              <h2 class="text-3xl font-bold text-foreground font-display mb-8">Good fit if...</h2>
              <ul class="space-y-4">
                {goodFit.map((item) => (
                  <li class="flex items-start gap-3">
                    <Check className="h-4 w-4 text-accent mt-0.5 shrink-0" strokeWidth={3} />
                    <span class="text-sm text-foreground">{item}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="bg-background p-8 lg:p-12">
              <p class="text-sm font-medium text-muted-foreground uppercase tracking-widest mb-4">Not Typical</p>
              <h2 class="text-3xl font-bold text-foreground font-display mb-8">Probably not the right fit if...</h2>
              <ul class="space-y-4">
                {notTypical.map((item) => (
                  <li class="flex items-start gap-3">
                    <X className="h-4 w-4 text-accent mt-0.5 shrink-0" strokeWidth={3} />
                    <span class="text-sm text-foreground">{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </section>

      <section class="py-20 border-t border-border relative overflow-hidden">
        <GeometricArt variant="lines" />
        <div class="container mx-auto max-w-7xl px-6 relative z-10">
          <p class="text-sm font-medium text-muted-foreground uppercase tracking-widest mb-6">Process</p>
          <h2 class="text-4xl sm:text-5xl font-bold text-foreground font-display tracking-tighter mb-16">How SaaS MVP projects work.</h2>

          <div class="border-t border-border">
            {processSteps.map((step) => (
              <div class="border-b border-border py-10">
                <div class="grid grid-cols-12 gap-6 items-start">
                  <div class="col-span-12 sm:col-span-1">
                    <span class="text-sm font-medium text-muted-foreground">{step.step}</span>
                  </div>
                  <div class="col-span-12 sm:col-span-3">
                    <h3 class="text-xl font-bold text-foreground font-display">{step.title}</h3>
                  </div>
                  <div class="col-span-12 sm:col-span-8">
                    <p class="text-muted-foreground text-sm leading-relaxed">{step.description}</p>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section class="py-20 border-t border-border relative overflow-hidden">
        <WaveBackground variant="teal" opacity={0.12} />
        <div class="container mx-auto max-w-7xl px-6 relative z-10">
          <div class="bg-foreground text-background p-12 lg:p-20 text-center corner-bracket">
            <p class="text-sm font-medium text-background/60 uppercase tracking-widest mb-6">Next Step</p>
            <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold font-display tracking-tighter mb-6 text-background">
              Need help turning an idea into a
              <span class="text-accent">real MVP?</span>
            </h2>
            <p class="text-lg text-background/70 mb-10 max-w-2xl mx-auto">
              Send me the product idea, the core user flow, and what version one needs to do. I will tell you whether it makes sense as a real MVP and whether it is better as a handoff build or something I continue managing with you.
            </p>
            <Button className="rounded-none h-12 px-8 font-semibold bg-accent hover:bg-accent/90 text-white">
              <a href="/contact" class="flex items-center gap-2">
                Talk About Your MVP <ArrowRight className="h-4 w-4" />
              </a>
            </Button>
          </div>
        </div>
      </section>
    </main>

    <Footer />
  </div>
</Layout>
