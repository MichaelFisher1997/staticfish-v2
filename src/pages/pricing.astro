---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { Button } from '../components/ui/button';
import { Check, ArrowRight } from 'lucide-react';
import { WaveBackground, FlowingLines, CornerWaves } from '../components/WaveArt';
import { GeometricArt, FloatingShapes } from '../components/GeometricArt';

const corePackage = {
  title: 'Business Website',
  priceGbp: 599,
  features: [
    'The core pages your business needs to launch',
    'Custom design',
    'Mobile-friendly layout',
    'Contact form',
    'Basic SEO setup',
    'Launch support'
  ]
};

const addOns = [
  {
    title: 'Editable Content Add-On',
    priceGbp: 800,
    description: 'Adds a CMS so you can edit pages, services, pricing, testimonials, and blog or news posts yourself.',
  }
];

const pricingNotes = [
  {
    title: 'No surprise billing',
    description: 'You get a clear quote before work starts. Changes outside the agreed scope are quoted separately.'
  },
  {
    title: 'Approve first, pay before launch',
    description: 'I will show you the direction first. Once the site is complete and approved, payment is due before it goes live.'
  },
  {
    title: 'Domain and DNS are handled clearly',
    description: 'If you already have a domain, I can help connect it. If you need a new one, I can register it for you, but you cover the domain cost.'
  }
];
---

<Layout title="Pricing | Staticfish" description="Simple pricing for business websites, with an editable-content option and a separate route for custom software projects.">
  <div class="min-h-screen flex flex-col bg-background">
    <Header />

    <main class="flex-1">
      <section class="pt-32 pb-20 lg:pb-32 relative overflow-hidden">
        <FlowingLines fadeBottom />
        <CornerWaves position="bottom-right" />
        <div class="container mx-auto max-w-7xl px-6 relative z-10">
          <div class="max-w-3xl">
            <p class="text-sm font-medium text-muted-foreground uppercase tracking-widest mb-6">
              Pricing
            </p>
            <h1 class="text-5xl sm:text-6xl lg:text-7xl font-bold text-foreground font-display tracking-tighter mb-8">
              Simple website
              <span class="text-accent">pricing.</span>
            </h1>
            <p class="text-lg sm:text-xl text-muted-foreground leading-relaxed max-w-2xl mb-4">
              One upfront price for the agreed website scope, plus one monthly fee to keep the site live and looked after.
            </p>
            <p class="text-muted-foreground max-w-2xl">
              If you need a CMS for editable content, that is added clearly instead of hidden inside a bigger package you may not need. Anything more tailored is quoted separately.
            </p>
          </div>
        </div>
      </section>

      <section class="py-20 border-t border-border relative overflow-hidden">
        <GeometricArt variant="circles" fadeTop fadeBottom />
        <div class="container mx-auto max-w-7xl px-6 relative z-10">
          <div class="max-w-5xl mx-auto border border-border bg-background">
            <div class="grid lg:grid-cols-2 gap-px bg-border">
              <div class="bg-background p-8 lg:p-12">
                <p class="text-sm font-medium text-muted-foreground uppercase tracking-widest mb-4">Most Clients Start Here</p>
                <h2 class="text-3xl sm:text-4xl font-bold text-foreground font-display tracking-tight mb-4">{corePackage.title}</h2>
                <p class="text-muted-foreground leading-relaxed mb-8">
                  A clear, professional website for businesses that need to explain what they do and make it easy for people to enquire.
                </p>

                <div class="mb-8">
                  <div class="flex items-baseline gap-2">
                    <span class="text-6xl font-bold text-foreground font-display tracking-tighter" data-price-gbp={corePackage.priceGbp}>£{corePackage.priceGbp}</span>
                    <span class="text-sm text-muted-foreground">upfront</span>
                  </div>
                  <div class="mt-3">
                    <span class="text-sm text-muted-foreground" data-hosting-gbp>+ £25/month hosting, backups &amp; upkeep</span>
                  </div>
                </div>

                <p class="text-sm text-muted-foreground mb-8">
                  If you need editable content, those projects start from <strong class="text-foreground">£50/month</strong> ongoing.
                </p>

                <Button className="rounded-none h-12 px-8 font-semibold">
                  <a href="/contact" class="flex items-center gap-2">
                    Ask for a Quote <ArrowRight className="h-4 w-4" />
                  </a>
                </Button>
              </div>

              <div class="bg-background p-8 lg:p-12">
                <p class="text-sm font-medium text-muted-foreground uppercase tracking-widest mb-4">Included</p>
                <ul class="space-y-4">
                  {corePackage.features.map((feature) => (
                    <li class="flex items-start gap-3">
                      <Check className="h-4 w-4 text-accent mt-0.5 shrink-0" strokeWidth={3} />
                      <span class="text-sm text-foreground">{feature}</span>
                    </li>
                  ))}
                </ul>

                <div class="mt-10 pt-8 border-t border-border">
                  <p class="text-sm text-muted-foreground leading-relaxed">
                    Good fit for local service businesses, consultants, studios, trades, and small teams that need a trustworthy online presence without unnecessary complexity.
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section id="add-ons" class="py-20 border-t border-border bg-secondary/20 relative overflow-hidden">
        <FloatingShapes fadeTop fadeBottom fadeColor="secondary" />
        <div class="container mx-auto max-w-7xl px-6 relative z-10">
          <div class="max-w-3xl mb-12">
            <p class="text-sm font-medium text-muted-foreground uppercase tracking-widest mb-4">Optional Add-On</p>
            <h2 class="text-4xl sm:text-5xl font-bold text-foreground font-display tracking-tighter mb-4">
              Add editing if you need it.
            </h2>
            <p class="text-muted-foreground leading-relaxed">
              Most sites do not need a CMS. If you want to update pages, services, pricing, testimonials, or publish blog and news posts yourself, this is the main upgrade.
            </p>
          </div>

          <div class="max-w-3xl bg-border">
            {addOns.map((addOn, index) => (
              <div class={`bg-background p-8 hover:bg-secondary/20 transition-colors ${index === 0 ? 'bg-secondary/10' : ''}`}>
                <h3 class="text-xl font-bold text-foreground font-display mb-3">{addOn.title}</h3>
                <div class="flex items-baseline gap-1 mb-4">
                  <span class="text-sm text-muted-foreground uppercase tracking-wide">from +</span>
                  <span class="text-4xl font-bold text-foreground font-display tracking-tighter" data-price-gbp={addOn.priceGbp}>£{addOn.priceGbp}</span>
                </div>
                <p class="text-sm text-muted-foreground leading-relaxed">{addOn.description}</p>
              </div>
            ))}
          </div>

          <p class="text-sm text-muted-foreground mt-8 max-w-2xl">
            Editable-content projects have a higher monthly fee than brochure sites, because there is a real CMS, editor access, and more ongoing support involved. If you need a more tailored enquiry flow, booking setup, or more bespoke functionality, I quote that separately based on scope.
          </p>
        </div>
      </section>

      <section class="py-20 border-t border-border relative overflow-hidden">
        <GeometricArt variant="dots" fadeTop fadeBottom />
        <div class="container mx-auto max-w-7xl px-6 relative z-10">
          <div class="grid md:grid-cols-3 gap-px bg-border">
            {pricingNotes.map((note) => (
              <div class="bg-background p-8 lg:p-10 hover:bg-secondary/20 transition-colors">
                <h3 class="text-xl font-bold text-foreground font-display mb-3">{note.title}</h3>
                <p class="text-sm text-muted-foreground leading-relaxed">{note.description}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section class="py-12 border-t border-border relative overflow-hidden">
        <div class="container mx-auto max-w-7xl px-6 relative z-10">
          <div class="border border-border p-6 flex items-start gap-4 bg-background">
            <div class="w-10 h-10 bg-accent/10 flex items-center justify-center shrink-0">
              <span class="text-accent font-bold text-lg">?</span>
            </div>
            <div>
              <h4 class="font-bold text-foreground mb-1">What is included in the monthly fee?</h4>
              <p class="text-muted-foreground text-sm leading-relaxed">
                Brochure sites are £25/month and editable-content projects start from £50/month. The monthly fee covers hosting, SSL certificate, backups, security monitoring, and routine upkeep. If you need a new domain, you pay the registration cost separately. If you want additional content changes or new features later, I quote those separately.
              </p>
            </div>
          </div>
        </div>
      </section>

      <section class="py-20 border-t border-border relative overflow-hidden">
        <WaveBackground variant="teal" opacity={0.12} fadeTop />
        <div class="container mx-auto max-w-7xl px-6 relative z-10">
          <div class="border border-border bg-background p-10 lg:p-16">
            <div class="flex flex-col lg:flex-row items-center justify-between gap-12">
              <div class="max-w-2xl">
                <p class="text-sm font-medium text-muted-foreground uppercase tracking-widest mb-4">
                  Secondary Service
                </p>
                <h2 class="text-4xl sm:text-5xl font-bold font-display tracking-tighter mb-6 text-foreground">
                  Need more than a
                  <span class="text-accent">standard site?</span>
                </h2>
                <p class="text-lg text-muted-foreground leading-relaxed max-w-xl">
                  If your business needs a portal, dashboard, workflow, or more bespoke web app, I also take on selected custom software projects. Those are scoped and quoted separately.
                </p>
              </div>
              <div class="flex flex-col sm:flex-row gap-4">
                <Button className="rounded-none h-12 px-8 font-semibold">
                  <a href="/custom-software" class="flex items-center gap-2">
                    See Custom Software <ArrowRight className="h-4 w-4" />
                  </a>
                </Button>
                <Button variant="outline" className="rounded-none h-12 px-8">
                  <a href="/contact">Get in Touch</a>
                </Button>
              </div>
            </div>
          </div>
        </div>
      </section>
    </main>
    <Footer />
  </div>
</Layout>

<script>
  function initCurrencyPricing() {
    const timezone = Intl.DateTimeFormat().resolvedOptions().timeZone;

    type Currency = "GBP" | "EUR" | "USD";
    let currency: Currency = "USD";

    const euroTimezones = new Set([
      "Europe/Dublin", "Europe/Lisbon", "Europe/Berlin", "Europe/Paris",
      "Europe/Rome", "Europe/Madrid", "Europe/Amsterdam", "Europe/Brussels",
      "Europe/Vienna", "Europe/Bratislava", "Europe/Budapest", "Europe/Prague",
      "Europe/Warsaw", "Europe/Copenhagen", "Europe/Stockholm", "Europe/Oslo",
      "Europe/Helsinki", "Europe/Tallinn", "Europe/Riga", "Europe/Vilnius",
      "Europe/Ljubljana", "Europe/Zagreb", "Europe/Athens", "Europe/Sofia",
      "Europe/Bucharest", "Europe/Nicosia", "Europe/Malta", "Europe/Luxembourg",
    ]);

    if (timezone === "Europe/London") {
      currency = "GBP";
    } else if (euroTimezones.has(timezone)) {
      currency = "EUR";
    }

    if (currency === "GBP") return;

    const rates: Record<Currency, number> = { GBP: 1, EUR: 1.17, USD: 1.27 };
    const symbols: Record<Currency, string> = { GBP: "£", EUR: "€", USD: "$" };

    const rate = rates[currency];
    const symbol = symbols[currency];

    function convertPrice(gbp: number): number {
      return Math.ceil(gbp * rate);
    }

    document.querySelectorAll("[data-price-gbp]").forEach((el) => {
      const gbp = parseInt(el.getAttribute("data-price-gbp") || "0", 10);
      const converted = convertPrice(gbp);
      el.textContent = `${symbol}${converted}`;
    });

    document.querySelectorAll("[data-hosting-gbp]").forEach((el) => {
      const converted = convertPrice(25);
      const text = el.textContent || "";
      el.textContent = text.replace(/[£€$]\d+/, `${symbol}${converted}`);
    });
  }

  document.addEventListener("DOMContentLoaded", initCurrencyPricing);
</script>
