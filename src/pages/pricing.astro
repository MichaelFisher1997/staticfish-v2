---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import CtaPanel from '../components/CtaPanel.astro';
import Button from '../components/ui/Button.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import Card from '../components/ui/Card.astro';
import { Check, CircleHelp } from 'lucide-react';

const corePackage = {
  title: 'Business Website',
  priceGbp: 599,
  features: [
    'The core pages your business needs to launch',
    'Custom design',
    'Mobile-friendly layout',
    'Contact form',
    'Basic SEO setup',
    'Launch support'
  ]
};

const addOns = [
  {
    title: 'Editable Content Add-On',
    priceGbp: 800,
    description: 'Adds a CMS so you can edit pages, services, pricing, testimonials, and blog or news posts yourself.',
  }
];

const pricingNotes = [
  {
    num: '01', title: 'No surprise billing',
    description: 'You get a clear quote before work starts. Changes outside the agreed scope are quoted separately.',
  },
  {
    num: '02', title: 'Approve first, pay before launch',
    description: 'I will show you the direction first. Once the site is complete and approved, payment is due before it goes live.',
  },
  {
    num: '03', title: 'Domain and DNS are handled clearly',
    description: 'If you already have a domain, I can help connect it. If you need a new one, I can register it for you, but you cover the domain cost.',
  }
];
---

<Layout title="Pricing | Staticfish" description="Simple pricing for business websites, with an editable-content option and a separate route for custom software projects.">
  <div class="min-h-screen flex flex-col">
    <Header />

    <main class="flex-1">
      <PageHero eyebrow="Pricing">
        <span slot="title">Simple website <span class="gradient-text-bright">pricing.</span></span>
        One upfront price for the agreed website scope, plus one monthly fee to keep the site live and looked after.
        <span slot="extra">
          <span class="mt-4 block text-base text-slate-400">
            If you need a CMS for editable content, that is added clearly instead of hidden inside a bigger package you may not need. Anything more tailored is quoted separately.
          </span>
        </span>
      </PageHero>

      <!-- Core package -->
      <section class="mx-auto max-w-6xl px-6 py-16 lg:py-24">
          <div class="overflow-hidden rounded-[2rem] border border-white/10 bg-white/[0.03] backdrop-blur">
            <div class="grid lg:grid-cols-2">
              <div class="p-8 sm:p-10 lg:p-12">
                <span class="inline-flex items-center gap-1.5 rounded-full bg-white px-3.5 py-1.5 text-[11px] font-bold uppercase tracking-widest text-slate-900">
                  Most clients start here
                </span>
                <h2 class="mt-6 font-display text-3xl font-bold tracking-tight text-white sm:text-4xl">{corePackage.title}</h2>
                <p class="mt-3 leading-relaxed text-slate-400">
                  A clear, professional website for businesses that need to explain what they do and make it easy for people to enquire.
                </p>
                <p class="mt-8 flex items-baseline gap-2">
                  <span class="font-display text-6xl font-bold tracking-tight text-white sm:text-7xl" data-price-gbp={corePackage.priceGbp}>£{corePackage.priceGbp}</span>
                  <span class="text-sm font-medium text-slate-400">upfront</span>
                </p>
                <p class="mt-1.5 text-sm text-slate-400" data-hosting-gbp>+ £25/month hosting, backups &amp; upkeep</p>
                <p class="mt-4 text-sm text-slate-400">
                  If you need editable content, those projects start from <strong class="font-semibold text-white" data-currency-gbp="50" data-currency-suffix="/month">£50/month</strong> ongoing.
                </p>
                <Button href="/contact" size="lg" class="mt-8">Ask for a Quote</Button>
              </div>
              <div class="border-t border-white/10 bg-white/[0.02] p-8 sm:p-10 lg:border-l lg:border-t-0 lg:p-12">
                <p class="mb-2 text-[11px] font-bold uppercase tracking-[0.18em] text-slate-400">Included</p>
                <ul class="divide-y divide-white/10">
                  {corePackage.features.map((feature) => (
                    <li class="flex items-center gap-3 py-3.5">
                      <Check className="h-4 w-4 shrink-0 text-emerald-400" strokeWidth={3} />
                      <span class="text-[15px] font-medium text-slate-200">{feature}</span>
                    </li>
                  ))}
                </ul>
                <p class="mt-6 border-t border-white/10 pt-6 text-sm leading-relaxed text-slate-400">
                  Good fit for local service businesses, consultants, studios, trades, and small teams that need a trustworthy online presence without unnecessary complexity.
                </p>
              </div>
            </div>
          </div>
      </section>

      <!-- Add-on -->
      <section class="border-y border-white/[0.07] bg-white/[0.02] py-16 lg:py-24">
        <div class="mx-auto max-w-6xl px-6">
          <SectionHeading eyebrow="Optional add-on">
            <span slot="title">Add editing <span class="serif-accent font-normal">if you need it.</span></span>
            Most sites do not need a CMS. If you want to update pages, services, pricing, testimonials, or publish blog and news posts yourself, this is the main upgrade.
          </SectionHeading>

          <div class="max-w-3xl">
            {addOns.map((addOn) => (
                <Card>
                  <div class="flex flex-wrap items-end justify-between gap-6">
                    <div class="max-w-md">
                      <h3 class="font-display text-2xl font-bold tracking-tight text-white">{addOn.title}</h3>
                      <p class="mt-3 text-sm leading-relaxed text-slate-400">{addOn.description}</p>
                    </div>
                    <p class="text-right">
                      <span class="block text-[11px] font-bold uppercase tracking-widest text-slate-400">from +</span>
                      <span class="font-display text-5xl font-bold tracking-tight text-white" data-price-gbp={addOn.priceGbp}>£{addOn.priceGbp}</span>
                    </p>
                  </div>
                </Card>
            ))}
          </div>

            <p class="mt-8 max-w-2xl text-sm leading-relaxed text-slate-400">
              Editable-content projects have a higher monthly fee than brochure sites, because there is a real CMS, editor access, and more ongoing support involved. If you need a more tailored enquiry flow, booking setup, or more bespoke functionality, I quote that separately based on scope.
            </p>
        </div>
      </section>

      <!-- Notes -->
      <section class="mx-auto max-w-6xl px-6 py-16 lg:py-24">
        <div class="grid gap-10 sm:grid-cols-3 sm:gap-0 sm:divide-x sm:divide-white/10">
          {pricingNotes.map((note) => (
            <div class="sm:px-8 sm:first:pl-0 sm:last:pr-0">
              <p class="font-display text-sm font-bold tracking-widest text-[#ff4d5d]">{note.num}</p>
              <h3 class="mt-5 font-display text-lg font-bold tracking-tight text-white">{note.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-slate-400">{note.description}</p>
            </div>
          ))}
        </div>

          <Card class="mt-14 flex items-start gap-5">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl border border-white/10 bg-white/[0.06] text-white">
              <CircleHelp className="h-[18px] w-[18px]" />
            </span>
            <div>
              <h4 class="font-display font-bold tracking-tight text-white">What is included in the monthly fee?</h4>
              <p class="mt-1.5 text-sm leading-relaxed text-slate-400">
                Brochure sites are <span class="font-semibold text-white" data-hosting-gbp>£25/month</span> and editable-content projects start from <span class="font-semibold text-white" data-currency-gbp="50" data-currency-suffix="/month">£50/month</span>. The monthly fee covers hosting, SSL certificate, backups, security monitoring, and routine upkeep. If you need a new domain, you pay the registration cost separately. If you want additional content changes or new features later, I quote those separately.
              </p>
            </div>
          </Card>
      </section>

      <CtaPanel
        eyebrow="Secondary service"
        title="Need more than a"
        highlight="standard site?"
        description="If your business needs a portal, dashboard, workflow, or more bespoke web app, I also take on selected custom software projects. Those are scoped and quoted separately."
        primary={{ href: "/custom-software", label: "See Custom Software" }}
        secondary={{ href: "/contact", label: "Get in Touch" }}
      />
    </main>
    <Footer />
  </div>
</Layout>
