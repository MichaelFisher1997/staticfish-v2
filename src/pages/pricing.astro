---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { Button } from '../components/ui/button';
import { Check, Mail, ArrowRight } from 'lucide-react';
import { WaveBackground, FlowingLines, CornerWaves } from '../components/WaveArt';
import { GeometricArt, FloatingShapes } from '../components/GeometricArt';

const pricingTiers = [
  {
    title: "Static Site",
    priceGbp: 149,
    description: "A straightforward site for businesses that need an online presence.",
    features: [
      "Up to 5 pages",
      "Custom design",
      "Mobile-responsive",
      "Contact form",
      "Basic SEO setup"
    ]
  },
  {
    title: "CMS Site",
    priceGbp: 249,
    description: "For businesses that want to update their own content.",
    features: [
      "No page limit",
      "Easy content editor",
      "2 Admin users",
      "Blog functionality",
      "Content scheduling"
    ]
  },
  {
    title: "E-Commerce",
    priceGbp: 399,
    description: "For businesses selling products online.",
    features: [
      "Everything in CMS",
      "PayPal & Stripe",
      "Multicurrency support",
      "Unlimited products",
      "Order management"
    ]
  }
];

const maintenancePlans = [
  {
    title: "Basic",
    priceGbp: 50,
    period: "/month",
    description: "Essential security and upkeep.",
    features: ["Monthly Backups", "Security Updates", "Uptime Monitoring", "Email Support"]
  },
  {
    title: "Growth",
    priceGbp: 150,
    period: "/month",
    description: "Regular updates and small changes.",
    features: ["Weekly Backups", "2 hrs dev time/mo", "Content Updates", "Priority Email Support"]
  },
  {
    title: "Full Partner",
    priceGbp: 450,
    period: "/month",
    description: "Complete peace of mind.",
    features: ["Daily Backups", "5 hrs dev time/mo", "Performance Audits", "Phone & Slack Support"]
  }
];
---

<Layout title="Transparent Fixed-Rate Pricing | Staticfish" description="Simple, transparent pricing for web development. Fixed project rates with no hidden fees.">
  <div class="min-h-screen flex flex-col bg-background">
    <Header />
    
    <main class="flex-1">
      
      <!-- Hero -->
      <section class="pt-32 pb-20 lg:pb-32 relative overflow-hidden">
        <FlowingLines count={8} />
        <CornerWaves position="bottom-right" />
        <div class="container mx-auto max-w-7xl px-6 relative z-10">
          <div class="max-w-3xl">
            <p class="text-sm font-medium text-muted-foreground uppercase tracking-widest mb-6">
              Pricing
            </p>
            <h1 class="text-5xl sm:text-6xl lg:text-7xl font-bold text-foreground font-display tracking-tighter mb-8">
              Simple.
              <br/>
              Honest.
              <br/>
              <span class="text-accent">Fixed.</span>
            </h1>
            <p class="text-lg sm:text-xl text-muted-foreground leading-relaxed max-w-2xl mb-4">
              One cost upfront. Set hosting fee. That's it. No hourly billing, no surprise charges, no scope creep.
            </p>
            <p class="text-muted-foreground">
              You get a clear price before we start, and that's what you pay.
            </p>
          </div>
        </div>
      </section>

      <!-- Pricing Grid -->
      <section class="py-20 border-t border-border relative overflow-hidden">
        <GeometricArt variant="circles" />
        <div class="container mx-auto max-w-7xl px-6 relative z-10">
          
          <div class="grid grid-cols-1 lg:grid-cols-3 gap-px bg-border">
            {pricingTiers.map((tier) => (
              <div class="bg-background p-8 lg:p-10 flex flex-col hover:bg-secondary/20 transition-colors">
                
                <div class="mb-6">
                  <h3 class="text-xl font-bold text-foreground font-display mb-2">{tier.title}</h3>
                  <p class="text-sm text-muted-foreground leading-relaxed">
                    {tier.description}
                  </p>
                </div>

                <div class="mb-8">
                  <div class="flex items-baseline gap-1">
                    <span class="text-5xl font-bold text-foreground font-display tracking-tighter" data-price-gbp={tier.priceGbp}>£{tier.priceGbp}</span>
                    <span class="text-sm text-muted-foreground ml-1">upfront</span>
                  </div>
                  <div class="mt-2">
                    <span class="text-sm text-muted-foreground" data-hosting-gbp>+ £50/month hosting</span>
                  </div>
                </div>

                <ul class="space-y-3 flex-1">
                  {tier.features.map((feature) => (
                    <li class="flex items-center gap-3">
                      <Check className="h-4 w-4 text-accent shrink-0" strokeWidth={3} />
                      <span class="text-sm text-foreground font-medium">
                        {feature}
                      </span>
                    </li>
                  ))}
                </ul>
                
                <div class="mt-10 pt-8 border-t border-border">
                  <Button className="w-full rounded-none font-semibold h-11">
                    <a href="/contact">Get Started</a>
                  </Button>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- Hosting Note -->
      <section class="py-12 border-t border-border relative overflow-hidden">
        <FloatingShapes />
        <div class="container mx-auto max-w-7xl px-6 relative z-10">
          <div class="border border-border p-6 flex items-start gap-4">
            <div class="w-10 h-10 bg-accent/10 flex items-center justify-center shrink-0">
              <span class="text-accent font-bold text-lg">?</span>
            </div>
            <div>
              <h4 class="font-bold text-foreground mb-1">What's included in hosting?</h4>
              <p class="text-muted-foreground text-sm leading-relaxed">
                Premium hosting on Cloudflare's global CDN, free SSL certificate, automated backups, 
                and ongoing security monitoring. You can cancel hosting anytime with 30 days notice and keep your website files.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- Custom Projects -->
      <section class="py-20 border-t border-border">
        <div class="container mx-auto max-w-7xl px-6">
          <div class="border border-border p-10 lg:p-16">
            <div class="flex flex-col lg:flex-row items-center justify-between gap-12">
              <div class="max-w-2xl">
                <p class="text-sm font-medium text-muted-foreground uppercase tracking-widest mb-4">
                  Custom Development
                </p>
                <h2 class="text-4xl sm:text-5xl font-bold font-display tracking-tighter mb-6 text-foreground">
                  Need Something
                  <span class="text-accent">Bespoke?</span>
                </h2>
                <p class="text-lg text-muted-foreground leading-relaxed max-w-xl">
                  Browser extensions, automation tools, internal dashboards, or complex web applications. 
                  I'll provide a fixed-price quote after understanding your requirements.
                </p>
              </div>
              <div>
                <Button className="rounded-none h-12 px-10 font-semibold">
                  <a href="/contact">Get a Quote</a>
                </Button>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Maintenance Plans -->
      <section class="py-20 border-t border-border relative overflow-hidden">
        <GeometricArt variant="dots" />
        
        <div class="container mx-auto max-w-7xl px-6 relative z-10">
          <div class="max-w-2xl mb-12">
            <p class="text-sm font-medium text-muted-foreground uppercase tracking-widest mb-4">Ongoing Support</p>
            <h2 class="text-4xl sm:text-5xl font-bold text-foreground font-display tracking-tighter mb-4">
              Care Plans.
            </h2>
            <p class="text-muted-foreground">Keep your website secure and up-to-date. Optional for Static Site owners, included in CMS & E-commerce tiers.</p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-border">
            {maintenancePlans.map(plan => (
              <div class="bg-background p-8 hover:bg-secondary/20 transition-colors">
                <h3 class="text-lg font-bold text-foreground font-display mb-2">{plan.title}</h3>
                <div class="flex items-baseline gap-1 mb-2">
                  <span class="text-4xl font-bold text-foreground font-display tracking-tighter" data-price-gbp={plan.priceGbp}>£{plan.priceGbp}</span>
                  <span class="text-sm text-muted-foreground">{plan.period}</span>
                </div>
                <p class="text-sm text-muted-foreground mb-8">{plan.description}</p>
                
                <ul class="space-y-3 pt-6 border-t border-border">
                  {plan.features.map(feature => (
                    <li class="flex items-center gap-3 text-sm text-foreground">
                      <div class="w-1 h-1 bg-accent"></div>
                      {feature}
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- Final CTA -->
      <section class="py-20 border-t border-border relative overflow-hidden">
        <WaveBackground variant="teal" opacity={0.12} />
        <div class="container mx-auto max-w-7xl px-6 relative z-10">
          <div class="bg-foreground text-background p-12 lg:p-20 text-center corner-bracket">
            <div class="w-14 h-14 bg-background/10 flex items-center justify-center mx-auto mb-8">
              <Mail className="h-6 w-6 text-background" />
            </div>
            <h2 class="text-3xl sm:text-4xl font-bold font-display tracking-tighter mb-4 text-background">
              Questions?
            </h2>
            <p class="text-lg text-background/70 mb-10 max-w-lg mx-auto">
              I'm happy to discuss your project and help you choose the right option. No pressure, just honest advice.
            </p>
            <Button className="rounded-none bg-accent hover:bg-accent/90 text-white h-12 px-8">
              <a href="/contact" class="flex items-center gap-2">
                Get in Touch <ArrowRight className="h-4 w-4" />
              </a>
            </Button>
          </div>
        </div>
      </section>

    </main>
    <Footer />
  </div>
</Layout>

<script>
  function initCurrencyPricing() {
    const timezone = Intl.DateTimeFormat().resolvedOptions().timeZone;
    
    type Currency = "GBP" | "EUR" | "USD";
    let currency: Currency = "USD";
    
    const euroTimezones = new Set([
      "Europe/Dublin", "Europe/Lisbon", "Europe/Berlin", "Europe/Paris",
      "Europe/Rome", "Europe/Madrid", "Europe/Amsterdam", "Europe/Brussels",
      "Europe/Vienna", "Europe/Bratislava", "Europe/Budapest", "Europe/Prague",
      "Europe/Warsaw", "Europe/Copenhagen", "Europe/Stockholm", "Europe/Oslo",
      "Europe/Helsinki", "Europe/Tallinn", "Europe/Riga", "Europe/Vilnius",
      "Europe/Ljubljana", "Europe/Zagreb", "Europe/Athens", "Europe/Sofia",
      "Europe/Bucharest", "Europe/Nicosia", "Europe/Malta", "Europe/Luxembourg",
    ]);
    
    if (timezone === "Europe/London") {
      currency = "GBP";
    } else if (euroTimezones.has(timezone)) {
      currency = "EUR";
    }
    
    if (currency === "GBP") return;
    
    const rates: Record<Currency, number> = { GBP: 1, EUR: 1.17, USD: 1.27 };
    const symbols: Record<Currency, string> = { GBP: "£", EUR: "€", USD: "$" };
    
    const rate = rates[currency];
    const symbol = symbols[currency];
    
    function convertPrice(gbp: number): number {
      return Math.ceil(gbp * rate);
    }
    
    document.querySelectorAll("[data-price-gbp]").forEach((el) => {
      const gbp = parseInt(el.getAttribute("data-price-gbp") || "0", 10);
      const converted = convertPrice(gbp);
      el.textContent = `${symbol}${converted}`;
    });
    
    document.querySelectorAll("[data-hosting-gbp]").forEach((el) => {
      const converted = convertPrice(50);
      const text = el.textContent || "";
      el.textContent = text.replace(/[£€$]\d+/, `${symbol}${converted}`);
    });
  }
  
  document.addEventListener("DOMContentLoaded", initCurrencyPricing);
</script>