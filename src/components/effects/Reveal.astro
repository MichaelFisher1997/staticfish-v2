---
// Scroll-reveal wrapper. The global observer in Layout.astro
// picks up [data-reveal] and adds .is-visible on intersect.
interface Props {
  as?: string;
  delay?: number;
  variant?: "up" | "left" | "right" | "scale";
  className?: string;
}

const { delay = 0, variant = "up", className = "" } = Astro.props;
const revealValue = variant === "up" ? "true" : variant;
---

<div
  data-reveal={revealValue}
  class={className}
  style={delay ? `--reveal-delay: ${delay}ms` : undefined}
>
  <slot />
</div>
