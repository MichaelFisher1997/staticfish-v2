---
// Animated aurora mesh: drifting gradient blobs + grid + fade.
// Keep it lightweight: pure CSS animations, no JS.
interface Props {
  variant?: "light" | "dark";
  density?: "soft" | "rich";
  className?: string;
}

const { variant = "light", density = "rich", className = "" } = Astro.props;
const isDark = variant === "dark";
const showExtra = density === "rich";
---

<div class={`pointer-events-none absolute inset-0 overflow-hidden ${className}`} aria-hidden="true">
  {isDark ? (
    <>
      <div class="aurora-blob animate-blob-drift left-[-10%] top-[-20%] h-[34rem] w-[34rem]" style="background: radial-gradient(circle, rgba(255,77,93,0.42), transparent 65%);" />
      <div class="aurora-blob animate-blob-drift-2 right-[-12%] top-[10%] h-[30rem] w-[30rem]" style="background: radial-gradient(circle, rgba(255,170,90,0.28), transparent 65%); animation-delay: -6s;" />
      {showExtra && (
        <div class="aurora-blob animate-blob-drift bottom-[-25%] left-[30%] h-[28rem] w-[28rem]" style="background: radial-gradient(circle, rgba(255,77,93,0.3), transparent 65%); animation-delay: -11s;" />
      )}
      <div class="dot-pattern-light absolute inset-0 opacity-40" style="mask-image: radial-gradient(ellipse 70% 60% at 50% 40%, black 20%, transparent 75%); -webkit-mask-image: radial-gradient(ellipse 70% 60% at 50% 40%, black 20%, transparent 75%);" />
    </>
  ) : (
    <>
      <div class="absolute inset-0 grid-pattern" />
      <div class="aurora-blob animate-blob-drift left-[-8%] top-[-18%] h-[30rem] w-[30rem]" style="background: radial-gradient(circle, rgba(255,77,93,0.2), transparent 65%);" />
      <div class="aurora-blob animate-blob-drift-2 right-[-10%] top-[5%] h-[26rem] w-[26rem]" style="background: radial-gradient(circle, rgba(255,170,90,0.18), transparent 65%); animation-delay: -6s;" />
      {showExtra && (
        <>
          <div class="aurora-blob animate-blob-drift bottom-[-22%] left-[25%] h-[24rem] w-[24rem]" style="background: radial-gradient(circle, rgba(255,120,80,0.16), transparent 65%); animation-delay: -11s;" />
          <div class="aurora-blob animate-blob-drift-2 right-[20%] bottom-[-10%] h-[18rem] w-[18rem]" style="background: radial-gradient(circle, rgba(255,197,61,0.14), transparent 65%); animation-delay: -3s;" />
        </>
      )}
    </>
  )}
</div>
