---
// Redot-style halftone dot clusters: masked dot fields scattered
// across a dark hero for that cinematic dotted-glow look.
interface Cluster {
  top?: string;
  left?: string;
  right?: string;
  bottom?: string;
  width?: string;
  height?: string;
  color?: string;
  dot?: string;
  gap?: string;
  opacity?: number;
}

interface Props {
  clusters?: Cluster[];
  className?: string;
}

const { clusters, className = "" } = Astro.props;

const defaults: Cluster[] = clusters ?? [
  { top: "-4%", left: "-4%", width: "26rem", height: "22rem", color: "rgba(47, 47, 228,0.12)", opacity: 0.8 },
  { top: "8%", right: "-6%", width: "30rem", height: "24rem", color: "rgba(47, 47, 228,0.1)", opacity: 0.7 },
  { bottom: "-10%", left: "22%", width: "34rem", height: "20rem", color: "rgba(47, 47, 228,0.09)", opacity: 0.65 },
  { top: "30%", left: "55%", width: "16rem", height: "16rem", color: "rgba(47, 47, 228,0.16)", dot: "1.3px", gap: "11px", opacity: 0.6 },
  { bottom: "4%", right: "8%", width: "18rem", height: "14rem", color: "rgba(47, 47, 228,0.1)", dot: "1.3px", gap: "11px", opacity: 0.55 },
];
---

<div class={`pointer-events-none absolute inset-0 overflow-hidden ${className}`} aria-hidden="true">
  {defaults.map((c) => (
    <div
      class="halftone-field absolute"
      style={{
        ...(c.top ? { top: c.top } : {}),
        ...(c.left ? { left: c.left } : {}),
        ...(c.right ? { right: c.right } : {}),
        ...(c.bottom ? { bottom: c.bottom } : {}),
        width: c.width ?? "20rem",
        height: c.height ?? "20rem",
        opacity: c.opacity ?? 0.7,
        "--ht-color": c.color ?? "rgba(47, 47, 228,0.5)",
        ...(c.dot ? { "--ht-dot": c.dot } : {}),
        ...(c.gap ? { "--ht-gap": c.gap } : {}),
      }}
    />
  ))}
</div>
