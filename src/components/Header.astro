---
import { Button } from "./ui/button";
import MobileMenu from "./MobileMenu";

const navigation = [
  { name: "Work", href: "/portfolio" },
  { name: "Services", href: "/services" },
  { name: "About", href: "/about" },
  { name: "Pricing", href: "/pricing" },
];

const currentPath = Astro.url.pathname;
---

<header class="fixed top-0 left-0 right-0 z-50 w-full border-b border-border bg-background/95 backdrop-blur-sm">
  <div class="mx-auto max-w-7xl px-6 py-4">
    <nav class="flex justify-between items-center">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-3 group">
        <span class="text-xl font-bold tracking-tight text-foreground font-display">
          staticfish
        </span>
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden md:flex items-center gap-8">
        {navigation.map((item) => (
          <a
            href={item.href}
            class={`text-sm font-medium transition-colors duration-200 ${
              currentPath === item.href
                ? "text-foreground"
                : "text-muted-foreground hover:text-foreground"
            }`}
          >
            {item.name}
          </a>
        ))}
      </div>

      <!-- CTA & Mobile -->
      <div class="flex items-center gap-4">
        <a href="/contact" class="hidden md:inline-flex">
          <Button className="rounded-none px-6 h-10 font-semibold bg-foreground text-background hover:bg-foreground/90">
            Contact
          </Button>
        </a>
        <div class="md:hidden">
          <MobileMenu navigation={navigation} currentPath={currentPath} client:load />
        </div>
      </div>
    </nav>
  </div>
</header>
