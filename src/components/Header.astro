---
import { BrandLockup } from "./BrandMark";
import MobileMenu from "./MobileMenu";
import Magnetic from "./effects/Magnetic";

const navigation = [
  { name: "Websites", href: "/services" },
  { name: "Pricing", href: "/pricing" },
  { name: "Work", href: "/portfolio" },
  { name: "About", href: "/about" },
];

const currentPath = Astro.url.pathname;
---

<header id="site-nav" class="fixed top-0 left-0 right-0 z-50 w-full">
  <div class="nav-shell">
    <nav class="mx-auto flex h-[76px] max-w-7xl items-center justify-between px-6">
      <a href="/" class="group flex shrink-0 items-center" aria-label="Staticfish home">
        <BrandLockup markClassName="transition-transform duration-300 group-hover:scale-105 group-hover:rotate-3" />
      </a>

      <div class="hidden items-center gap-1 md:flex">
        {navigation.map((item) => (
          <a
            href={item.href}
            class={`nav-link rounded-lg px-4 py-2 text-[15px] font-semibold transition-all duration-300 ${
              currentPath === item.href ? "active-link text-white" : ""
            }`}
          >
            {item.name}
          </a>
        ))}
      </div>

      <div class="flex items-center gap-3">
        <div class="hidden md:block">
          <Magnetic client:load strength={0.35}>
            <a
              href="/contact"
              class="btn-primary-glow inline-flex items-center gap-2 rounded-full px-6 py-2.5 text-sm font-bold text-white"
            >
              Get a Quote
              <span class="relative z-[2]">→</span>
            </a>
          </Magnetic>
        </div>
        <div class="md:hidden">
          <MobileMenu navigation={navigation} currentPath={currentPath} client:load />
        </div>
      </div>
    </nav>
  </div>
</header>
