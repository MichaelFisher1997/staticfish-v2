---
import { Button } from "./ui/button";
import MobileMenu from "./MobileMenu";
import { BrandLockup } from "./BrandMark";

const navigation = [
  { name: "Websites", href: "/services" },
  { name: "Pricing", href: "/pricing" },
  { name: "Work", href: "/portfolio" },
  { name: "About", href: "/about" },
];

const currentPath = Astro.url.pathname;
---

<header class="fixed top-0 left-0 right-0 z-50 w-full border-b border-border bg-background/95 backdrop-blur-sm">
  <div class="mx-auto max-w-7xl px-6 py-4">
    <nav class="flex justify-between items-center">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-3 group" aria-label="Staticfish home">
        <BrandLockup markClassName="transition-transform duration-200 group-hover:-translate-y-0.5" />
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden md:flex items-center gap-8">
        {navigation.map((item) => (
          <a
            href={item.href}
            class={`relative text-sm font-medium transition-colors duration-200 after:absolute after:-bottom-2 after:left-0 after:h-px after:bg-accent after:transition-all after:duration-200 ${
              currentPath === item.href
                ? "text-foreground after:w-full"
                : "text-muted-foreground hover:text-foreground after:w-0 hover:after:w-full"
            }`}
          >
            {item.name}
          </a>
        ))}
      </div>

      <!-- CTA & Mobile -->
      <div class="flex items-center gap-4">
        <a href="/contact" class="hidden md:inline-flex">
          <Button className="rounded-none px-6 h-10 font-semibold bg-foreground text-background hover:bg-foreground/90">
            Contact
          </Button>
        </a>
        <div class="md:hidden">
          <MobileMenu navigation={navigation} currentPath={currentPath} client:load />
        </div>
      </div>
    </nav>
  </div>
</header>
