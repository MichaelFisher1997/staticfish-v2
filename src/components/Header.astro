---
import { BrandLockup } from "./BrandMark";
import MobileMenu from "./MobileMenu";

const navigation = [
  { name: "Websites", href: "/services" },
  { name: "Pricing", href: "/pricing" },
  { name: "Work", href: "/portfolio" },
  { name: "About", href: "/about" },
];

const currentPath = Astro.url.pathname;
---

<header id="site-nav" class="fixed top-0 left-0 right-0 z-50 w-full px-4 pt-4 sm:px-6">
  <div class="nav-shell mx-auto max-w-6xl rounded-2xl px-4 py-3 sm:px-5">
    <nav class="flex items-center justify-between">
      <a href="/" class="group flex items-center gap-3" aria-label="Staticfish home">
        <BrandLockup markClassName="transition-transform duration-300 group-hover:scale-105 group-hover:rotate-3" />
      </a>

      <div class="hidden items-center gap-1 rounded-full border border-indigo-100/80 bg-white/60 p-1.5 backdrop-blur-xl md:flex">
        {navigation.map((item) => (
          <a
            href={item.href}
            class={`rounded-full px-4 py-2 text-sm font-semibold transition-all duration-300 ${
              currentPath === item.href
                ? "bg-gradient-to-r from-indigo-600 to-violet-600 text-white shadow-lg shadow-indigo-500/30"
                : "text-slate-600 hover:bg-indigo-50 hover:text-indigo-700"
            }`}
          >
            {item.name}
          </a>
        ))}
      </div>

      <div class="flex items-center gap-3">
        <a
          href="/contact"
          class="btn-primary-glow hidden items-center gap-2 rounded-full px-6 py-2.5 text-sm font-bold text-white md:inline-flex"
        >
          Get a Quote
          <span class="relative z-[2]">→</span>
        </a>
        <div class="md:hidden">
          <MobileMenu navigation={navigation} currentPath={currentPath} client:load />
        </div>
      </div>
    </nav>
  </div>
</header>
