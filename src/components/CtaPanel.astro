---
import Button from './ui/Button.astro';
import { ArrowUpRight } from 'lucide-react';

interface CtaLink {
  href: string;
  label: string;
}

interface Props {
  eyebrow?: string;
  title: string;
  highlight?: string;
  description?: string;
  primary: CtaLink;
  secondary?: CtaLink;
  note?: string;
}

const {
  eyebrow = "Next step",
  title,
  highlight = "",
  description = "",
  primary,
  secondary,
  note = "Typical response within 24 hours",
} = Astro.props;
---

<section class="relative border-t border-bone/[0.08]">
  <div class="mx-auto max-w-7xl px-6 py-20 lg:py-28">
    <div data-reveal class="grid gap-12 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <p class="mono-label">{eyebrow}</p>
        <h2 class="mt-7 font-display text-5xl leading-[1.02] tracking-tight text-bone sm:text-6xl">
          {title}
          {highlight && <span class="text-ember"> {highlight}</span>}
        </h2>
      </div>
      <div class="lg:col-span-5 lg:pb-2">
        {description && (
          <p class="max-w-md leading-relaxed text-ash">{description}</p>
        )}
        <div class="mt-8 flex flex-wrap gap-3">
          <Button href={primary.href} size="lg">{primary.label}</Button>
          {secondary && (
            <Button href={secondary.href} variant="secondary" size="lg" arrow={false}>{secondary.label}</Button>
          )}
        </div>
      </div>
    </div>

    <div data-reveal class="mt-14 flex flex-wrap items-center justify-between gap-4 border-t border-bone/[0.12] pt-7">
      <a
        href="mailto:contact@staticfish.co.uk"
        class="group inline-flex items-center gap-3 font-display text-xl tracking-tight text-bone transition-colors duration-300 hover:text-ember sm:text-2xl"
      >
        contact@staticfish.co.uk
        <ArrowUpRight className="h-5 w-5 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
      </a>
      {note && <p class="mono-label">{note}</p>}
    </div>
  </div>
</section>
