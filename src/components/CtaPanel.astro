---
import Halftone from './effects/Halftone.astro';
import Button from './ui/Button.astro';
import Eyebrow from './ui/Eyebrow.astro';

interface CtaLink {
  href: string;
  label: string;
}

interface Props {
  eyebrow?: string;
  title: string;
  highlight?: string;
  description?: string;
  primary: CtaLink;
  secondary?: CtaLink;
  note?: string;
}

const {
  eyebrow = "Next step",
  title,
  highlight = "",
  description = "",
  primary,
  secondary,
  note = "",
} = Astro.props;
---

<section class="mx-auto max-w-7xl px-6 pb-24 lg:pb-32">
  <div class="dark-panel relative overflow-hidden rounded-[2rem] px-8 py-16 text-center sm:px-14 lg:py-20">
    <Halftone
      clusters={[
        { top: "-15%", left: "-8%", width: "22rem", height: "18rem", color: "rgba(255,77,109,0.5)", opacity: 0.7 },
        { bottom: "-20%", right: "-5%", width: "24rem", height: "18rem", color: "rgba(255,200,140,0.4)", opacity: 0.6 },
      ]}
    />
    <div class="relative">
      <Eyebrow class="mx-auto w-fit">{eyebrow}</Eyebrow>
      <h2 class="text-balance mx-auto mt-7 max-w-3xl font-display text-4xl font-bold tracking-tight text-white sm:text-5xl">
        {title}
        {highlight && (
          <span class="serif-accent font-normal text-transparent" style="background: linear-gradient(92deg, #ff8a5c, #ffc53d); -webkit-background-clip: text; background-clip: text;"> {highlight}</span>
        )}
      </h2>
      {description && (
        <p class="mx-auto mt-5 max-w-xl text-lg leading-relaxed text-slate-300">{description}</p>
      )}
      <div class="mt-9 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <Button href={primary.href} size="lg">{primary.label}</Button>
        {secondary && (
          <Button href={secondary.href} variant="secondary" size="lg" arrow={false}>{secondary.label}</Button>
        )}
      </div>
      {note && <p class="mt-7 text-sm text-slate-400">{note}</p>}
    </div>
  </div>
</section>
