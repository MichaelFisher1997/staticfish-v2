---
import Eyebrow from "./Eyebrow.astro";

interface Props {
  eyebrow: string;
  align?: "left" | "center";
  class?: string;
}

const { eyebrow, align = "left", class: className = "" } = Astro.props;
---

<div class={`${align === "center" ? "mx-auto text-center" : ""} mb-12 max-w-3xl ${className}`}>
  <Eyebrow>{eyebrow}</Eyebrow>
  <h2 class="mt-5 font-display text-3xl font-bold tracking-tight text-bone sm:text-4xl">
    <slot name="title" />
  </h2>
  <div class="mt-4 leading-relaxed text-slate-400">
    <slot />
  </div>
</div>
