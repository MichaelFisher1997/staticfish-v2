---
import { ArrowRight } from "lucide-react";

interface Props {
  href: string;
  variant?: "primary" | "secondary";
  size?: "sm" | "md" | "lg";
  arrow?: boolean;
  class?: string;
  external?: boolean;
}

const { href, variant = "primary", size = "md", arrow, class: className = "", external = false } = Astro.props;

const showArrow = arrow ?? variant === "primary";

const sizes = {
  sm: "px-5 py-2.5 text-[13px]",
  md: "px-6 py-3.5 text-sm",
  lg: "px-8 py-4 text-sm",
};

const variants = {
  primary: "bg-ember-deep text-white shadow-[0_12px_32px_-12px_rgba(225,29,72,0.7),inset_0_1px_0_rgba(255,255,255,0.22)] hover:bg-[#f43f52] active:scale-[0.98]",
  secondary: "border border-white/20 bg-white/5 text-slate-100 hover:border-ember/60 hover:bg-white/10 active:scale-[0.98]",
};
---

<a
  href={href}
  target={external ? "_blank" : undefined}
  rel={external ? "noopener noreferrer" : undefined}
  class={`group inline-flex items-center gap-2.5 rounded-2xl font-bold transition-colors duration-200 ${sizes[size]} ${variants[variant]} ${className}`}
>
  <slot />
  {showArrow && (
    <span class={`grid h-6 w-6 place-items-center rounded-full transition-transform duration-300 group-hover:translate-x-0.5 ${variant === "primary" ? "bg-white/20" : "bg-white/10"}`}>
      <ArrowRight className="h-3.5 w-3.5" />
    </span>
  )}
</a>
