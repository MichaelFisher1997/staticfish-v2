---
import { ArrowRight } from "lucide-react";

interface Props {
  href: string;
  variant?: "primary" | "secondary";
  size?: "sm" | "md" | "lg";
  arrow?: boolean;
  class?: string;
  external?: boolean;
}

const { href, variant = "primary", size = "md", arrow, class: className = "", external = false } = Astro.props;

const showArrow = arrow ?? variant === "primary";

const sizes = {
  sm: "px-5 py-2.5 text-[13px]",
  md: "px-6 py-3.5 text-sm",
  lg: "px-8 py-4 text-sm",
};

const variants = {
  primary: "bg-accent text-[#e8e9fd] hover:bg-[#4a4aea] active:scale-[0.99]",
  secondary: "border border-bone/[0.14] bg-transparent text-bone hover:border-bone/30 hover:bg-bone/[0.03] active:scale-[0.99]",
};
---

<a
  href={href}
  target={external ? "_blank" : undefined}
  rel={external ? "noopener noreferrer" : undefined}
  class={`group inline-flex items-center gap-2.5 rounded-full font-semibold transition-colors duration-200 ${sizes[size]} ${variants[variant]} ${className}`}
>
  <slot />
  {showArrow && (
    <span class={`grid h-6 w-6 place-items-center rounded-full transition-transform duration-300 group-hover:translate-x-0.5 ${variant === "primary" ? "bg-abyss/10" : "bg-bone/[0.08]"}`}>
      <ArrowRight className="h-3.5 w-3.5" />
    </span>
  )}
</a>
