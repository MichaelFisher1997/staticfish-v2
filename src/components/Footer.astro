---
const navigation = [
  { name: "Work", href: "/portfolio" },
  { name: "Services", href: "/services" },
  { name: "About", href: "/about" },
  { name: "Pricing", href: "/pricing" },
  { name: "Contact", href: "/contact" },
];

const legalLinks = [
  { name: "Privacy", href: "/privacy" },
  { name: "Terms", href: "/terms" },
];
---

<footer class="border-t border-border bg-secondary/20">
  <div class="container mx-auto max-w-7xl px-6 py-16">
    
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12">
      
      <div class="md:col-span-4">
        <span class="text-xl font-bold font-display mb-4 block">staticfish</span>
        <p class="text-sm text-muted-foreground leading-relaxed max-w-xs">
          Professional websites for small businesses. Fixed pricing, fast delivery, no hidden costs.
        </p>
      </div>

      <div class="md:col-span-4">
        <span class="text-xs font-semibold uppercase tracking-widest text-muted-foreground mb-4 block">Navigation</span>
        <nav class="flex flex-col gap-3">
          {navigation.map((item) => (
            <a
              href={item.href}
              class="text-sm text-muted-foreground hover:text-foreground transition-colors"
            >
              {item.name}
            </a>
          ))}
        </nav>
      </div>
      
      <div class="md:col-span-4">
        <span class="text-xs font-semibold uppercase tracking-widest text-muted-foreground mb-4 block">Legal</span>
        <nav class="flex flex-col gap-3">
          {legalLinks.map((item) => (
            <a
              href={item.href}
              class="text-sm text-muted-foreground hover:text-foreground transition-colors"
            >
              {item.name}
            </a>
          ))}
        </nav>
      </div>
    </div>
    
    <div class="mt-16 pt-8 border-t border-border flex flex-col sm:flex-row justify-between items-center gap-4">
      <p class="text-xs text-muted-foreground">
        © {new Date().getFullYear()} Staticfish. All rights reserved.
      </p>
      <p class="text-xs text-muted-foreground">
        contact@staticfish.co.uk
      </p>
    </div>
  </div>
</footer>
