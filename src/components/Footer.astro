---
import { BrandLockup } from "./BrandMark";
import { ArrowUpRight, Mail, MapPin, Sparkles } from "lucide-react";

const navigation = [
  { name: "Websites", href: "/services" },
  { name: "Pricing", href: "/pricing" },
  { name: "Work", href: "/portfolio" },
  { name: "About", href: "/about" },
  { name: "Contact", href: "/contact" },
];

const secondaryLinks = [
  { name: "Custom Software", href: "/custom-software" },
  { name: "Blog", href: "/blog" },
];

const legalLinks = [
  { name: "Privacy", href: "/privacy" },
  { name: "Terms", href: "/terms" },
];
---

<footer class="relative overflow-hidden">
  <div class="dark-panel noise-overlay relative">
    <div class="aurora-blob animate-blob-drift left-[10%] top-[-30%] h-[24rem] w-[24rem]" style="background: radial-gradient(circle, rgba(99,102,241,0.4), transparent 65%);" aria-hidden="true" />
    <div class="aurora-blob animate-blob-drift-2 right-[5%] bottom-[-40%] h-[22rem] w-[22rem]" style="background: radial-gradient(circle, rgba(6,182,212,0.3), transparent 65%); animation-delay: -8s;" aria-hidden="true" />

    <div class="relative mx-auto max-w-7xl px-6 pb-10 pt-20">
      <div class="mb-16 grid gap-12 lg:grid-cols-[1.3fr_1fr_1fr_1fr]">
        <div>
          <a href="/" aria-label="Staticfish home" class="mb-5 inline-flex rounded-2xl bg-white/5 p-2 pr-4 backdrop-blur">
            <BrandLockup textClassName="!text-white" />
          </a>
          <p class="max-w-xs text-sm leading-relaxed text-slate-400">
            Clear business websites for small businesses, with optional editing and selected custom software when needed.
          </p>
          <div class="mt-6 flex flex-wrap items-center gap-2">
            <span class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-4 py-2 text-[11px] font-bold uppercase tracking-[0.16em] text-indigo-200">
              <span class="live-badge inline-block h-2 w-2 rounded-full bg-emerald-400"></span>
              Available for projects
            </span>
          </div>
          <a href="mailto:contact@staticfish.co.uk" class="group mt-6 inline-flex items-center gap-2 text-sm font-semibold text-white">
            <span class="flex h-9 w-9 items-center justify-center rounded-full bg-gradient-to-br from-indigo-500 to-cyan-500 shadow-lg shadow-indigo-500/40 transition-transform duration-300 group-hover:scale-110">
              <Mail className="h-4 w-4" />
            </span>
            <span class="link-underline">contact@staticfish.co.uk</span>
          </a>
        </div>

        <div>
          <span class="mb-5 block text-[11px] font-bold uppercase tracking-[0.2em] text-slate-500">Navigate</span>
          <nav class="flex flex-col gap-3">
            {navigation.map((item) => (
              <a href={item.href} class="group inline-flex w-fit items-center gap-1.5 text-sm text-slate-300 transition-colors hover:text-white">
                <span class="h-px w-0 bg-gradient-to-r from-indigo-400 to-cyan-400 transition-all duration-300 group-hover:w-4"></span>
                {item.name}
              </a>
            ))}
          </nav>
        </div>

        <div>
          <span class="mb-5 block text-[11px] font-bold uppercase tracking-[0.2em] text-slate-500">More</span>
          <nav class="flex flex-col gap-3">
            {secondaryLinks.map((item) => (
              <a href={item.href} class="group inline-flex w-fit items-center gap-1.5 text-sm text-slate-300 transition-colors hover:text-white">
                <span class="h-px w-0 bg-gradient-to-r from-indigo-400 to-cyan-400 transition-all duration-300 group-hover:w-4"></span>
                {item.name}
              </a>
            ))}
          </nav>
          <span class="mb-5 mt-8 block text-[11px] font-bold uppercase tracking-[0.2em] text-slate-500">Legal</span>
          <nav class="flex flex-col gap-3">
            {legalLinks.map((item) => (
              <a href={item.href} class="text-sm text-slate-400 transition-colors hover:text-white">
                {item.name}
              </a>
            ))}
          </nav>
        </div>

        <div>
          <span class="mb-5 block text-[11px] font-bold uppercase tracking-[0.2em] text-slate-500">Start a project</span>
          <div class="rounded-2xl border border-white/10 bg-white/5 p-6 backdrop-blur">
            <span class="mb-3 inline-flex items-center gap-1.5 rounded-full bg-indigo-500/20 px-3 py-1 text-[11px] font-bold uppercase tracking-widest text-indigo-200">
              <Sparkles className="h-3 w-3" /> 1–3 weeks
            </span>
            <p class="mb-5 text-sm leading-relaxed text-slate-300">
              Fixed price, clear scope, launch support included.
            </p>
            <a href="/contact" class="btn-primary-glow inline-flex w-full items-center justify-center gap-2 rounded-xl px-5 py-3 text-sm font-bold text-white">
              Get a Quote <ArrowUpRight className="relative z-[2] h-4 w-4" />
            </a>
            <p class="mt-4 flex items-center gap-1.5 text-xs text-slate-500">
              <MapPin className="h-3.5 w-3.5" /> UK based · working worldwide
            </p>
          </div>
        </div>
      </div>

      <div class="flex flex-col items-center justify-between gap-4 border-t border-white/10 pt-8 sm:flex-row">
        <p class="text-xs text-slate-500">
          © {new Date().getFullYear()} Staticfish. All rights reserved.
        </p>
        <p class="font-display text-2xl font-bold tracking-tight text-white/10 sm:text-3xl">
          static<span class="text-white/20">fish</span>
        </p>
      </div>
    </div>
  </div>
</footer>
