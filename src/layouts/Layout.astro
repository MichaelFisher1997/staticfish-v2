---
import '../styles/global.css';
import SmoothScroll from '../components/effects/SmoothScroll';

export interface Props {
  title: string;
  description?: string;
}

const { title, description = "Professional web development for small businesses. Fixed pricing, fast delivery, no hidden costs." } = Astro.props;

const chattyboxKey = import.meta.env.PUBLIC_CHATTYBOX_KEY;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="index, follow" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:site_name" content="Staticfish" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="theme-color" content="#0a0a18" />
    <link rel="canonical" href={Astro.url} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <script
      src="https://chattybox.ai/widget.js"
      data-api-key={chattyboxKey}
      data-api-url="https://adorable-woodpecker-629.convex.site/chat"
      async
    ></script>
  </head>
  <body id="top">
    <slot />
    <SmoothScroll client:load />
    <script>
      import { initSeedBurst } from '../lib/seed-burst';
      function initReveal() {
        const els = document.querySelectorAll("[data-reveal]:not(.is-visible)");
        if (!("IntersectionObserver" in window)) {
          els.forEach((el) => el.classList.add("is-visible"));
          return;
        }
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: "0px 0px -8% 0px" }
        );
        els.forEach((el) => observer.observe(el));
      }

      function initNavbar() {
        const bar = document.getElementById("site-nav");
        if (!bar) return;
        const onScroll = () => {
          bar.classList.toggle("is-scrolled", window.scrollY > 24);
        };
        onScroll();
        window.addEventListener("scroll", onScroll, { passive: true });
      }

      function initCurrencyPricing() {
        const timezone = Intl.DateTimeFormat().resolvedOptions().timeZone;

        type Currency = "GBP" | "EUR" | "USD";
        let currency: Currency = "USD";

        const euroTimezones = new Set([
          "Europe/Dublin", "Europe/Lisbon", "Europe/Berlin", "Europe/Paris",
          "Europe/Rome", "Europe/Madrid", "Europe/Amsterdam", "Europe/Brussels",
          "Europe/Vienna", "Europe/Bratislava", "Europe/Budapest", "Europe/Prague",
          "Europe/Warsaw", "Europe/Copenhagen", "Europe/Stockholm", "Europe/Oslo",
          "Europe/Helsinki", "Europe/Tallinn", "Europe/Riga", "Europe/Vilnius",
          "Europe/Ljubljana", "Europe/Zagreb", "Europe/Athens", "Europe/Sofia",
          "Europe/Bucharest", "Europe/Nicosia", "Europe/Malta", "Europe/Luxembourg",
        ]);

        if (timezone === "Europe/London") {
          currency = "GBP";
        } else if (euroTimezones.has(timezone)) {
          currency = "EUR";
        }

        if (currency === "GBP") return;

        const rates: Record<Currency, number> = { GBP: 1, EUR: 1.17, USD: 1.27 };
        const symbols: Record<Currency, string> = { GBP: "£", EUR: "€", USD: "$" };
        const rate = rates[currency];
        const symbol = symbols[currency];

        function convertPrice(gbp: number): number {
          return Math.ceil(gbp * rate);
        }

        document.querySelectorAll("[data-price-gbp]").forEach((el) => {
          const gbp = parseInt(el.getAttribute("data-price-gbp") || "0", 10);
          el.textContent = `${symbol}${convertPrice(gbp)}`;
        });

        document.querySelectorAll("[data-hosting-gbp]").forEach((el) => {
          const text = el.textContent || "";
          el.textContent = text.replace(/[£€$]\d+/, `${symbol}${convertPrice(25)}`);
        });

        document.querySelectorAll("[data-currency-gbp]").forEach((el) => {
          const gbp = parseInt(el.getAttribute("data-currency-gbp") || "0", 10);
          const prefix = el.getAttribute("data-currency-prefix") || "";
          const suffix = el.getAttribute("data-currency-suffix") || "";
          el.textContent = `${prefix}${symbol}${convertPrice(gbp)}${suffix}`;
        });
      }

      document.addEventListener("DOMContentLoaded", () => {
        initReveal();
        initNavbar();
        initSeedBurst();
        initCurrencyPricing();
      });
      document.addEventListener("astro:after-swap", () => {
        initReveal();
        initNavbar();
      });
    </script>
    <style>
      /* Integrated nav bar: transparent over heroes, glass on scroll */
      #site-nav {
        transition: all 0.4s cubic-bezier(0.22, 1, 0.36, 1);
      }
      #site-nav .nav-shell {
        transition: all 0.4s cubic-bezier(0.22, 1, 0.36, 1);
        background: linear-gradient(to bottom, rgba(4, 4, 14, 0.55), transparent);
        border-bottom: 1px solid transparent;
      }
      #site-nav.is-scrolled .nav-shell {
        background: rgba(6, 6, 18, 0.82);
        backdrop-filter: blur(20px) saturate(1.4);
        -webkit-backdrop-filter: blur(20px) saturate(1.4);
        border-bottom-color: rgba(255, 255, 255, 0.08);
        box-shadow: 0 12px 40px -12px rgba(0, 0, 0, 0.7);
      }
      #site-nav .nav-link {
        position: relative;
        color: #94a3b8;
      }
      #site-nav .nav-link:hover {
        background: rgba(255, 255, 255, 0.06);
        color: #ffffff;
        text-shadow: 0 0 18px rgba(255, 255, 255, 0.4);
      }
      #site-nav .nav-link.active-link {
        color: #ffffff;
      }
      #site-nav .nav-link.active-link::after {
        content: "";
        position: absolute;
        left: 50%;
        bottom: 2px;
        width: 5px;
        height: 5px;
        border-radius: 999px;
        transform: translateX(-50%);
        background: linear-gradient(135deg, #ff4d6d, #ff8a3d);
        box-shadow: 0 0 10px rgba(255, 77, 109, 0.9);
      }
      #site-nav .brand-word {
        color: #ffffff;
      }
    </style>
  </body>
</html>
